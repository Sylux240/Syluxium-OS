#!/system/bin/sh
# Syluxium: iptables for Android's netd (the container shares the host's network).
# Bound over /system/bin/{ip,ip6}tables{,-restore} in the Android container
# (syluxium-android-container). netd keeps iptables-restore running and
# writes rule batches to it, each followed by a "#PING" line it waits to see
# echoed back; here every batch "succeeds" without filtering anything (the
# container shares the host's network, which the host's own settings govern).
case "${0##*/}" in
*-restore)
    while IFS= read -r line; do
        case "$line" in
        "#PING"*) echo "#PING" ;;
        esac
    done ;;
esac
exit 0
