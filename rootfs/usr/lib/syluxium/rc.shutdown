#!/bin/sh
# Syluxium shutdown on the Linux kernel (init runs it before power off or
# restart): programs asked to quit, the kernel log onto the stick, disks synced
# and unmounted. The shutdown screen stays on (its process is spared).
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
say() { /usr/lib/syluxium/shutdown-screen say "$*"; }
# (started from a text console: the shutdown screen now)
plymouth --ping 2>/dev/null || /usr/lib/syluxium/shutdown-screen start poweroff
spare=$(/usr/lib/syluxium/shutdown-screen pid)
omit=${spare:+-o $spare}
say "Closing programs"
killall5 -15 $omit 2>/dev/null
sleep 1
killall5 -9 $omit 2>/dev/null
say "Saving the logs"
if [ -d /boot/logs/ ]; then
    dmesg > /boot/logs/syluxium-log.txt 2>/dev/null
fi
sync
say "Finishing"
umount -a -r -t vfat,ext4,ext3,ext2,exfat,ntfs3 2>/dev/null
mount -o remount,ro / 2>/dev/null
sync
