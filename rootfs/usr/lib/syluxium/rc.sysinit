#!/bin/sh
# Syluxium start-up on the Linux kernel (run once by init, before the
# console shell): what Syluxium's own kernel did itself.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Each step's start goes into the kernel log (timestamps show slow steps)
# and, with the loading screen on, under its progress bar.
step() {
    echo "syluxium-init: $*" > /dev/kmsg 2>/dev/null
    [ -n "$2" ] && plymouth --ping 2>/dev/null && plymouth display-message --text="$2" 2>/dev/null
}

# ---- file systems ----
grep -qs " /proc " /proc/mounts || mount -t proc proc /proc
grep -qs " /sys " /proc/mounts || mount -t sysfs sys /sys
grep -qs " /dev " /proc/mounts || mount -t devtmpfs dev /dev
mkdir -p /dev/pts /dev/shm
# (devtmpfs leaves these to userspace: bash's <(...), /dev/stdin users)
ln -sfn /proc/self/fd /dev/fd
ln -sf /proc/self/fd/0 /dev/stdin
ln -sf /proc/self/fd/1 /dev/stdout
ln -sf /proc/self/fd/2 /dev/stderr
ln -sf /proc/kcore /dev/core 2>/dev/null
mount -t devpts -o gid=5,mode=620,ptmxmode=666 devpts /dev/pts
mount -t tmpfs -o mode=1777,nosuid,nodev shm /dev/shm
# (/run may already be there: the initrd's loading screen brought it along)
grep -qs " /run " /proc/mounts || mount -t tmpfs -o mode=755,nosuid,nodev run /run
mkdir -p /run/lock /run/user /run/syluxium
mount -t tmpfs -o mode=1777,nosuid,nodev tmp /tmp
mount -t cgroup2 cgroup2 /sys/fs/cgroup 2>/dev/null # containers (Android)
mount -t securityfs securityfs /sys/kernel/security 2>/dev/null
mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null
mount -o remount,rw / 2>/dev/null
[ -e /etc/mtab ] || ln -s /proc/mounts /etc/mtab
mkdir -p /mnt /media /boot

hostname -F /etc/hostname 2>/dev/null || hostname syluxium
ip link set lo up 2>/dev/null

# ---- static device nodes: opening one loads its module (loop, fuse, uinput,
# ...), as systemd-tmpfiles arranges on other distributions ----
kmod static-nodes --format=tmpfiles 2>/dev/null | while read -r type path mode _ _ _ dev; do
    case "$type" in c*|b*) ;; *) continue ;; esac
    [ -e "$path" ] && continue
    mkdir -p "$(dirname "$path")"
    mknod -m "$mode" "$path" "${type%%!*}" "${dev%%:*}" "${dev##*:}" 2>/dev/null
done

step "starting udev" "Finding your hardware"
# ---- hardware: udev loads the drivers for what's there ----
udevd=/usr/lib/systemd/systemd-udevd
[ -x "$udevd" ] || udevd=/lib/systemd/systemd-udevd
if [ -x "$udevd" ]; then
    "$udevd" --daemon
    udevadm trigger --action=add --type=subsystems
    udevadm trigger --action=add --type=devices
    # The loading screen: Plymouth shows it as soon as the GPU driver udev is
    # loading brings up a display (a second or two on most machines).
    if grep -qw splash /proc/cmdline && [ -x /usr/sbin/plymouthd ] && ! plymouth --ping 2>/dev/null; then
        mkdir -p /run/plymouth
        plymouthd --mode=boot --attach-to-session --pid-file=/run/plymouth/pid && plymouth show-splash
        echo "syluxium-init: loading screen: plymouthd $(cat /run/plymouth/pid 2>/dev/null), ping $(plymouth --ping 2>/dev/null && echo ok)" > /dev/kmsg
    else
        echo "syluxium-init: loading screen not started ($(grep -ow splash /proc/cmdline), $(ls /usr/sbin/plymouthd 2>&1), $(plymouth --ping 2>/dev/null && echo running))" > /dev/kmsg
    fi
    udevadm settle --timeout=30
fi
step "udev settled; loading /etc/modules" "Loading drivers"
# Modules no hardware asks for (Debian's /etc/modules): Android's loop images
# and binder devices, and more listed there.
grep -v '^\s*#' /etc/modules 2>/dev/null | while read -r m args; do
    [ -n "$m" ] && modprobe "$m" $args 2>/dev/null
done

# ---- the stick: this boot's log folder (as Syluxium's own kernel kept it) ----
# SYLUXLOGS gets a folder per boot, "NN-<computer>"; /boot/logs points to it.
step "stick log folder" "Preparing the system"
# (udev already read every partition's label: no new scan of all disks, which
# empty card readers can slow down for many seconds)
logs=$(readlink -f /dev/disk/by-label/SYLUXLOGS 2>/dev/null)
[ -b "$logs" ] || logs=
if [ -n "$logs" ]; then
    mkdir -p /boot/logs-stick
    if mount -t vfat -o rw,noatime,flush "$logs" /boot/logs-stick; then
        vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null | tr -d '/')
        product=$(cat /sys/class/dmi/id/product_name 2>/dev/null | tr -d '/')
        board=$(cat /sys/class/dmi/id/board_name 2>/dev/null | tr -d '/')
        machine="$vendor $product"
        case "$product" in ""|"System Product Name"|"To be filled by O.E.M."|"Default string")
            machine="$(cat /sys/class/dmi/id/board_vendor 2>/dev/null | tr -d '/') $board" ;;
        esac
        machine=$(echo "$machine" | sed 's/^ *//; s/ *$//')
        [ -n "$machine" ] || machine="Unknown PC"
        highest=0
        for d in /boot/logs-stick/[0-9][0-9]-*; do
            [ -d "$d" ] || continue
            n=$(basename "$d" | cut -c1-2 | sed 's/^0//')
            [ "$n" -gt "$highest" ] 2>/dev/null && highest=$n
        done
        number=$((highest < 99 ? highest + 1 : 99))
        folder=$(printf '%02d-%s' "$number" "$machine")
        mkdir -p "/boot/logs-stick/$folder"
        ln -sfn "/boot/logs-stick/$folder" /boot/logs
        printf 'Computer: %s\r\nBoot options: %s\r\nKernel: Linux %s\r\n' "$machine" "$(cat /proc/cmdline)" \
            "$(uname -r)" > /boot/logs/machine.txt
        sync
        # The kernel log onto the stick: every 10 s for 15 minutes, then every
        # 2 minutes (and at shutdown), so a machine that stops leaves its last lines.
        (
            i=0
            while :; do
                dmesg > /boot/logs/syluxium-log.txt.new 2>/dev/null &&
                    mv -f /boot/logs/syluxium-log.txt.new /boot/logs/syluxium-log.txt
                sync
                if [ $i -lt 90 ]; then sleep 10; else sleep 120; fi
                i=$((i + 1))
            done
        ) > /dev/null 2>&1 &
    fi
fi

# ---- the stick's (or disk's) EFI partition at /boot/efi ----
step "EFI partition"
# ---- the EFI partition of the disk Syluxium runs from, at /boot/efi ----
# Only that disk's: another disk's (an earlier install, Windows) would make the
# installer take that disk for the running system and hide it.
rootdev=$(awk '$2 == "/" {d = $1} END {print d}' /proc/mounts)
rootdisk=
case "$rootdev" in
    /dev/*) rootdisk=$(basename "$(readlink -f "/sys/class/block/${rootdev#/dev/}/..")") ;;
esac
esp=
if [ -n "$rootdisk" ] && [ -d "/sys/block/$rootdisk" ]; then
    for b in /sys/block/"$rootdisk"/"$rootdisk"*; do
        n=/dev/${b##*/}
        [ "$n" = "$logs" ] && continue
        udevadm info -q property -n "$n" 2>/dev/null | grep -qx ID_FS_TYPE=vfat && { esp=$n; break; }
    done
else
    esp=$(readlink -f /dev/disk/by-label/SYLUXIUM 2>/dev/null) # in memory: the stick's
fi
if [ -b "$esp" ]; then
    mkdir -p /boot/efi
    mount -t vfat -o rw,noatime "$esp" /boot/efi 2>/dev/null
fi

step "network" "Starting the network"
# ---- network: every adapter's settings (DHCP unless set otherwise) ----
[ -e /etc/resolv.conf ] || ln -sf /run/resolv.conf /etc/resolv.conf
: > /run/resolv.conf
syluxium-netconfig apply > /var/log/syluxium-netconfig.log 2>&1 &

# ---- clock zone, random seed, user runtime dirs ----
[ -e /etc/localtime ] || ln -sf /usr/share/zoneinfo/UTC /etc/localtime
chmod 1777 /tmp
# The loading screen stays until the desktop draws (startdesktop closes it);
# a text console boot closes it now.
if grep -qw desktop /proc/cmdline; then
    step "start-up done" "Starting the desktop"
else
    step "start-up done"
    plymouth quit 2>/dev/null
fi
exit 0
