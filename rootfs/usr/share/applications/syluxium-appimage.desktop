[Desktop Entry]
Type=Application
Name=AppImage Launcher
GenericName=Linux Program (AppImage)
Comment=Run a downloaded Linux program (.AppImage)
Exec=syluxium-appimage %f
Icon=application-x-executable
MimeType=application/vnd.appimage;application/x-iso9660-appimage;
InitialPreference=12
NoDisplay=true
Terminal=false
Categories=System;
