#!/bin/sh
# halt: ask every program to quit (they may save their work), wait a
# moment, then let the kernel flush the disks and halt.
[ "$(id -u)" = 0 ] || { echo "halt: must be run as root (try: sudo halt)" >&2; exit 1; }
sync
kill -TERM -1 2>/dev/null
sleep 2
kill -KILL -1 2>/dev/null
sync
exec busybox halt -f
