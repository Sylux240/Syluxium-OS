#!/bin/sh
# poweroff: ask every program to quit (they may save their work), wait a
# moment, then let the kernel flush the disks and poweroff.
[ "$(id -u)" = 0 ] || { echo "poweroff: must be run as root (try: sudo poweroff)" >&2; exit 1; }
sync
kill -TERM -1 2>/dev/null
sleep 2
kill -KILL -1 2>/dev/null
sync
exec busybox poweroff -f
