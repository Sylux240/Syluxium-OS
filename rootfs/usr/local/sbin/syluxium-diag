#!/bin/sh
# Test-round diagnostics: everything useful for working out what happened on
# a machine goes into this boot's folder on the stick (/boot/logs, next to
# the kernel log), so a stick brought back after a round tells the story.
#
#   syluxium-diag hardware        hardware.txt: PCI/USB devices and their drivers,
#                                 displays, network, disks, CPU, memory (once)
#   syluxium-diag status          status.txt / status-history.txt: load, memory,
#                                 busiest processes, zombies (every 15 s)
#   syluxium-diag logs            copy the session's logs (X, login, shell, Wi-Fi, ...;
#                                 the Wayland shell's Xwayland: xwayland.log)
#   syluxium-diag mark <text>     milestones.txt: "<seconds since boot> <text>"
#   syluxium-diag gpu-clients     gpu-clients.txt: why programs do or don't get the
#                                 GPU (Mesa's own explanation); GPU Test entry only
#   syluxium-diag cards           gpu-cards.txt (and stdout): one entry per DRM card -
#                                 driver, PCI device, render node, outputs connected,
#                                 NVIDIA GSP-RM firmware; which card drives the desktop
#   syluxium-diag gpu [name]      gpu.txt (or gpu-<name>.txt): the GPU stack top to
#                                 bottom - kernel driver start (firmware, IP blocks,
#                                 errors), /dev/dri and the sysfs files libdrm reads,
#                                 drmGetDevice2 per node, Mesa's driver choice (EGL
#                                 GBM/surfaceless/device), X server glamor/DRI3,
#                                 glxinfo, vulkaninfo --summary, vainfo. GPU_OUT=<file>
#                                 writes it there (no stick needed: test aids)
#   syluxium-diag android         android.txt: Android apps (Waydroid) - set up or not,
#                                 image versions, container and session state, GPU
#                                 mode, binder devices, Waydroid's and the container's
#                                 logs, Android's boot state and its last fatal log lines
#   syluxium-diag xwatch          GPU Test entry: X server start milestones and logs
#                                 to the stick every 2 s for 3 minutes (a machine that
#                                 hangs as X starts still leaves its last state)
#   syluxium-diag appimage        appimage.txt: does the pre-installed dGPUFG AppImage
#                                 start (FUSE mount, its Vulkan GPU list, its window
#                                 drawn off screen); one line in milestones.txt
#
# Never copies secrets: wpa_supplicant's configuration (the Wi-Fi key) is not
# read, and passwords are scrubbed from what is copied.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/trinity/bin
up() { cut -d' ' -f1 /proc/uptime; }

# Mesa's debug output without the noise (config tables, missing drirc).
mesa_filter() {
    grep -v -E "libEGL debug: +([0-9]+ +)?0x0|libEGL debug: (---|cho |sen )|No DRI config supports|Can't open configuration file|^$"
}

# The GPU stack, top to bottom (see "gpu" above).
# One line per DRM card (two-GPU machines: which is which, which has the
# monitor and drives the desktop, NVIDIA GSP-RM firmware or not).
gpu_cards() {
    drminfo=$(command -v drminfo || echo /opt/syluxium/tests/drminfo)
    for c in /dev/dri/card*; do
        [ -e "$c" ] || { echo "no /dev/dri/card*"; break; }
        m=${c#/dev/dri/card}
        dev=$(readlink -f "/sys/dev/char/226:$m/device" 2>/dev/null)
        pci=${dev##*/}
        render=$(ls "$dev/drm" 2>/dev/null | grep renderD | tr '\n' ' ')
        irq=$(grep -h "" "$dev/irq" 2>/dev/null)
        echo "$c: $("$drminfo" "$c" 2>/dev/null | cut -d' ' -f1-2) pci $pci $(cat "$dev/vendor" 2>/dev/null):$(cat "$dev/device" 2>/dev/null) render ${render:-none} irq ${irq:-?} boot_vga $(cat "$dev/boot_vga" 2>/dev/null || echo -)"
        echo "    outputs: $("$drminfo" -c "$c" 2>/dev/null)"
        if [ "$(cat "$dev/vendor" 2>/dev/null)" = 0x10de ]; then
            gsp=$(dmesg 2>/dev/null | grep "$pci" | grep -E "GSP|gsp" | tail -3)
            echo "    GSP-RM: ${gsp:-no GSP lines for $pci (pre-Turing GPU, or nouveau did not get that far)}" | sed '2,$s/^/            /'
        fi
    done
    echo "desktop on: $(cat /run/syluxium/display-card 2>/dev/null || echo unknown) (syluxium-display-config: the card with a monitor connected)"
    grep -h -E "BusID|kmsdev|AutoAddGPU" /etc/X11/xorg.conf.d/20-display.conf 2>/dev/null | sed 's/^ */    xorg.conf: /'
    [ -r /var/log/Xorg.0.log ] && grep -E "modeset\(0\): (glamor|Output .* connected)|kmsdev|PCI:.*BusID|platform: " /var/log/Xorg.0.log 2>/dev/null | head -12 | sed 's/^/    Xorg: /'
}

gpu_report() {
    echo "== GPU report at $(up) s as $(id -un), $(uname -srv)"
    echo "cmdline: $(cat /proc/cmdline)"
    echo; echo "== Display devices (PCI class 03)"
    for d in /sys/bus/pci/devices/*; do
        case "$(cat "$d/class" 2>/dev/null)" in
            0x03*) echo "${d##*/} $(cat "$d/vendor"):$(cat "$d/device") sub $(cat "$d/subsystem_vendor"):$(cat "$d/subsystem_device") rev $(cat "$d/revision") class $(cat "$d/class") driver $(basename "$(readlink "$d/driver" 2>/dev/null)" 2>/dev/null)" ;;
        esac
    done
    lspci -nnk 2>/dev/null | grep -A3 -E "VGA|Display|3D controller"
    echo; echo "== DRM cards: driver, PCI device, render node, outputs; which one drives the screen"
    gpu_cards
    echo; echo "== Kernel: GPU driver start (firmware, IP blocks, rings, errors)"
    dmesg 2>/dev/null | grep -E "amdgpu|radeon|nouveau|i915|virtio_gpu|virtio-pci|\[drm\]|drm:|aperture|firmware|GPU|gpu_sched|ring |IP block|VRAM|GTT|PSP|SMU|DMUB|DCN|VCN|MES" \
        | grep -v -E "\[drm:[0-9a-f]+\] [^*]" | head -400
    echo; echo "== Slow GPU ioctls (2 s or more) and failing ones"
    dmesg 2>/dev/null | grep -E "drm: .*(took [0-9]+ ms|failed: )" | tail -40
    if grep -qw drmtrace /proc/cmdline; then
        echo; echo "== drmtrace (boot option): the last 300 GPU ioctls"
        dmesg 2>/dev/null | grep "drmtrace:" | tail -300
    fi
    echo; echo "== /dev/dri and what libdrm makes of it (syluxium-drm-devices)"
    ls -l /dev/dri 2>&1
    ls -l /sys/class/drm 2>&1
    syluxium-drm-devices 2>&1
    # Trace boots with an AMD card: stream the kernel log to the stick,
    # synced every 0.2 s, for the rest of the GPU report and X's start (10
    # minutes). The first Mesa context on an RX 6700 XT froze the machine
    # within a second of the last periodic log save; drmtrace logs each
    # submission before it runs, so the stream ends at the one that hung.
    # (Boot option "gpustream": the same on any card.)
    if { grep -qw gpustream /proc/cmdline ||
         { grep -qw drmtrace /proc/cmdline && ls -l /sys/class/drm/*/device/driver 2>/dev/null | grep -q amdgpu; }; } &&
       [ -d /boot/logs ] && [ "$(id -u)" = 0 ] && [ ! -e /run/syluxium-gpu-stream ]; then
        # (BusyBox dmesg can't follow (-w) and /dev/kmsg isn't readable yet:
        # snapshot the last 400 lines instead; the rename keeps a complete
        # copy on the stick even if the machine stops mid-write.)
        touch /run/syluxium-gpu-stream
        ( end=$(( $(cut -d. -f1 /proc/uptime) + 600 ))
          while [ -e /run/syluxium-gpu-stream ] && [ "$(cut -d. -f1 /proc/uptime)" -lt "$end" ]; do
              dmesg 2>/dev/null | tail -400 > /boot/logs/.gpu-kernel-stream.tmp
              mv -f /boot/logs/.gpu-kernel-stream.tmp /boot/logs/gpu-kernel-stream.txt
              sync; sleep 0.2
          done
          rm -f /run/syluxium-gpu-stream ) > /dev/null 2>&1 &
        sleep 0.5
    fi
    # Boot option "amdgputest": the first user-space GPU work on each AMD
    # card, one step at a time, every step synced to the stick before it
    # runs (amdgpu-steps.txt): a freeze shows the step it happened in.
    if grep -qw amdgputest /proc/cmdline; then
        for n in /dev/dri/renderD*; do
            [ "$(drminfo -n "$n" 2>/dev/null || /opt/syluxium/tests/drminfo -n "$n" 2>/dev/null)" = amdgpu ] || continue
            echo; echo "== amdgputest $n: context, buffers, GPU address space, SDMA/GFX/compute writes"
            out=/dev/null
            [ -d /boot/logs ] && [ "$(id -u)" = 0 ] && out=/boot/logs/amdgpu-steps-${n##*/}.txt
            t=$(command -v amdgputest || echo /opt/syluxium/tests/amdgputest)
            # On the RX 6700 XT the test's device close never returned (the
            # machine kept running): if it is still there after 25 s, dump
            # every thread's kernel call chain into the log (streamed to
            # the stick), twice, to see where amdgpu waits.
            timeout 60 "$t" "$n" "$out" 2>&1 &
            tp=$!
            i=0
            while kill -0 "$tp" 2>/dev/null && [ $i -lt 25 ]; do sleep 1; i=$((i + 1)); done
            if kill -0 "$tp" 2>/dev/null; then
                echo "amdgputest still running after 25 s: thread dumps into the kernel log"
                echo "syluxium-diag: amdgputest hung, thread dump" > /dev/kmsg 2>/dev/null
                echo w > /proc/sysrq-trigger 2>/dev/null
                sleep 5
                echo w > /proc/sysrq-trigger 2>/dev/null
                sleep 3
            fi
            wait "$tp" 2>/dev/null &
            echo "-- exit (see the step log)"
            sync
        done
    fi
    echo; echo "== Mesa's driver choice without X (EGL GBM, surfaceless and device platforms)"
    # (markers in the kernel log: the stick's stream shows which program ran)
    kmark() { echo "syluxium-diag: $*" > /dev/kmsg 2>/dev/null; }
    for p in gbm surfaceless device; do
        kmark "starting eglinfo -B -p $p"
        echo "-- eglinfo -B -p $p"
        LIBGL_DEBUG=verbose EGL_LOG_LEVEL=debug MESA_DEBUG=1 timeout 30 eglinfo -B -p $p 2>&1 | mesa_filter | head -60
        echo "-- exit $?"
    done
    if [ -n "$DISPLAY" ]; then
        echo; echo "== In the X session ($DISPLAY)"
        kmark "starting glxinfo -B"
        echo "-- glxinfo -B"
        LIBGL_DEBUG=verbose MESA_DEBUG=1 timeout 30 glxinfo -B 2>&1 | mesa_filter | head -60
        echo "-- exit $?"
        echo "-- X extensions (DRI3, Present, GLX)"
        python3 -c 'import ctypes, ctypes.util
x = ctypes.CDLL(ctypes.util.find_library("X11")); x.XOpenDisplay.restype = ctypes.c_void_p
x.XListExtensions.restype = ctypes.POINTER(ctypes.c_char_p); x.XListExtensions.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
d = x.XOpenDisplay(None); n = ctypes.c_int()
l = x.XListExtensions(d, ctypes.byref(n)) if d else None
print(" ".join(sorted(l[i].decode() for i in range(n.value))) if l else "no display")' 2>&1
    fi
    echo; echo "== X server: glamor, DRI3, GLX (Xorg.0.log)"
    grep -E "glamor|DRI3|DRI2|AIGLX|GLX|EGL|Acceleration|AccelMethod|kmsdev|using \/dev\/dri|Output .* connected|\\(EE\\)|\\(WW\\) modeset|Backtrace|Segmentation|Fatal|^\\[ *[0-9.]*\\] *[0-9]+: " /var/log/Xorg.0.log 2>/dev/null | grep -v "(WW) warning, (EE) error" | head -80
    echo; echo "== Vulkan (vulkaninfo --summary)"
    if command -v vulkaninfo > /dev/null; then
        kmark "starting vulkaninfo --summary"
        VK_LOADER_DEBUG=error,warn timeout 30 vulkaninfo --summary 2>&1 | grep -v "extension revision" | head -100
        echo "-- exit $?"
    else
        echo "vulkaninfo not installed"
    fi
    ls /usr/share/vulkan/icd.d 2>&1
    echo; echo "== Video decode (vainfo)"
    if command -v vainfo > /dev/null; then
        for n in /dev/dri/renderD*; do
            [ -e "$n" ] || continue
            echo "-- $n"
            # amdgpu's video engine (VCN) froze a machine (RX 6700 XT) at its
            # first use: only with the boot option "vaapi".
            drv=$(basename "$(readlink "/sys/class/drm/${n##*/}/device/driver" 2>/dev/null)" 2>/dev/null)
            if [ "$drv" = amdgpu ] && ! grep -qw vaapi /proc/cmdline; then
                echo "skipped: amdgpu video decode (VCN) is off until it is fixed (boot option vaapi runs it)"
                continue
            fi
            # The kernel log reaches the stick only every 20 s: while vainfo
            # runs, stream it there (synced), so a machine that freezes in
            # the video engine still leaves its last kernel lines.
            if [ -d /boot/logs ] && [ ! -e /run/syluxium-gpu-stream ]; then
                touch /run/syluxium-vainfo-dmesg
                ( while [ -e /run/syluxium-vainfo-dmesg ]; do
                      dmesg 2>/dev/null | tail -400 > /boot/logs/.vainfo-kernel.tmp
                      mv -f /boot/logs/.vainfo-kernel.tmp /boot/logs/vainfo-kernel.txt
                      sync; sleep 0.2
                  done ) &
                sleep 0.5
            fi
            kmark "starting vainfo on $n"
            timeout 20 vainfo --display drm --device "$n" 2>&1 | head -30
            if [ -e /run/syluxium-vainfo-dmesg ]; then
                kill "$(cat /run/syluxium-vainfo-dmesg)" 2>/dev/null
                rm -f /run/syluxium-vainfo-dmesg
                sync
            fi
        done
    else
        echo "vainfo not installed"
    fi
    echo; echo "== Firmware files the kernel asked for"
    dmesg 2>/dev/null | grep -i -E "firmware|\.bin" | grep -i -E "amdgpu|nouveau|nvidia|i915|radeon|direct firmware|failed to load|loading" | tail -60
    echo "== end at $(up) s"
}

# Android apps (Waydroid): see "android" above.
android_report() {
    echo "== Android report at $(up) s as $(id -un)"
    if [ ! -f /var/lib/waydroid/waydroid.cfg ]; then
        echo "Android is not set up (no /var/lib/waydroid/waydroid.cfg)"
        ls -la /etc/waydroid-extra/images /var/lib/waydroid/images 2>&1
        return
    fi
    echo "-- waydroid.cfg"; cat /var/lib/waydroid/waydroid.cfg
    echo; echo "-- images"
    ls -la /etc/waydroid-extra/images /var/lib/waydroid/images 2>/dev/null
    grep -h "ro.build.display.id\|ro.build.version.release=\|ro.lineage.version" \
        /var/lib/waydroid/rootfs/system/build.prop 2>/dev/null
    echo; echo "-- state"
    /usr/local/sbin/syluxium-android-container status 2>&1
    waydroid status 2>&1
    lxc-info -P /var/lib/waydroid/lxc -n waydroid 2>&1 | head -8
    echo; echo "-- GPU mode (waydroid_base.prop: gralloc/EGL; gbm = GPU, default/swiftshader = software)"
    grep -h "gralloc\|egl\|vulkan\|ro.hardware\|drm" /var/lib/waydroid/waydroid_base.prop 2>/dev/null
    ls -l /dev/dri 2>&1
    echo; echo "-- binder"
    ls -l /dev/binderfs /dev/anbox-* 2>&1
    grep binder /proc/mounts
    echo; echo "-- Android (inside the container)"
    if [ "$(id -u)" = 0 ] && lxc-info -P /var/lib/waydroid/lxc -n waydroid 2>/dev/null | grep -q RUNNING; then
        a() { timeout 20 lxc-attach -P /var/lib/waydroid/lxc -n waydroid --clear-env -- "$@" 2>&1; }
        echo "sys.boot_completed=$(a /system/bin/getprop sys.boot_completed)"
        echo "persist.waydroid.multi_windows=$(a /system/bin/getprop persist.waydroid.multi_windows)"
        echo "ro.hardware.gralloc=$(a /system/bin/getprop ro.hardware.gralloc) ro.hardware.egl=$(a /system/bin/getprop ro.hardware.egl)"
        echo "-- processes"; a /system/bin/ps -A -o PID,NAME | grep -v "\[" | head -100
        echo "-- last fatal/error lines (logcat)"
        a /system/bin/logcat -d -b all 2>/dev/null | grep -v "runtime.cc:675\|option\[" | grep " [EF] " | tail -80
    else
        echo "(not running, or not root)"
    fi
    echo; echo "-- Waydroid log (last 150 lines)"
    tail -150 /var/lib/waydroid/waydroid.log 2>&1
    echo; echo "-- container log"
    tail -60 /var/log/waydroid-container.log 2>&1
    for u in /home/*/.cache/syluxium-android.log; do
        [ -f "$u" ] && { echo; echo "-- $u (last 80 lines)"; tail -80 "$u"; }
    done
    echo "== end at $(up) s"
}

if [ "$1" = cards ]; then
    out=/dev/null
    grep -q " /boot/logs-stick " /proc/mounts && [ "$(id -u)" = 0 ] && [ -d /boot/logs ] && out=/boot/logs/gpu-cards.txt
    { echo "== DRM cards at $(up) s"; gpu_cards; } 2>&1 | tee "$out"
    exit 0
fi
if [ "$1" = gpu ] && [ -n "$GPU_OUT" ]; then
    gpu_report > "$GPU_OUT" 2>&1
    exit 0
fi

L=/boot/logs
grep -q " /boot/logs-stick " /proc/mounts || exit 0
# The desktop user can't write to the stick (or even look into /boot/logs):
# their parts (milestones, GPU check) go to /run/syluxium-diag, which root's
# "logs" step copies over.
if [ "$(id -u)" != 0 ]; then
    L=/run/syluxium-diag
    [ -d "$L" ] || exit 0
else
    [ -d "$L" ] || exit 0
fi
case "$1" in
hardware)
    {
        echo "== $(uname -srv) at $(up) s"
        echo "cmdline: $(cat /proc/cmdline)"
        echo; echo "== CPU / memory"
        grep -m1 "model name" /proc/cpuinfo; echo "cpus: $(grep -c ^processor /proc/cpuinfo)"
        grep -E "MemTotal|MemAvailable" /proc/meminfo
        echo; echo "== Drivers: every PCI/USB device (bound to <driver> / no driver / probe failed: <error>)"
        awk -F'\t' '$2 == "pci" || $2 == "usb" {
            if ($6 == "ok") s = "bound to " $7
            else if ($6 == "error") s = "probe failed: " ($9 != "" ? $9 : $7)
            else s = "no driver"
            printf "%-14s %s  %-40s %s\n", $3, $5, substr($8, 1, 40), s
        }' /sys/kernel/syluxium/devices 2>&1
        echo; echo "== Firmware requested by drivers but missing (drivers often try several versions: a"
        echo "   missing file is only a problem when no file of its family was loaded)"
        awk -F'\t' '$1 == "missing" { printf "%-14s %s\n", $2, $3; n++ } END { if (!n) print "(none)" }' \
            /sys/kernel/syluxium/firmware 2>&1
        echo "-- loaded:"
        awk -F'\t' '$1 == "loaded" { printf "%-14s %s\n", $2, $3 }' /sys/kernel/syluxium/firmware 2>&1
        echo; echo "== PCI (lspci -nnk)"; lspci -nnk 2>&1
        echo; echo "== USB devices (vendor:product, name, driver per interface)"
        for d in /sys/bus/usb/devices/*; do
            [ -f "$d/idVendor" ] || continue
            printf '%s  %s:%s  %s %s\n' "$(basename "$d")" "$(cat "$d/idVendor")" "$(cat "$d/idProduct")" \
                "$(cat "$d/manufacturer" 2>/dev/null)" "$(cat "$d/product" 2>/dev/null)"
            for i in "$d"/*:*; do
                [ -d "$i" ] || continue
                drv=$(basename "$(readlink "$i/driver" 2>/dev/null)" 2>/dev/null)
                printf '    if %s class %s -> %s\n' "${i##*:}" "$(cat "$i/bInterfaceClass" 2>/dev/null)" "${drv:-no driver}"
            done
        done
        echo; echo "== Displays (DRM)"
        for c in /sys/class/drm/card*; do
            [ -e "$c" ] || continue
            echo "$(basename "$c"): $(basename "$(readlink "$c/device/driver" 2>/dev/null)" 2>/dev/null) $(cat "$c/status" 2>/dev/null)"
        done
        ls -l /dev/dri 2>&1
        echo; echo "== Network"
        ip -br link 2>&1; ip -br addr 2>&1; ip route 2>&1
        command -v iw >/dev/null && iw dev 2>&1
        echo; echo "== Disks"
        cat /proc/partitions; grep -E "^/dev" /proc/mounts
        echo; echo "== Input devices"
        grep -E "^N: Name=|^H: Handlers=" /proc/bus/input/devices 2>/dev/null
        echo; echo "== Sound"
        cat /proc/asound/cards 2>/dev/null
        echo; echo "== Power"
        for b in /sys/class/power_supply/*; do [ -e "$b" ] && echo "$(basename "$b"): $(cat "$b/type" 2>/dev/null) $(cat "$b/status" 2>/dev/null) $(cat "$b/capacity" 2>/dev/null)%"; done
        ls /sys/class/backlight 2>/dev/null
    } > "$L/hardware.txt" 2>&1
    ;;
status)
    {
        echo "== $(up) s  load $(cut -d' ' -f1-3 /proc/loadavg)  $(grep -E 'MemAvailable' /proc/meminfo | tr -s ' ')"
        ps -eo pid,stat,pcpu,rss,etime,comm --sort=-pcpu 2>/dev/null | head -9
        z=$(ps -eo stat,pid,comm 2>/dev/null | awk '$1 ~ /^Z/ {print $2 "/" $3}' | tr '\n' ' ')
        [ -n "$z" ] && echo "zombies: $z"
        d=$(ps -eo stat,pid,comm 2>/dev/null | awk '$1 ~ /^D/ {print $2 "/" $3}' | tr '\n' ' ')
        [ -n "$d" ] && echo "waiting on disk/device (D): $d"
    } > "$L/status.txt" 2>&1
    cat "$L/status.txt" >> "$L/status-history.txt"
    # Keep the history to the last ~2000 lines.
    if [ "$(wc -l < "$L/status-history.txt")" -gt 2400 ]; then
        tail -n 2000 "$L/status-history.txt" > "$L/status-history.tmp" && mv "$L/status-history.tmp" "$L/status-history.txt"
    fi
    ;;
logs)
    for f in /var/log/Xorg.0.log /var/log/Xorg.0.log.old /var/log/tdm.log /var/log/tdm.out \
             /var/log/syluxium-shell.log /var/log/seatd.log /var/log/bluetoothd.log /var/log/bluealsa.log \
             /var/log/syluxium-netconfig.log /var/log/syluxium-wifi.log /var/log/wpa_supplicant.log \
             /var/log/dbus-system.log /var/log/polkitd.log /var/log/cups/error_log \
             /var/log/syluxium-install.log; do
        [ -f "$f" ] && sed -E 's/(psk|password|passphrase)=[^ ]*/\1=********/Ig' "$f" > "$L/$(basename "$f")" 2>/dev/null
    done
    [ -d /run/syluxium-diag ] && cp /run/syluxium-diag/* "$L/" 2>/dev/null
    for h in /home/*/.xsession-errors; do
        [ -f "$h" ] && cp "$h" "$L/xsession-errors-$(basename "$(dirname "$h")").txt" 2>/dev/null
    done
    # Wayland programs in the Xfce desktop (syluxium-wayland-host; its
    # summary is wayland-host.txt from /run/syluxium-diag)
    for h in /run/user/*/syluxium-wayland-host.log; do
        [ -f "$h" ] && tail -c 262144 "$h" > "$L/wayland-host-$(basename "$(dirname "$h")").log" 2>/dev/null
    done
    # Android apps, when they have been set up
    [ -f /var/lib/waydroid/waydroid.cfg ] && android_report > "$L/android.txt" 2>&1
    ;;
mark)
    # One file for root and the desktop user alike (in /run: both can write
    # it); "logs" copies it to the stick.
    shift
    mkdir -p /run/syluxium-diag 2>/dev/null
    echo "$(up) $* (as $(id -un))" >> /run/syluxium-diag/milestones.txt
    chmod 666 /run/syluxium-diag/milestones.txt 2>/dev/null
    [ "$(id -u)" = 0 ] && cp /run/syluxium-diag/milestones.txt "$L/" 2>/dev/null
    ;;
gpu-clients)
    # Run as the desktop user inside the session (DISPLAY set). Only with the
    # "gpu" boot option: a broken GPU path may crash the X server, which the
    # marker line then shows.
    grep -qw gpu /proc/cmdline || exit 0
    out="$L/gpu-clients.txt"
    {
        echo "== $(up) s: about to run glxinfo -B (if nothing follows, it crashed the session)"
    } > "$out"
    sync
    LIBGL_DEBUG=verbose MESA_DEBUG=1 timeout 30 glxinfo -B >> "$out" 2>&1
    echo "== exit $? at $(up) s" >> "$out"
    echo "== eglinfo -B" >> "$out"
    EGL_LOG_LEVEL=debug timeout 30 eglinfo -B >> "$out" 2>&1
    echo "== exit $? at $(up) s" >> "$out"
    sync
    # The whole stack as the session sees it (gpu-session.txt).
    gpu_report > "$L/gpu-session.txt" 2>&1
    sync
    ;;
android)
    android_report > "$L/android.txt" 2>&1
    sync
    ;;
gpu)
    gpu_report > "$L/gpu${2:+-$2}.txt" 2>&1
    sync
    ;;
xwatch)
    # GPU Test entry, started by startdesktop just before the login screen
    # (which starts the X server): milestones as X comes up, and the X log,
    # the kernel's last GPU messages and the process list on the stick every
    # 2 s, synced, for 3 minutes. If the machine hangs (amdgpu right after X
    # started), the last copy shows how far it got.
    grep -qw gpu /proc/cmdline || exit 0
    seen_sock= seen_glamor= seen_dri3= seen_session=
    for i in $(seq 1 90); do
        if [ -z "$seen_sock" ] && [ -S /tmp/.X11-unix/X0 ]; then
            seen_sock=1; "$0" mark "xwatch: X server socket up"
        fi
        if [ -z "$seen_glamor" ] && grep -q "glamor" /var/log/Xorg.0.log 2>/dev/null; then
            seen_glamor=1; "$0" mark "xwatch: Xorg: $(grep -m1 -E 'glamor (initialized|X acceleration|.*failed)|Glamor|glamor' /var/log/Xorg.0.log | sed 's/^\[ *[0-9.]*\] //')"
        fi
        if [ -z "$seen_dri3" ] && grep -q "DRI3" /var/log/Xorg.0.log 2>/dev/null; then
            seen_dri3=1; "$0" mark "xwatch: Xorg: $(grep -m1 DRI3 /var/log/Xorg.0.log | sed 's/^\[ *[0-9.]*\] //')"
        fi
        if [ -z "$seen_session" ] && pidof xfce4-session > /dev/null; then
            seen_session=1; "$0" mark "xwatch: Xfce session running"
        fi
        cp /var/log/Xorg.0.log "$L/Xorg.0.log" 2>/dev/null
        {
            echo "== $(up) s (xwatch $i/90)"
            ps -eo pid,stat,pcpu,wchan:24,etime,comm --sort=-pcpu 2>/dev/null | head -12
            echo "-- kernel, last GPU lines"
            dmesg 2>/dev/null | grep -E "amdgpu|radeon|nouveau|i915|virtio_gpu|drm|GPU|ring|fence|timeout|hang|watchdog|lockup" | tail -25
        } > "$L/xwatch.txt" 2>&1
        sync
        sleep 2
    done
    ;;
appimage)
    # Run as the desktop user inside the session. Nothing shows on screen.
    [ -x /usr/local/bin/dgpufg ] || exit 0
    export SYLUXIUM_APPIMAGE_NOGUI=1   # failures go into the file, never onto the screen
    out="$L/appimage.txt"
    shots=$(mktemp -d)
    {
        echo "== $(up) s: dGPUFG AppImage ($(ls /opt/apps/dgpufg/*.AppImage 2>/dev/null))"
        cat /opt/apps/dgpufg/GLIBC-MISMATCH 2>/dev/null
        echo "FUSE: /dev/fuse $([ -c /dev/fuse ] && echo present || echo MISSING), $(command -v fusermount3 || echo 'no fusermount3')"
        echo "== dgpufg cli gpus (Vulkan devices it sees)"
        DGPUFG_LOG=1 timeout 60 /usr/local/bin/dgpufg cli gpus > "$shots.log" 2>&1
        rc=$?
        tail -n 40 "$shots.log"
        echo "== exit $rc at $(up) s"
        # The GUI: AppImages bundle only Qt's X11 plugin (no "offscreen"), so
        # rather than open a window at every login, check that the GUI's
        # program and every library it needs load from the AppImage itself.
        echo "== GUI libraries (from the AppImage)"
        ( cd "$shots" && "$(ls /opt/apps/dgpufg/*.AppImage | head -n 1)" --appimage-extract >/dev/null 2>&1 )
        root="$shots/squashfs-root"
        missing=$(LD_LIBRARY_PATH="$root/usr/lib" ldd "$root/usr/bin/dgpufg" 2>&1 | grep -E "not found")
        echo "${missing:-every library found}"
        [ -f "$root/usr/plugins/platforms/libqxcb.so" ] && echo "Qt X11 plugin: present" || echo "Qt X11 plugin: MISSING"
        gui=1; [ -x "$root/usr/bin/dgpufg" ] && [ -z "$missing" ] && gui=0
        echo "== at $(up) s"
    } > "$out" 2>&1
    rm -rf "$shots"
    if [ "$rc" = 0 ] && [ "$gui" = 0 ]; then res="CLI ran, GUI libraries complete"; else res="FAILED (cli exit $rc, gui check $gui; see appimage.txt)"; fi
    "$0" mark "appimage: dGPUFG $res"
    ;;
esac
