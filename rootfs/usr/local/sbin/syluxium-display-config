#!/bin/sh
# Chooses the X display driver for this machine, at every boot (the same
# disk moves between computers):
#   a GPU driver (i915, amdgpu, radeon, nouveau) -> modesetting + glamor (OpenGL acceleration)
#   virtio-gpu with virgl (QEMU 3D)               -> modesetting + glamor (on the host GPU)
#   another kernel display driver (simpledrm, 2D virtio-gpu) -> modesetting, no acceleration
#   no kernel display driver                     -> fbdev (/dev/fb0)
# Boot options: "xfbdev" forces fbdev, "noaccel" turns acceleration off,
# "nogpu" (kernel) keeps GPU drivers from loading at all.
out=/etc/X11/xorg.conf.d/20-display.conf
log=/boot/logs/display.txt
drminfo=$(command -v drminfo || echo /opt/syluxium/tests/drminfo)
# Machines with two GPUs (an H97 with a GTX 980 and a GTX 1650): the card
# with a monitor connected drives the desktop; with none or several
# connected, the one with the most outputs connected, then the one the
# firmware showed the boot screen on (boot_vga), then the first.
cards=$(ls /dev/dri/card* 2>/dev/null)
card=""
best=-1
cardlist=""
for c in $cards; do
    n=0
    conn=""
    if [ -x "$drminfo" ]; then
        conn=$("$drminfo" -c "$c" 2>/dev/null)
        n=${conn%% *}
        case "$n" in ''|*[!0-9]*) n=0 ;; esac
    fi
    bootvga=$(cat "/sys/dev/char/226:${c#/dev/dri/card}/device/boot_vga" 2>/dev/null)
    cardlist="$cardlist
  $c: $("$drminfo" "$c" 2>/dev/null | cut -d' ' -f1) $(readlink -f "/sys/dev/char/226:${c#/dev/dri/card}/device" 2>/dev/null | sed 's|.*/||')${bootvga:+ boot_vga $bootvga}; outputs: ${conn:-?}"
    # (score: connected outputs, then boot_vga)
    score=$((n * 2 + ${bootvga:-0}))
    if [ "$score" -gt "$best" ]; then
        best=$score
        card=$c
    fi
done
driver=""
info=""
if [ -n "$card" ] && [ -x "$drminfo" ]; then
    info=$("$drminfo" "$card" 2>&1)
    driver=$("$drminfo" -n "$card" 2>/dev/null)
fi
# Without drminfo (or when it can't run on this CPU): the card's PCI device
# names its driver in sysfs.
if [ -z "$driver" ] && [ -n "$card" ]; then
    minor=${card#/dev/dri/card}
    driver=$(sed -n 's/^DRIVER=//p' "/sys/dev/char/226:$minor/device/uevent" 2>/dev/null | head -1)
    [ -n "$driver" ] || driver=$(basename "$(readlink "/sys/dev/char/226:$minor/device/driver" 2>/dev/null)" 2>/dev/null)
fi
accel=none
case "$driver" in
    i915|amdgpu|radeon|nouveau) accel=glamor ;;
    # A VM's virtio-gpu with 3D (QEMU virgl): Mesa's virgl driver, the host's GPU.
    virtio_gpu) dmesg 2>/dev/null | grep -q "features: +virgl" && accel=glamor ;;
esac
# glamor needs Mesa's OpenGL drivers.
if [ "$accel" = glamor ] && ! ls /usr/lib/x86_64-linux-gnu/libgallium-*.so /usr/lib/x86_64-linux-gnu/dri/*_dri.so >/dev/null 2>&1; then
    accel=none
    info="$info (no Mesa: acceleration off)"
fi
grep -qw noaccel /proc/cmdline && accel=none
# The chosen card's PCI address as Xorg writes it (decimal bus:device:function),
# so the X server binds that GPU; other GPUs aren't added as extra screens.
busid=""
slot=$(sed -n 's/^PCI_SLOT_NAME=//p' "/sys/dev/char/226:${card#/dev/dri/card}/device/uevent" 2>/dev/null)
if [ -n "$slot" ]; then
    b=${slot#*:}; d=${b#*:}; f=${d#*.}; b=${b%%:*}; d=${d%%.*}
    busid="PCI:$((0x$b)):$((0x$d)):$((0x$f))"
fi
ncards=$(echo "$cards" | grep -c card)
mkdir -p /run/syluxium && echo "$card" > /run/syluxium/display-card
# Hardware video decoding (VA-API) on AMD: the video engine (VCN) froze a
# machine (RX 6700 XT) at its first use. Off in the desktop sessions until
# that is fixed (programs decode in software); boot option "vaapi" keeps it.
rm -f /run/syluxium/vaapi-off
if ! grep -qw vaapi /proc/cmdline; then
    for d in /sys/class/drm/card*/device/driver; do
        [ "$(basename "$(readlink "$d" 2>/dev/null)" 2>/dev/null)" = amdgpu ] && touch /run/syluxium/vaapi-off && break
    done
fi
if [ -n "$card" ] && ! grep -qw xfbdev /proc/cmdline; then
    {
        echo "# Written at boot by syluxium-display-config: kernel display driver ${driver:-?} ($card)."
        if [ "$ncards" -gt 1 ]; then
            echo "Section \"ServerFlags\""
            echo "    Option \"AutoAddGPU\" \"false\""
            echo "EndSection"
        fi
        echo "Section \"Device\""
        echo "    Identifier \"Display\""
        echo "    Driver     \"modesetting\""
        [ -n "$busid" ] && [ "$ncards" -gt 1 ] && echo "    BusID      \"$busid\""
        echo "    Option     \"kmsdev\" \"$card\""
        echo "    Option     \"AccelMethod\" \"$accel\""
        echo "EndSection"
    } > "$out"
    choice="modesetting on $card, driver ${driver:-unknown}, acceleration $accel"
else
    # Several graphics cards: the firmware framebuffer belongs to the one
    # the firmware booted on (boot_vga); X's fbdev driver can't tell which
    # without its PCI address ("Unable to find a valid framebuffer device").
    fbbus=""
    nvga=0
    for dev in /sys/bus/pci/devices/*; do
        case "$(cat "$dev/class" 2>/dev/null)" in 0x0300*|0x0380*) nvga=$((nvga + 1)) ;; *) continue ;; esac
        if [ "$(cat "$dev/boot_vga" 2>/dev/null)" = 1 ]; then
            slot=${dev##*/}; b=${slot#*:}; d=${b#*:}; f=${d#*.}; b=${b%%:*}; d=${d%%.*}
            fbbus="PCI:$((0x$b)):$((0x$d)):$((0x$f))"
        fi
    done
    {
        echo "# Written at boot by syluxium-display-config: firmware framebuffer."
        if [ "$nvga" -gt 1 ]; then
            echo "Section \"ServerFlags\""
            echo "    Option \"AutoAddGPU\" \"false\""
            echo "EndSection"
        fi
        echo "Section \"Device\""
        echo "    Identifier \"Display\""
        echo "    Driver     \"fbdev\""
        [ "$nvga" -gt 1 ] && [ -n "$fbbus" ] && echo "    BusID      \"$fbbus\""
        echo "    Option     \"fbdev\" \"/dev/fb0\""
        echo "EndSection"
    } > "$out"
    choice="fbdev on /dev/fb0"
fi
if mkdir -p /boot/logs 2>/dev/null; then
    {
        echo "display: $choice"
        [ -n "$info" ] && echo "drm: $info"
        echo "cards (the one with a monitor connected drives the desktop):$cardlist"
        echo "cmdline: $(cat /proc/cmdline)"
        for d in /sys/bus/pci/devices/*; do
            [ -r "$d/class" ] || continue
            case "$(cat "$d/class")" in
                0x03*) echo "gpu: ${d##*/} $(cat "$d/vendor"):$(cat "$d/device") class $(cat "$d/class")" ;;
            esac
        done
    } > "$log" 2>/dev/null
fi
# Every card, its outputs and (NVIDIA) GSP-RM state, for the stick's log folder.
[ "$ncards" -gt 1 ] || grep -qw gpu /proc/cmdline && syluxium-diag cards > /dev/null 2>&1
echo "display: $choice"
