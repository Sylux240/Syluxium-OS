#!/bin/sh
# Chooses the X display driver for this machine, at every boot (the same
# disk moves between computers):
#   a GPU driver (i915, amdgpu, radeon, nouveau) -> modesetting + glamor (OpenGL acceleration)
#   virtio-gpu with virgl (QEMU 3D)               -> modesetting + glamor (on the host GPU)
#   another kernel display driver (simpledrm, 2D virtio-gpu) -> modesetting, no acceleration
#   no kernel display driver                     -> fbdev (/dev/fb0)
# Boot options: "xfbdev" forces fbdev, "noaccel" turns acceleration off,
# "nogpu" (kernel) keeps GPU drivers from loading at all.
out=/etc/X11/xorg.conf.d/20-display.conf
log=/boot/logs/display.txt
card=$(ls /dev/dri/card* 2>/dev/null | head -1)
drminfo=$(command -v drminfo || echo /opt/syluxium/tests/drminfo)
driver=""
info=""
if [ -n "$card" ] && [ -x "$drminfo" ]; then
    info=$("$drminfo" "$card" 2>&1)
    driver=$("$drminfo" -n "$card" 2>/dev/null)
fi
# Without drminfo (or when it can't run on this CPU): the card's PCI device
# names its driver in sysfs.
if [ -z "$driver" ] && [ -n "$card" ]; then
    minor=${card#/dev/dri/card}
    driver=$(sed -n 's/^DRIVER=//p' "/sys/dev/char/226:$minor/device/uevent" 2>/dev/null | head -1)
    [ -n "$driver" ] || driver=$(basename "$(readlink "/sys/dev/char/226:$minor/device/driver" 2>/dev/null)" 2>/dev/null)
fi
accel=none
case "$driver" in
    i915|amdgpu|radeon|nouveau) accel=glamor ;;
    # A VM's virtio-gpu with 3D (QEMU virgl): Mesa's virgl driver, the host's GPU.
    virtio_gpu) dmesg 2>/dev/null | grep -q "features: +virgl" && accel=glamor ;;
esac
# glamor needs Mesa's OpenGL drivers.
if [ "$accel" = glamor ] && ! ls /usr/lib/x86_64-linux-gnu/libgallium-*.so /usr/lib/x86_64-linux-gnu/dri/*_dri.so >/dev/null 2>&1; then
    accel=none
    info="$info (no Mesa: acceleration off)"
fi
grep -qw noaccel /proc/cmdline && accel=none
if [ -n "$card" ] && ! grep -qw xfbdev /proc/cmdline; then
    cat > "$out" <<CFG
# Written at boot by syluxium-display-config: kernel display driver ${driver:-?} ($card).
Section "Device"
    Identifier "Display"
    Driver     "modesetting"
    Option     "kmsdev" "$card"
    Option     "AccelMethod" "$accel"
EndSection
CFG
    choice="modesetting on $card, driver ${driver:-unknown}, acceleration $accel"
else
    cat > "$out" <<CFG
# Written at boot by syluxium-display-config: firmware framebuffer.
Section "Device"
    Identifier "Display"
    Driver     "fbdev"
    Option     "fbdev" "/dev/fb0"
EndSection
CFG
    choice="fbdev on /dev/fb0"
fi
if mkdir -p /boot/logs 2>/dev/null; then
    {
        echo "display: $choice"
        [ -n "$info" ] && echo "drm: $info"
        echo "cmdline: $(cat /proc/cmdline)"
        for d in /sys/bus/pci/devices/*; do
            [ -r "$d/class" ] || continue
            case "$(cat "$d/class")" in
                0x03*) echo "gpu: ${d##*/} $(cat "$d/vendor"):$(cat "$d/device") class $(cat "$d/class")" ;;
            esac
        done
    } > "$log" 2>/dev/null
fi
echo "display: $choice"
