#!/bin/sh
# Starts wpa_supplicant (as root) for every Wi-Fi interface, now and when a
# USB Wi-Fi adapter is plugged in later (plug and play); the network button
# by the clock talks to it. A replugged adapter comes back as the same
# interface (wlan0) on a new radio (phy#N): wpa_supplicant is restarted for
# it then, since it still holds the radio that was removed.
CONF=/etc/wpa_supplicant/wpa_supplicant.conf
STATE=/run/syluxium-wifi
mkdir -p "$STATE"
start() {
    ip link set "$1" up 2>/dev/null
    wpa_supplicant -B -D nl80211 -i "$1" -c "$CONF" >> /var/log/wpa_supplicant.log 2>&1
    # Linux kernel: an address once connected (Syluxium's own kernel ran DHCP itself).
    [ -x /usr/lib/syluxium/dhcp ] && [ ! -e /proc/sys/net/ipv4/conf/"$1"/syluxium_dhcp ] && /usr/lib/syluxium/dhcp start "$1"
    echo "$2" > "$STATE/$1.phy"
    echo "$(date '+%H:%M:%S') wpa_supplicant started on $1 ($2)"
}
while :; do
    iw dev 2>/dev/null | awk '/^phy#/ {p = $1} $1 == "Interface" {print $2, p}' > "$STATE/now"
    while read -r iface phy; do
        if [ ! -S /run/wpa_supplicant/$iface ]; then
            start "$iface" "$phy"
        elif [ "$(cat "$STATE/$iface.phy" 2>/dev/null)" != "$phy" ]; then
            echo "$(date '+%H:%M:%S') $iface moved to $phy (adapter replugged)"
            /usr/sbin/wpa_cli -p /run/wpa_supplicant -i "$iface" terminate > /dev/null 2>&1
            sleep 1
            start "$iface" "$phy"
        fi
    done < "$STATE/now"
    # Session logs onto the USB stick's log partition (real-hardware debugging).
    if grep -q " /boot/logs " /proc/mounts; then
        mkdir -p /boot/logs/session
        cp /var/log/wpa_supplicant.log /var/log/syluxium-wifi.log /boot/logs/session/ 2>/dev/null
    fi
    sleep 2
done
