#!/bin/sh
# Starts wpa_supplicant (as root) for every Wi-Fi interface, now and when a
# USB Wi-Fi adapter is plugged in later; the network icon (wpa_gui) in the
# desktop's tray talks to it.
CONF=/etc/wpa_supplicant/wpa_supplicant.conf
while :; do
    for iface in $(ls /sys/class/net 2>/dev/null); do
        [ -d /sys/class/net/$iface/wireless ] || [ -e /sys/class/net/$iface/phy80211 ] || \
            iw dev "$iface" info >/dev/null 2>&1 || continue
        [ -S /run/wpa_supplicant/$iface ] && continue
        ip link set "$iface" up 2>/dev/null
        wpa_supplicant -B -D nl80211 -i "$iface" -c "$CONF" >> /var/log/wpa_supplicant.log 2>&1
    done
    sleep 3
done
