#!/usr/bin/python3
"""Test aid: frames per second the desktop delivers to a window. A window
(W x H, default 900x600) animates a box sliding across it on every frame
the compositor asks for (GTK frame clock = Wayland frame callbacks / X
redraws) and logs the rate every 2 s to /tmp/fps.log, ~/fps.log and the console.
    shell-fps-test [seconds] [W] [H] [full]
"full": repaint the whole window each frame (a video), else only the box
and the strip it left (a typical small update)."""
import os
import sys
import time

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

secs = float(sys.argv[1]) if len(sys.argv) > 1 else 30
W = int(sys.argv[2]) if len(sys.argv) > 2 else 900
H = int(sys.argv[3]) if len(sys.argv) > 3 else 600
FULL = len(sys.argv) > 4 and sys.argv[4] == "full"
win = Gtk.Window(title="FPS test")
win.set_default_size(W, H)
area = Gtk.DrawingArea()
win.add(area)
state = {"x": 0, "frames": 0, "t0": time.monotonic(), "start": time.monotonic(), "prev": 0}


def log(text):
    line = f"FPS {text}"
    print(line, flush=True)
    for path in ("/tmp/fps.log", os.path.expanduser("~/fps.log"), "/dev/console"):
        try:
            with open(path, "a") as f:
                f.write(line + "\n")
        except OSError:
            pass


def draw(_w, cr):
    cr.set_source_rgb(0.08, 0.10, 0.23)
    cr.paint()
    cr.set_source_rgb(0.44, 0.89, 0.94)
    cr.rectangle(state["x"], H / 2 - 60, 120, 120)
    cr.fill()
    return False


def tick(_w, _clock):
    old = state["x"]
    state["x"] = (state["x"] + 12) % (W - 120)
    if FULL:
        area.queue_draw()
    else:
        lo, hi = min(old, state["x"]), max(old, state["x"]) + 120
        if hi - lo > 300:
            area.queue_draw()
        else:
            area.queue_draw_area(lo, int(H / 2 - 60), hi - lo, 120)
    state["frames"] += 1
    now = time.monotonic()
    if now - state["t0"] >= 2:
        log(f"{state['frames'] / (now - state['t0']):.1f} frames/s ({W}x{H}{' full' if FULL else ''})")
        state["frames"], state["t0"] = 0, now
    if now - state["start"] > secs:
        Gtk.main_quit()
        return False
    return True


area.connect("draw", draw)
area.add_tick_callback(tick)
win.connect("destroy", Gtk.main_quit)
win.show_all()
Gtk.main()
