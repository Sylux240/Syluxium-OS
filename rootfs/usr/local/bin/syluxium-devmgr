#!/usr/bin/python3
"""Device Manager: every device the kernel knows, by category, with its driver and status."""
import sys
sys.path.insert(0, "/usr/local/lib/syluxium/python")
from syluxium_sys import *  # noqa: F401,F403

win = window("Device Manager", 560, 520, "computer")
tree = DeviceTree(win)
tree.set_margin_start(6), tree.set_margin_end(6), tree.set_margin_top(6), tree.set_margin_bottom(6)
win.add(tree)
win.show_all()
Gtk.main()
