#!/usr/bin/env python3
# "Change Icon..." from the right-click menu of a shortcut (.desktop file) or
# a folder: pick an icon with the desktop's icon chooser, then
#   shortcut: its Icon= line is rewritten,
#   folder:   its .directory file gets Icon= (what the file manager shows).
#   syluxium-change-icon FILE...
import os
import subprocess
import sys


def pick_icon():
    try:
        r = subprocess.run(["kdialog", "--title", "Change Icon", "--geticon", "Desktop", "Applications"],
                           capture_output=True, text=True)
    except FileNotFoundError:
        return None
    icon = r.stdout.strip()
    return icon if r.returncode == 0 and icon else None


def set_key(path, section, key, value):
    """Set key=value in an INI-style file, keeping everything else as it is."""
    lines = []
    if os.path.exists(path):
        with open(path, encoding="utf-8", errors="surrogateescape") as f:
            lines = f.read().splitlines()
    out, in_section, done, seen_section = [], False, False, False
    for line in lines:
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            if in_section and not done:
                out.append(f"{key}={value}")
                done = True
            in_section = s == f"[{section}]"
            seen_section |= in_section
        elif in_section and not done and s.split("=", 1)[0].strip() == key:
            out.append(f"{key}={value}")
            done = True
            continue
        out.append(line)
    if not done:
        if not seen_section:
            out.append(f"[{section}]")
        out.append(f"{key}={value}")
    tmp = path + ".tmp-icon"
    with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as f:
        f.write("\n".join(out) + "\n")
    os.replace(tmp, path)


def error(text):
    subprocess.run(["kdialog", "--title", "Change Icon", "--error", text], stderr=subprocess.DEVNULL)


def main():
    files = [f[7:] if f.startswith("file://") else f for f in sys.argv[1:]]
    if not files:
        print("usage: syluxium-change-icon FILE...", file=sys.stderr)
        return 2
    icon = pick_icon()
    if not icon:
        return 0
    for f in files:
        try:
            if os.path.isdir(f):
                set_key(os.path.join(f, ".directory"), "Desktop Entry", "Icon", icon)
            elif f.endswith(".desktop") or f.endswith(".kdelnk"):
                set_key(f, "Desktop Entry", "Icon", icon)
            else:
                error(f"{os.path.basename(f)}: only shortcuts and folders can get another icon.")
                continue
        except OSError as e:
            error(f"The icon of {os.path.basename(f)} could not be changed:\n{e.strerror}")
            return 1
    # Ask the desktop to look again (it watches its folder, but not icon themes).
    subprocess.run(["dcop", "kdesktop", "KDesktopIface", "refreshIcons"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


if __name__ == "__main__":
    sys.exit(main())
