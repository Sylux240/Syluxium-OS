#!/bin/sh
# The Syluxium desktop session: Xfce in the Dusk theme. Our defaults (theme,
# window frames, taskbar, desktop) live in /etc/xdg/syluxium and come before
# Xfce's own in XDG_CONFIG_DIRS; what the user changes is kept in
# ~/.config/xfce4 as usual. Trinity remains as "Syluxium Classic".
export XDG_CONFIG_DIRS=/etc/xdg/syluxium:/etc/xdg
export XDG_CURRENT_DESKTOP=XFCE XDG_SESSION_DESKTOP=syluxium DESKTOP_SESSION=syluxium
export XDG_MENU_PREFIX=xfce-
/usr/local/sbin/syluxium-diag mark "session: Syluxium (Xfce) starting for $USER"
# On the GPU Test entry: does a program get the GPU? (gpu-clients.txt)
(sleep 25; /usr/local/sbin/syluxium-diag gpu-clients) &
# Test rounds (logs stick): does the pre-installed AppImage start? (appimage.txt)
(sleep 45; /usr/local/sbin/syluxium-diag appimage) &
# First login: wallpaper per monitor, desktop launchers.
/usr/local/bin/syluxium-xfce-setup >/dev/null 2>&1 &
exec startxfce4
