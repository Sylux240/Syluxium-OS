#!/usr/bin/python3
"""Personalize (Syluxium shell): taskbar and menu transparency, glass blur,
accent colour and wallpaper. Writes ~/.config/syluxium-shell/settings.ini;
the panel and wallpaper follow at once, and blur is switched in the user's
Wayfire configuration (Wayfire reloads it by itself).

In the classic desktop (X11/TDE) the taskbar's transparency is set in
Control Panel > Panels > Appearance instead; this window says so."""
import glob
import os
import re
import sys

sys.path.insert(0, "/usr/local/lib/syluxium/python")
import syluxium_sys as S  # noqa: E402
from syluxium_sys import Gtk, GLib  # noqa: E402
from gi.repository import Gdk, GdkPixbuf  # noqa: E402

DIR = os.path.expanduser("~/.config/syluxium-shell")
SETTINGS = os.path.join(DIR, "settings.ini")
WAYFIRE = os.path.join(DIR, "wayfire.ini")
DEFAULTS = {"opacity": "0.78", "accent": "#6fe3f0", "blur": "true",
            "wallpaper": "/opt/trinity/share/wallpapers/syluxium-default.jpg"}
ACCENTS = [("Cyan", "#6fe3f0"), ("Lavender", "#b9a3e3"), ("Cloud pink", "#f29ab6"),
           ("Sun gold", "#f6c96b"), ("Mint", "#7ee0b0"), ("Sky", "#7fb2ff")]
WALLPAPER_DIRS = ["/opt/trinity/share/wallpapers", "/usr/share/syluxium/dusk", "/usr/share/backgrounds",
                  os.path.expanduser("~/Pictures")]


def read():
    values = dict(DEFAULTS)
    try:
        with open(SETTINGS) as f:
            for line in f:
                if "=" in line and not line.lstrip().startswith(("#", "[")):
                    k, v = line.split("=", 1)
                    values[k.strip()] = v.strip()
    except OSError:
        pass
    return values


def write(values):
    os.makedirs(DIR, exist_ok=True)
    tmp = SETTINGS + ".new"
    with open(tmp, "w") as f:
        f.write("# Syluxium shell: Personalize (syluxium-personalize)\n[shell]\n")
        for k in ("opacity", "accent", "blur", "wallpaper"):
            f.write(f"{k} = {values[k]}\n")
    os.replace(tmp, SETTINGS)


def set_blur(on):
    """Add or remove Wayfire's blur plugin in the user's configuration."""
    try:
        text = open(WAYFIRE).read()
    except OSError:
        return False
    m = re.search(r"^plugins = (.*)$", text, re.M)
    if not m:
        return False
    plugins = [p for p in m.group(1).split() if p != "blur"]
    if on:
        plugins.insert(1, "blur")
    text = text[:m.start(1)] + " ".join(plugins) + text[m.end(1):]
    with open(WAYFIRE + ".new", "w") as f:
        f.write(text)
    os.replace(WAYFIRE + ".new", WAYFIRE)
    return True


def software_rendering():
    try:
        return "simple-framebuffer" in open("/sys/class/drm/card0/device/uevent").read()
    except OSError:
        return False


class Personalize:
    def __init__(self):
        self.values = read()
        self.win = S.window("Personalize", 720, 600, "preferences-desktop-theme")
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, margin=22)
        self.win.add(outer)
        outer.pack_start(S.label("Personalize", bold=True, size="x-large"), False, False, 0)
        if os.environ.get("XDG_SESSION_TYPE") != "wayland":
            note = S.label("These settings are for the Syluxium shell (the \"new shell\" boot entry). In the "
                           "classic desktop, set the taskbar's transparency in Control Panel > Panels > "
                           "Appearance > Advanced options.", wrap=True)
            outer.pack_start(note, False, False, 0)

        # transparency
        outer.pack_start(S.label("Taskbar and menu transparency", bold=True), False, False, 0)
        row = Gtk.Box(spacing=12)
        row.pack_start(S.label("See-through"), False, False, 0)
        self.opacity = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 20, 100, 1)
        self.opacity.set_draw_value(True)
        self.opacity.set_value_pos(Gtk.PositionType.RIGHT)
        self.opacity.connect("format-value", lambda _s, v: f"{int(v)} %")
        self.opacity.set_value(float(self.values["opacity"]) * 100)
        self.opacity.set_hexpand(True)
        self.opacity.connect("value-changed", self.on_opacity)
        row.pack_start(self.opacity, True, True, 0)
        row.pack_start(S.label("Solid"), False, False, 0)
        outer.pack_start(row, False, False, 0)
        self.preview = Gtk.DrawingArea()
        self.preview.set_size_request(-1, 54)
        self.preview.connect("draw", self.draw_preview)
        outer.pack_start(self.preview, False, False, 0)

        # blur
        brow = Gtk.Box(spacing=12)
        self.blur = Gtk.Switch()
        self.blur.set_active(self.values["blur"] != "false")
        self.blur.connect("notify::active", self.on_blur)
        brow.pack_start(S.label("Frosted-glass blur behind the taskbar and menus", bold=True), False, False, 0)
        brow.pack_end(self.blur, False, False, 0)
        outer.pack_start(brow, False, False, 0)
        if software_rendering():
            hint = S.label("Blur needs a graphics driver; on this computer the screen is drawn in software, so "
                           "blur stays off.", wrap=True)
            hint.get_style_context().add_class("dim-label")
            outer.pack_start(hint, False, False, 0)
            self.blur.set_sensitive(False)

        # accent
        outer.pack_start(S.label("Accent colour", bold=True), False, False, 0)
        arow = Gtk.Box(spacing=10)
        group = None
        for name, hexv in ACCENTS:
            b = Gtk.RadioButton.new_from_widget(group)
            group = group or b
            b.set_mode(False)
            b.set_tooltip_text(name)
            sw = Gtk.DrawingArea()
            sw.set_size_request(34, 34)
            sw.connect("draw", self.draw_swatch, hexv)
            b.add(sw)
            if hexv == self.values["accent"]:
                b.set_active(True)
            b.connect("toggled", self.on_accent, hexv)
            arow.pack_start(b, False, False, 0)
        outer.pack_start(arow, False, False, 0)

        # wallpaper
        outer.pack_start(S.label("Wallpaper", bold=True), False, False, 0)
        flow = Gtk.FlowBox(max_children_per_line=5, selection_mode=Gtk.SelectionMode.SINGLE,
                           column_spacing=8, row_spacing=8)
        flow.connect("child-activated", self.on_wallpaper)
        self.thumbs = {}
        for path in self.wallpapers()[:40]:
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 120, 68, False)
            except GLib.Error:
                continue
            child = Gtk.FlowBoxChild()
            child.add(Gtk.Image.new_from_pixbuf(pb))
            child.set_tooltip_text(os.path.basename(path))
            child.path = path
            flow.add(child)
            if path == self.values["wallpaper"]:
                flow.select_child(child)
        sw = Gtk.ScrolledWindow(min_content_height=170)
        sw.add(flow)
        outer.pack_start(sw, True, True, 0)
        browse = Gtk.Button(label="Browse...")
        browse.connect("clicked", self.on_browse)
        brow2 = Gtk.Box()
        brow2.pack_end(browse, False, False, 0)
        outer.pack_start(brow2, False, False, 0)
        self.win.show_all()

    def wallpapers(self):
        found = []
        for d in WALLPAPER_DIRS:
            for ext in ("jpg", "jpeg", "png"):
                found += sorted(glob.glob(os.path.join(d, f"*.{ext}")))
        default = DEFAULTS["wallpaper"]
        return [default] + [p for p in found if p != default and "logo" not in os.path.basename(p)]

    def save(self):
        write(self.values)
        self.preview.queue_draw()

    def on_opacity(self, scale):
        self.values["opacity"] = f"{scale.get_value() / 100:.2f}"
        self.save()

    def on_blur(self, sw, _p):
        self.values["blur"] = "true" if sw.get_active() else "false"
        set_blur(sw.get_active())
        self.save()

    def on_accent(self, b, hexv):
        if b.get_active():
            self.values["accent"] = hexv
            self.save()

    def on_wallpaper(self, _flow, child):
        self.values["wallpaper"] = child.path
        self.save()

    def on_browse(self, *_):
        d = Gtk.FileChooserDialog(title="Choose a wallpaper", transient_for=self.win,
                                  action=Gtk.FileChooserAction.OPEN)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Set as wallpaper", Gtk.ResponseType.OK)
        f = Gtk.FileFilter()
        f.set_name("Pictures")
        for m in ("image/jpeg", "image/png"):
            f.add_mime_type(m)
        d.add_filter(f)
        if d.run() == Gtk.ResponseType.OK:
            self.values["wallpaper"] = d.get_filename()
            self.save()
        d.destroy()

    def draw_swatch(self, _w, cr, hexv):
        r, g, b = (int(hexv[i:i + 2], 16) / 255 for i in (1, 3, 5))
        cr.set_source_rgb(r, g, b)
        cr.arc(17, 17, 14, 0, 6.2832)
        cr.fill()
        return False

    def draw_preview(self, w, cr):
        """The taskbar over a slice of the wallpaper, at the chosen transparency."""
        width, height = w.get_allocated_width(), w.get_allocated_height()
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(self.values["wallpaper"], width, -1, True)
            Gdk.cairo_set_source_pixbuf(cr, pb, 0, height - pb.get_height())
            cr.paint()
        except GLib.Error:
            cr.set_source_rgb(0.3, 0.3, 0.5)
            cr.paint()
        cr.set_source_rgba(18 / 255, 23 / 255, 54 / 255, float(self.values["opacity"]))
        cr.rectangle(0, 0, width, height)
        cr.fill()
        a = self.values["accent"]
        r, g, b = (int(a[i:i + 2], 16) / 255 for i in (1, 3, 5))
        cr.set_source_rgba(r, g, b, 0.6)
        cr.rectangle(0, 0, width, 1)
        cr.fill()
        cr.set_source_rgba(r, g, b, 0.25)
        cr.rectangle(10, 6, 46, 42)
        cr.fill()
        return False


if __name__ == "__main__":
    Personalize()
    Gtk.main()
