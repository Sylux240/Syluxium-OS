#!/bin/sh
# Run a program as a Wayland program in the Xfce (X11) desktop:
#   syluxium-wayland-run PROGRAM [ARGUMENTS...]
# Its windows look and work like any other (Dusk frames, taskbar, Alt+Tab,
# clipboard): syluxium-wayland-host shows each Wayland window as an X11
# window. The host starts with the first such program and serves all of
# them in the session. Programs that can only use Wayland are started
# through this automatically from the start menu (syluxium-wayland-apps).
#   syluxium-wayland-run --start   only start the host (prints WAYLAND_DISPLAY)
# In the Wayland shell (a Wayland session already) the program just runs.
if [ "$1" = "--help" ] || [ $# = 0 ]; then
    sed -n '2,10s/^# \{0,1\}//p' "$0"
    exit 0
fi

toolkits_on_wayland() {
    export GDK_BACKEND=wayland QT_QPA_PLATFORM=wayland SDL_VIDEODRIVER=wayland SDL_VIDEO_DRIVER=wayland \
        MOZ_ENABLE_WAYLAND=1 CLUTTER_BACKEND=wayland ELECTRON_OZONE_PLATFORM_HINT=wayland \
        XDG_SESSION_TYPE=wayland
}

if [ "$XDG_SESSION_TYPE" = wayland ] && [ -n "$WAYLAND_DISPLAY" ] && [ "${WAYLAND_DISPLAY#syluxium-x11-}" = "$WAYLAND_DISPLAY" ]; then
    [ "$1" = --start ] && { echo "$WAYLAND_DISPLAY"; exit 0; }
    toolkits_on_wayland
    exec "$@"
fi
if [ -z "$DISPLAY" ]; then
    echo "syluxium-wayland-run: no desktop (DISPLAY is not set)" >&2
    exit 1
fi
if [ -z "$XDG_RUNTIME_DIR" ] || [ ! -w "$XDG_RUNTIME_DIR" ]; then
    XDG_RUNTIME_DIR=/run/user/$(id -u)
    [ -w "$XDG_RUNTIME_DIR" ] || { XDG_RUNTIME_DIR=/tmp/runtime-$(id -un); mkdir -p -m 700 "$XDG_RUNTIME_DIR"; }
    export XDG_RUNTIME_DIR
fi
d=${DISPLAY##*:}
NAME=syluxium-x11-${d%%.*}
SOCK=$XDG_RUNTIME_DIR/$NAME
LOG=$XDG_RUNTIME_DIR/syluxium-wayland-host.log
HOST=/usr/lib/syluxium/syluxium-wayland-host

# Running: its process is there and its socket is made (the last step of its start).
running() { [ -S "$SOCK" ] && pgrep -u "$(id -u)" -xf "$HOST $NAME" > /dev/null; }

if ! running; then
    # one starter at a time (two programs started together)
    LOCKDIR=$XDG_RUNTIME_DIR/syluxium-wayland-run.lock
    i=0
    until mkdir "$LOCKDIR" 2>/dev/null; do
        [ $i -ge 100 ] && { rmdir "$LOCKDIR" 2>/dev/null; i=0; continue; }   # left over (~5 s)
        sleep 0.05; i=$((i + 1))
    done
    if ! running; then
        rate=$(xset q 2>/dev/null | sed -n 's/.*auto repeat delay: *\([0-9]*\) *repeat rate: *\([0-9]*\).*/\2 \1/p')
        env -u WAYLAND_DISPLAY -u WAYLAND_SOCKET SYLUXIUM_KEY_REPEAT="$rate" \
            setsid "$HOST" "$NAME" >> "$LOG" 2>&1 < /dev/null &
        pid=$!
        i=0
        while [ $i -lt 100 ] && ! running; do
            kill -0 $pid 2>/dev/null || break
            sleep 0.05; i=$((i + 1))
        done
        if running; then
            /usr/local/sbin/syluxium-diag mark "wayland host started for $1 ($NAME)" 2>/dev/null
        fi
    fi
    rmdir "$LOCKDIR" 2>/dev/null
    if ! running; then
        /usr/local/sbin/syluxium-diag mark "wayland host FAILED to start for $1 (see $LOG)" 2>/dev/null
        echo "syluxium-wayland-run: the Wayland host did not start (log: $LOG)" >&2
        tail -5 "$LOG" >&2
        exit 1
    fi
fi
[ "$1" = --start ] && { echo "$NAME"; exit 0; }
export WAYLAND_DISPLAY=$NAME
unset WAYLAND_SOCKET
toolkits_on_wayland
exec "$@"
