        bottom.pack_start(row, False, False, 0)
        bottom.pack_start(exp, False, False, 0)
        outer.pack_start(bottom, False, False, 0)
        self.runner = Runner(self.admin, self.progress, self.status, self.details)
        row.pack_start(self.runner.stop_btn, False, False, 0)

        self.win.show_all()
        self.show_details(None)
        self.update_all.hide()
        self.stack.set_visible_child_name("loading")
        self.start_page, self.start_search = page, search
        self.reload()

    # ---- layout ----
