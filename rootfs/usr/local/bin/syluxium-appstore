        self.update_all = Gtk.Button(label="Install all updates")
        self.update_all.connect("clicked", lambda *_: self.install_updates())
        bar.pack_end(self.update_all, False, False, 0)
        top.pack_start(bar, False, False, 0)
        # icon, markup, size text, status, package name, size (sorting)
        self.rows = Gtk.ListStore(GdkPixbuf.Pixbuf, str, str, str, str, int)
