        self.view.set_enable_search(False)
        col = Gtk.TreeViewColumn("Program")
        ic, tx = Gtk.CellRendererPixbuf(xpad=4, ypad=2), Gtk.CellRendererText(ellipsize=Pango.EllipsizeMode.END)
        col.pack_start(ic, False), col.pack_start(tx, True)
        col.add_attribute(ic, "pixbuf", 0), col.add_attribute(tx, "markup", 1)
        col.set_expand(True), col.set_sort_column_id(4)
        self.view.append_column(col)
        c = Gtk.TreeViewColumn("Size", Gtk.CellRendererText(xalign=1.0), text=2)
        c.set_sort_column_id(5)
        self.view.append_column(c)
        c = Gtk.TreeViewColumn("Status", Gtk.CellRendererText(), text=3)
        c.set_sort_column_id(3)
        self.view.append_column(c)
        self.view.get_selection().connect("changed", self.on_row)
        sw = Gtk.ScrolledWindow(shadow_type=Gtk.ShadowType.IN)
        sw.add(self.view)
        top.pack_start(sw, True, True, 0)
        paned.pack1(top, True, False)
        paned.pack2(self.details_pane(), False, False)
        paned.set_position(300)
