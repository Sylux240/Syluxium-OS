def optional_packages():
    """The optional programs as catalog entries."""
    out = {}
    for pkg, name, summary, version, size, _sha in OPTIONAL:
        p = Package(pkg)
        p.version, p.section, p.size = version, OPTIONAL_SECTION, size // 1024
        p.summary, p.homepage = summary, f"{OPTIONAL_REPO}/{pkg}"
        out[pkg] = p
    return out


def optional_release(pkg):
    """(version, .deb URL, download bytes, sha256) of the newest release, from
    GitHub; the release named in OPTIONAL when GitHub doesn't answer."""
    import json
    import urllib.request
    _pkg, _name, _summary, version, size, sha = OPTIONAL_BY[pkg]
    fallback = (version, f"{OPTIONAL_REPO}/{pkg}/releases/download/v{version}/{pkg}-{version}-linux-x86_64.deb",
                size, sha)
    try:
        req = urllib.request.Request(f"https://api.github.com/repos/storytold/{pkg}/releases/latest",
                                     headers={"User-Agent": "Syluxium-App-Store", "Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=15) as r:
            rel = json.load(r)
        for a in rel.get("assets", []):
            if a["name"].endswith("-linux-x86_64.deb") and str(a.get("digest", "")).startswith("sha256:"):
                return rel["tag_name"].lstrip("v"), a["browser_download_url"], a["size"], a["digest"][7:]
    except Exception:  # noqa: BLE001 - offline, rate-limited, changed format: the pinned release
        pass
    return fallback


def download(url, dest, size, sha, progress):
    """Download url to dest checking its SHA-256; progress(fraction) from this
    thread. Returns None or an error text."""
    import hashlib
    import urllib.request
    h = hashlib.sha256()
    got = 0
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Syluxium-App-Store"})
        with urllib.request.urlopen(req, timeout=60) as r, open(dest + ".part", "wb") as f:
            while True:
                chunk = r.read(256 * 1024)
                if not chunk:
                    break
                f.write(chunk)
                h.update(chunk)
                got += len(chunk)
                progress(min(got / size, 1.0) if size else 0)
    except Exception as e:  # noqa: BLE001
        return f"The download failed: {e}"
    if h.hexdigest() != sha:
        os.remove(dest + ".part")
        return "The downloaded file is not the one that was published (checksum mismatch), so it was not installed."
    os.replace(dest + ".part", dest)
    return None

# Packages Syluxium is built from: removing them breaks the desktop.
PROTECTED = re.compile(r"^(tdebase-|twin|kicker|kdesktop|konqueror|kcontrol|ksmserver|tdm-|tdelibs|xserver-|xorg|"
                       r"libc6$|libc-bin|dpkg$|apt$|bash$|busybox|python3(\.\d+)?$|python3-gi|sudo$|login$|dbus|"
                       r"base-files|coreutils|libgtk-3|gir1\.2-gtk|mesa|libgl1)")


def debrand(text):
    """The desktop's own name doesn't show (Syluxium's desktop is built from it)."""
    text = text.replace("Trinity Desktop Environment", "Syluxium desktop").replace("non-TDE", "other")
    text = re.sub(r"(?<=\w)-trinity\b", "", text)
    text = re.sub(r"https?://\S*trinitydesktop\.org\S*", "the Syluxium desktop repository", text)
    text = re.sub(r"\b[Tt]rinity\b", "Syluxium", text)
    return re.sub(r"(?<![\w-])TDE(?![\w-])", "Syluxium", text)


def display_name(pkg):
    if pkg in NAMES:
        return NAMES[pkg]
    name = pkg[:-8] if pkg.endswith("-trinity") else pkg
    return name[:1].upper() + name[1:]


def net_bytes():
    """{interface: (received, sent)} from /proc/net/dev, without the loopback."""
    out = {}
    for line in read("/proc/net/dev").splitlines()[2:]:
        name, _, rest = line.partition(":")
        v = rest.split()
        if len(v) >= 9 and name.strip() != "lo":
            out[name.strip()] = (int(v[0]), int(v[8]))
    return out


def human_kb(k):
    return human(k * 1024) if k else ""


# ---- the catalog: apt's package lists and dpkg's database ----
class Package:
    __slots__ = ("name", "version", "section", "size", "summary", "homepage", "installed", "candidate_newer")

    def __init__(self, name):
        self.name, self.version, self.section, self.size = name, "", "", 0
        self.summary, self.homepage, self.installed, self.candidate_newer = "", "", "", False


def version_newer(a, b):
    """dpkg's comparison: is version a newer than b?"""
    try:
        return subprocess.run(["dpkg", "--compare-versions", a, "gt", b]).returncode == 0
    except OSError:
        return False


def installed_packages():
    out, name, ok, ver = {}, None, False, ""
    try:
        text = open(DPKG_STATUS, errors="replace").read()
    except OSError:
        return out
    for stanza in text.split("\n\n"):
        name = ver = None
        ok = False
        for line in stanza.split("\n"):
            if line.startswith("Package: "):
                name = line[9:].strip()
            elif line.startswith("Status: "):
                ok = line.endswith(" installed")
            elif line.startswith("Version: "):
                ver = line[9:].strip()
        if name and ok:
            out[name] = ver or ""
    return out


def load_catalog():
    pkgs = {}
    files = [f for f in glob.glob(f"{LISTS}/*_Packages") if "binary-i386" not in f]
    for path in files:
        try:
            text = open(path, errors="replace").read()
        except OSError:
            continue
        for stanza in text.split("\n\n"):
            if not stanza.startswith("Package: "):
                stanza = stanza.lstrip("\n")
                if not stanza.startswith("Package: "):
                    continue
            p = None
            fields = {}
            for line in stanza.split("\n"):
                if not line or line[0] == " ":
                    continue
                k, _, v = line.partition(": ")
                if k in ("Package", "Version", "Section", "Installed-Size", "Description", "Homepage", "Architecture"):
                    fields[k] = v
            if fields.get("Architecture") not in (None, "amd64", "all"):
                continue
            name = fields.get("Package")
            if not name:
                continue
            p = pkgs.get(name)
            if p and p.version and not version_newer_fast(fields.get("Version", ""), p.version):
                continue
            p = p or Package(name)
            p.version = fields.get("Version", "")
            p.section = fields.get("Section", "misc").split("/")[-1]
            try:
                p.size = int(fields.get("Installed-Size", "0"))
            except ValueError:
                p.size = 0
            p.summary = debrand(fields.get("Description", ""))
            p.homepage = fields.get("Homepage", "")
            pkgs[name] = p
    return pkgs


def version_newer_fast(a, b):
    # Two repositories rarely carry the same package; when they do, ask dpkg.
    return a != b and version_newer(a, b)


def upgradable():
    """{package: (installed version, new version)}; held packages never update."""
    up, held = {}, set()
    try:
        held = set(subprocess.run(["apt-mark", "showhold"], capture_output=True, text=True, env=ENV).stdout.split())
        out = subprocess.run(["apt", "list", "--upgradable"], capture_output=True, text=True, env=ENV).stdout
    except OSError:
        return up
    for line in out.splitlines():
        m = re.match(r"([^/]+)/\S+ (\S+) \S+ \[upgradable from: (\S+)\]", line)
        if m and m.group(1) not in held:
            up[m.group(1)] = (m.group(3), m.group(2))
    return up


def long_description(pkg):
    out = subprocess.run(["apt-cache", "show", "--no-all-versions", pkg], capture_output=True, text=True,
                         env=ENV).stdout
    desc, info, inside = [], {}, False
    for line in out.split("\n"):
        if line.startswith(("Description:", "Description-en:")):
            inside = True
            continue
        if inside and line.startswith(" "):
            desc.append("" if line.strip() == "." else line[1:])
            continue
        inside = False
        k, _, v = line.partition(": ")
        if k in ("Maintainer", "Depends", "Download-Size") and v:
            info[k] = v
    return debrand("\n".join(desc)).strip(), info


# ---- doing things as root: sudo with the user's own password ----
class Admin:
    def __init__(self, parent):
        self.parent = parent
        self.password = None

    def ready(self):
        """On the main thread, before an operation: can we run commands as root?"""
        if os.geteuid() == 0 or self.password is not None:
            return True
        if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0:
            self.password = ""
            self.nopass = True
            return True
        user = os.environ.get("USER") or os.environ.get("LOGNAME") or "you"
        for attempt in range(3):
            d = Gtk.Dialog(title="Administrator Permission", transient_for=self.parent, modal=True)
            d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
            d.set_default_response(Gtk.ResponseType.OK)
            box = d.get_content_area()
            box.set_spacing(8)
            for m in ("set_margin_start", "set_margin_end", "set_margin_top"):
                getattr(box, m)(12)
            row = Gtk.Box(spacing=12)
            row.pack_start(Gtk.Image.new_from_icon_name("dialog-password", Gtk.IconSize.DIALOG), False, False, 0)
            row.pack_start(label("Installing and removing software changes the computer for everyone.\n"
                                 f"Type the password of {user} (an administrator) to continue."
                                 + ("\n\nThat password was not right. Try again." if attempt else ""),
                                 wrap=True), True, True, 0)
            box.add(row)
            entry = Gtk.Entry(visibility=False, activates_default=True)
            box.add(entry)
            d.show_all()
            r = d.run()
            pw = entry.get_text()
            d.destroy()
            if r != Gtk.ResponseType.OK:
                return False
            p = subprocess.run(["sudo", "-S", "-k", "-p", "", "true"], input=pw + "\n", capture_output=True,
                               text=True)
            if p.returncode == 0:
                self.password = pw
                return True
            if "not in the sudoers" in p.stderr or "may not run sudo" in p.stderr:
                message(self.parent, "Only administrators can install software.",
                        f"{user} is not an administrator. Ask an administrator to install it, or change the "
                        "account type in User Accounts.", Gtk.MessageType.WARNING)
                return False
        return False

    def popen(self, cmd):
        if os.geteuid() == 0:
            return subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=ENV,
                                    stdin=subprocess.DEVNULL)
        full = ["sudo", "-S", "-p", "", "env", "DEBIAN_FRONTEND=noninteractive", "LC_ALL=C.UTF-8"] + cmd
        p = subprocess.Popen(full, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.PIPE,
                             text=True, env=ENV)
        try:
            p.stdin.write((self.password or "") + "\n")
            p.stdin.close()
        except OSError:
            pass
        return p


def confirm_plan(parent, name, pkg, res, catalog=None):
    """Show what installing takes (the other packages, the download) and ask."""
    extra = [p for p in res["install"] if p != pkg]
    removed = res["remove"]
    d = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=Gtk.MessageType.QUESTION,
                          text=f"Install {name}?")
    lines = []
    if extra:
        names = ", ".join(display_name(p) for p in extra[:25]) + (f" and {len(extra) - 25} more" if len(extra) > 25 else "")
        lines.append(f"It needs {len(extra)} more package{'s' if len(extra) != 1 else ''}, which will be "
                     f"installed too:\n{names}")
    if res["upgrade"]:
        lines.append(f"{len(res['upgrade'])} installed package{'s' if len(res['upgrade']) != 1 else ''} will be "
                     "updated.")
    if removed:
        lines.append("These will be removed: " + ", ".join(display_name(p) for p in removed[:15]))
    lines.append(f"Download: {human(res['download']) if res['download'] else 'nothing'}")
    if catalog:
        disk = sum(catalog[p].size for p in res["install"] if p in catalog)
        if disk:
            lines.append(f"Space needed: {human_kb(disk)}")
    d.format_secondary_text("\n\n".join(lines))
    d.add_button("_Cancel", Gtk.ResponseType.CANCEL)
    d.add_button("_Install", Gtk.ResponseType.OK)
    d.set_default_response(Gtk.ResponseType.OK)
    r = d.run()
    d.destroy()
    return r == Gtk.ResponseType.OK


# ---- running apt with a progress bar ----
class Runner:
    """apt as a child process read from the GTK main loop (no worker thread):
    progress, status and the log on the window."""

    def __init__(self, admin, progress, status, details):
        self.admin, self.progress, self.status, self.details = admin, progress, status, details
        self.busy = False
        self.downloading = False
        self.stopped = False
        # Stopping is offered only while downloading: nothing on the computer
        # has changed yet then (stopping dpkg halfway would break packages).
        self.stop_btn = Gtk.Button.new_with_mnemonic("_Stop")
        self.stop_btn.set_no_show_all(True)
        self.stop_btn.connect("clicked", lambda *_: self.stop())
        GLib.timeout_add_seconds(5, self._watch)

    def _watch(self):
        # Stalled: hardly a byte received for a minute (apt itself goes on
        # trying file after file for a long time when the connection is gone).
        rx = sum(r for r, _t in net_bytes().values())
        now = time.monotonic()
        if not (self.busy and self.downloading) or rx - getattr(self, "watch_rx", 0) > 16384:
            self.watch_rx, self.watch_time = rx, now
        elif now - self.watch_time > STALL_SECONDS and not self.stopped:
            self.status.set_text("The download has not moved for a minute. Is the computer still connected "
                                 "to the Internet? You can stop it and try again later.")
        return True

    def stop(self):
        if not (self.busy and self.downloading):
            return
        self.stopped = True
        self.stop_btn.set_sensitive(False)
        self.status.set_text("Stopping the download...")
        try:
            # apt-get and the download helpers it started.
            k = self.admin.popen(["sh", "-c", "pkill -TERM -x apt-get; pkill -TERM -f /usr/lib/apt/methods/"])
            GLib.child_watch_add(GLib.PRIORITY_DEFAULT, k.pid, lambda *_: None)
        except OSError:
            pass

    def log(self, text):
        # Also kept in a file, for when something goes wrong.
        try:
            with open(LOGFILE, "a") as f:
                f.write(text)
        except OSError:
            pass
        buf = self.details.get_buffer()
        buf.insert(buf.get_end_iter(), debrand(text))
        self.details.scroll_to_mark(buf.get_insert(), 0, False, 0, 0)
        buf.place_cursor(buf.get_end_iter())

    def start(self, cmd, what, done, recover=False, new=()):
        """Run cmd as root; done(ok, output) afterwards.
        recover: if it fails, finish what dpkg left half done (dpkg --configure -a,
        apt-get -f install) so no package stays half installed; packages in `new`
        (not installed before) that still can't be set up are taken off again.
        The output then ends with "RECOVERY: ok", "RECOVERY: rolled back" or
        "RECOVERY: failed"."""
        if self.busy or not self.admin.ready():
            return False
        self.busy = True
        self.stopped = False
        self.progress.set_fraction(0)
        self.progress.set_text(what)
        self.status.set_text(what)
        self._drive(self._steps(cmd, done, recover, set(new)))
        return True

    # The steps run as a generator: each `yield cmd` runs a command and
    # resumes with (exit code, output) when it has finished.
    def _drive(self, gen, result=None):
        try:
            cmd = gen.send(result)
        except StopIteration:
            return
        self._exec(cmd, lambda rc, out: self._drive(gen, (rc, out)))

    def _steps(self, cmd, done, recover, new):
        rc, out = yield cmd
        if rc != 0 and self.stopped:
            out += "STOPPED\n"
        if rc != 0 and recover:
            self.status.set_text("That did not work. Making sure nothing is left half installed...")
            self.progress.set_text("Repairing...")
            r1, o1 = yield ["dpkg", "--configure", "-a"]
            r2, o2 = yield ["apt-get"] + APT_OPTS + ["-f", "install"]
            broken = audit_names((yield ["dpkg", "--audit"])[1])
            fine = r1 == 0 and r2 == 0 and not broken
            result = "ok" if fine else "failed"
            gone = [b for b in broken if b.split(":")[0] in new]
            if not fine and gone:
                # New software whose setup keeps failing: take it off again.
                yield ["dpkg", "--remove", "--force-remove-reinstreq"] + gone
                yield ["apt-get"] + APT_OPTS + ["-f", "install"]
                if not audit_names((yield ["dpkg", "--audit"])[1]):
                    result = "rolled back"
            out += o1 + o2 + f"RECOVERY: {result}\n"
            self.log({"ok": "Repair finished: every package is fully installed.\n",
                      "rolled back": "The new software could not be set up and was removed again; "
                                     "everything else is as it was.\n",
                      "failed": "Repair did not finish: some packages are still broken.\n"}[result])
        self._finish(done, rc == 0, out)

    def _exec(self, cmd, then):
        self.log("$ " + " ".join(cmd) + "\n")
        try:
            p = self.admin.popen(cmd)
        except OSError as e:
            self.log(f"{e}\n")
            GLib.idle_add(lambda: then(1, str(e)) and False)
            return
        fd = p.stdout.fileno()
        os.set_blocking(fd, False)
        state = {"lines": [], "partial": b"", "pulsing": True, "eof": False, "status": None, "done": False}

        def feed(chunk):
            data = state["partial"] + chunk
            *complete, state["partial"] = data.split(b"\n")
            for raw in complete:
                self._line(raw.decode("utf-8", "replace") + "\n", state)

        def drain():
            while not state["eof"]:
                try:
                    chunk = os.read(fd, 65536)
                except BlockingIOError:
                    return
                except OSError:
                    chunk = b""
                if not chunk:
                    state["eof"] = True
                else:
                    feed(chunk)

        def finish():
            # Done when the command has exited -- even if a helper it left
            # behind (an apt download method) still holds the pipe open.
            if state["done"] or state["status"] is None:
                return
            state["done"] = True
            drain()
            if state["partial"]:
                self._line(state["partial"].decode("utf-8", "replace") + "\n", state)
            GLib.source_remove(state["watch"]) if not state["eof"] else None
            p.stdout.close()
            then(p.returncode, "".join(state["lines"]))

        def on_data(_fd, _cond):
            drain()
            if state["eof"]:
                finish()
                return False
            return True

        def exited(_pid, status):
            # GLib reaped the child: the exit code comes from its status.
            p.returncode = os.waitstatus_to_exitcode(status)
            state["status"] = status
            finish()
        state["watch"] = GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT, GLib.IOCondition.IN | GLib.IOCondition.HUP |
                                           GLib.IOCondition.ERR, on_data)
        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, p.pid, exited)

    def _line(self, line, state):
        state["lines"].append(line)
        # APT::Status-Fd lines: dlstatus:<n>:<percent>:<text>, pmstatus:<pkg>:<percent>:<text>
        m = re.match(r"(dl|pm)status:[^:]*:([\d.]+):(.*)", line)
        if m:
            state["pulsing"] = False
            if self.downloading != (m.group(1) == "dl"):
                self.downloading = m.group(1) == "dl"
                self.stop_btn.set_visible(self.downloading)
            pct = float(m.group(2)) / 100
            frac = pct * 0.4 if m.group(1) == "dl" else 0.4 + pct * 0.6
            self.progress.set_fraction(frac)
            self.progress.set_text(f"{debrand(m.group(3).strip())} ({frac * 100:.0f}%)")
            return
        if line.startswith(("pmconffile", "dlstatus", "pmerror", "media-change")):
            return
        self.log(line)
        if state["pulsing"]:
            self.progress.pulse()

    def _finish(self, done, ok, out):
        self.busy = False
        self.downloading = False
        self.stop_btn.hide()
        self.stop_btn.set_sensitive(True)
        self.progress.set_fraction(1.0 if ok else 0.0)
        self.progress.set_text("Done" if ok else "Failed")
        done(ok, out)


def audit_names(out):
    """The packages `dpkg --audit` lists as not fully installed."""
    return [m.group(1) for m in re.finditer(r"(?m)^ (\S+)\s", out)]


# ---- what apt would do: simulated first, so the user sees it ----
def plan(args):
    """apt's plan for "apt-get <args>", without changing anything:
    {ok, install: [new packages], upgrade: [...], remove: [...], download: bytes, problems: [lines]}"""
    p = subprocess.run(["apt-get", "-s", "-o", "Debug::NoLocking=1"] + args, capture_output=True, text=True,
                       env=ENV)
    res = {"ok": p.returncode == 0, "install": [], "upgrade": [], "remove": [], "download": 0, "problems": []}
    unmet = False
    for line in (p.stdout + p.stderr).splitlines():
        if line.startswith("Inst "):
            f = line.split()
            (res["upgrade"] if len(f) > 2 and f[2].startswith("[") else res["install"]).append(f[1])
        elif line.startswith("Remv "):
            res["remove"].append(line.split()[1])
        elif "unmet dependencies" in line:
            unmet = True
        elif unmet and line.startswith(" "):
            res["problems"].append(debrand(line.strip()))
        elif line.startswith("E: "):
            res["problems"].append(debrand(line[3:].strip()))
    if res["ok"]:
        uris = subprocess.run(["apt-get", "--print-uris", "-qq", "-o", "Debug::NoLocking=1"] + args,
                              capture_output=True, text=True, env=ENV).stdout
        for line in uris.splitlines():
            f = line.split()
            if len(f) >= 3 and f[2].isdigit():
                res["download"] += int(f[2])
    return res


def plan_problem_text(res):
    probs = res["problems"]
    if any("held broken" in p or "Depends:" in p or "PreDepends:" in p for p in probs):
        lines = [p for p in probs if "Depends" in p or "Conflicts" in p or "Breaks" in p][:6]
        return ("It needs other software that cannot be installed on Syluxium (or that conflicts with "
                "installed software), so nothing was changed.\n\n" + "\n".join(lines))
    return error_text("\n".join("E: " + p for p in probs))


def repair_note(out):
    if "RECOVERY: ok" in out:
        return "\n\nSyluxium cleaned up afterwards: no package was left half installed."
    if "RECOVERY: rolled back" in out:
        return ("\n\nIt could not be set up, so Syluxium removed it again: the computer is as it was "
                "before.")
    if "RECOVERY: failed" in out:
        return ("\n\nSome packages are still not fully installed. Click \u201cRepair\u201d in the App Store, or "
                "use Syluxium Update, when you are connected to the Internet.")
    return ""


def error_text(out):
    if "STOPPED" in out:
        return "The download was stopped. Nothing on the computer was changed."
    errs = [debrand(l[3:].strip()) for l in out.splitlines() if l.startswith("E: ")]
    if any("Could not get lock" in e or "Unable to acquire" in e for e in errs):
        return "Another program is installing software right now. Try again when it has finished."
    if any("Failed to fetch" in e or "Temporary failure resolving" in e for e in errs) or \
            "Temporary failure resolving" in out:
        return "The software could not be downloaded. Are you connected to the Internet?"
    if any("Unable to locate package" in e for e in errs):
        return "That software is not in the catalog. Refresh the catalog and try again."
    return errs[-1] if errs else "See Details for what went wrong."


def log_area():
    progress = Gtk.ProgressBar(show_text=True)
    details = Gtk.TextView(editable=False, monospace=True, cursor_visible=False)
    details.set_wrap_mode(Gtk.WrapMode.CHAR)
    exp = Gtk.Expander(label="Details")
    sw = Gtk.ScrolledWindow(shadow_type=Gtk.ShadowType.IN)
    sw.set_size_request(-1, 130)
    sw.add(details)
    exp.add(sw)
    return progress, details, exp


# ---- icons: the desktop's icon theme (crystal), then GTK's ----
class Icons:
    def __init__(self):
        self.theme = Gtk.IconTheme()
        self.theme.set_search_path(["/opt/trinity/share/icons", "/usr/share/icons", "/usr/share/pixmaps"])
        self.theme.set_custom_theme("crystalsvg")
        self.fallback = Gtk.IconTheme.get_default()
        self.cache = {}

    def get(self, names, size):
        key = (tuple(names), size)
        if key in self.cache:
            return self.cache[key]
        pix = None
        for theme in (self.theme, self.fallback):
            for n in names:
                if n and theme.has_icon(n):
                    try:
                        pix = theme.load_icon(n, size, Gtk.IconLookupFlags.FORCE_SIZE)
                        break
                    except GLib.Error:
                        pass
            if pix:
                break
        self.cache[key] = pix
        return pix

    def for_package(self, pkg, section_icon, size=32):
        base = pkg[:-8] if pkg.endswith("-trinity") else pkg
        return self.get([ICONS.get(pkg), base, pkg, section_icon, "package"], size)


def category_of(section):
    for title, icon, sections in CATEGORIES:
        if section in sections:
            return title, icon
    return None, "package"


