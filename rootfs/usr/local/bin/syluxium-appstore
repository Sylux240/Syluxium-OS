        names = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.d_name = label("", bold=True, size="large")
        self.d_info = label("", xalign=0)
        self.d_info.set_selectable(True)
        names.pack_start(self.d_name, False, False, 0)
        names.pack_start(self.d_info, False, False, 0)
        head.pack_start(names, True, True, 0)
        self.d_remove = Gtk.Button.new_with_mnemonic("_Remove")
        self.d_install = Gtk.Button.new_with_mnemonic("_Install")
        self.d_remove.connect("clicked", lambda *_: self.remove(self.current))
        self.d_install.connect("clicked", lambda *_: self.install(self.current))
        for b in (self.d_install, self.d_remove):
            b.set_valign(Gtk.Align.CENTER)
            head.pack_end(b, False, False, 0)
        box.pack_start(head, False, False, 0)
        self.d_text = Gtk.TextView(editable=False, cursor_visible=False, wrap_mode=Gtk.WrapMode.WORD)
        self.d_text.set_left_margin(6), self.d_text.set_right_margin(6)
        sw = Gtk.ScrolledWindow(shadow_type=Gtk.ShadowType.IN)
        sw.set_size_request(-1, 150)
        sw.add(self.d_text)
        box.pack_start(sw, True, True, 0)
        self.show_details(None)
        return box

    # ---- loading ----
    def reload(self, then=None):
        def work():
            pkgs, inst = load_catalog(), installed_packages()
            up = upgradable() if pkgs else {}
            try:
                audit = subprocess.run(["dpkg", "--audit"], capture_output=True, text=True, env=ENV).stdout.strip()
            except OSError:
                audit = ""
            GLib.idle_add(lambda: (self.loaded(pkgs, inst, up, then), self.check_audit(audit)) and False)
        threading.Thread(target=work, daemon=True).start()

    def loaded(self, pkgs, inst, up, then):
        if pkgs:
            pkgs.update(optional_packages())
        self.pkgs, self.installed, self.upgradable = pkgs, inst, up
        self.show_update_count()
        self.build_featured()
        if not pkgs:
            self.stack.set_visible_child_name("empty")
            self.empty_button.grab_focus()
            self.status.set_text("The catalog has not been downloaded yet.")
            return
        self.status.set_text(f"{len(pkgs):,} programs and packages in the catalog, {len(inst):,} installed.")
        if then:
            then()
        elif self.start_search:
            self.search.set_text(self.start_search)
            self.do_search()
            self.start_search = None
        elif self.start_page:
            self.select_side(self.start_page)
            self.start_page = None
        elif self.side_view.get_selection().count_selected_rows() == 0:
            self.select_side("featured")
        else:
            self.on_side(self.side_view.get_selection())

    def check_audit(self, audit):
        # An installation that was cut off (power, connection): offer to finish it.
        if not audit or self.runner.busy or getattr(self, "audit_asked", False):
            return
        self.audit_asked = True
        if message(self.win, "Some software was not completely installed.",
                   "An earlier installation was interrupted. Finish it now? (This may need the Internet.)",
                   Gtk.MessageType.WARNING, Gtk.ButtonsType.YES_NO) == Gtk.ResponseType.YES:
            self.repair()

    def show_update_count(self):
        it = self.side.get_iter_first()
        while it:
            if self.side[it][2] == "updates":
                n = len(self.upgradable)
                self.side[it][1] = f"<b>Updates ({n})</b>" if n else "Updates"
            it = self.side.iter_next(it)

    def select_side(self, key):
        for r in self.side:
            if r[2] == key:
                self.side_view.get_selection().select_iter(r.iter)
                self.on_side(self.side_view.get_selection())
                return

    # ---- pages ----
    def on_side(self, sel):
        model, it = sel.get_selected()
        if not it or not self.pkgs:
            return
        key = model[it][2]
        if key == "featured":
            self.stack.set_visible_child_name("featured")
            return
        if key == "installed":
            names = [n for n in self.installed if n in self.pkgs]
            self.fill("Installed programs", [n for n in names if self.pkgs[n].section not in TECHNICAL])
        elif key == "updates":
            self.fill("Updates" if self.upgradable else "Syluxium is up to date", sorted(self.upgradable),
                      updates=True)
        else:
            title = key[4:]
            sections = next(s for t, _, s in CATEGORIES if t == title)
            self.fill(title, [n for n, p in self.pkgs.items() if p.section in sections])

    def do_search(self):
        q = self.search.get_text().strip().lower()
        if not q or not self.pkgs:
            return
        words = q.split()
        hits = []
        for n, p in self.pkgs.items():
            hay = (n + " " + display_name(n) + " " + p.summary).lower()
            if all(w in hay for w in words):
                # Best first: the name itself, then programs, then libraries & co.
                score = (0 if q in (n, display_name(n).lower()) else 1 if n.startswith(words[0]) else 2,
                         1 if p.section in TECHNICAL else 0, n)
                hits.append((score, n))
        hits.sort()
        self.side_view.get_selection().unselect_all()
        self.fill(f"Search results for “{q}” ({len(hits)})", [n for _, n in hits[:2000]], keep_order=True)

    def fill(self, title, names, updates=False, keep_order=False):
        self.list_title.set_text(title)
        self.update_all.set_visible(updates and bool(self.upgradable))
        self.rows.set_sort_column_id(Gtk.TREE_SORTABLE_UNSORTED_SORT_COLUMN_ID, Gtk.SortType.ASCENDING)
        self.view.set_model(None)
        self.rows.clear()
        if not keep_order:
            names = sorted(names, key=lambda n: display_name(n).lower())
        for n in names:
            p = self.pkgs.get(n)
            if not p:
                continue
            _cat, icon = category_of(p.section)
            summary = GLib.markup_escape_text(p.summary)
            name = GLib.markup_escape_text(display_name(n))
            if updates and n in self.upgradable:
                old, new = self.upgradable[n]
                status = "Update available"
                summary = GLib.markup_escape_text(f"{debrand(old)} → {debrand(new)}")
            else:
                status = "Installed" if n in self.installed else ""
                if n in self.installed and n in self.upgradable:
                    status = "Update available"
            self.rows.append([self.icons.for_package(n, icon), f"<b>{name}</b>\n<small>{summary}</small>",
                              human_kb(p.size), status, n, p.size])
        self.view.set_model(self.rows)
        self.stack.set_visible_child_name("list")
        if len(self.rows):
            self.view.get_selection().select_path(Gtk.TreePath(0))
        else:
            self.show_details(None)

    def build_featured(self):
        for c in self.featured_box.get_children():
            self.featured_box.remove(c)
        self.featured_box.pack_start(label("Featured programs", bold=True, size="large"), False, False, 0)
        self.featured_box.pack_start(label("Popular free programs, picked for Syluxium. Click one to read "
                                           "about it and install it.", wrap=True), False, False, 4)
        for group, items in FEATURED:
            items = [i for i in items if i[0] in self.pkgs]
            if not items:
                continue
            g = label(group, bold=True)
            g.get_style_context().add_class("store-group")
            self.featured_box.pack_start(g, False, False, 6)
            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, max_children_per_line=4,
                               column_spacing=8, row_spacing=8)
            for pkg, name, _icon in items:
                flow.add(self.tile(pkg, name))
            self.featured_box.pack_start(flow, False, False, 0)
        self.featured_box.show_all()

    def tile(self, pkg, name):
        p = self.pkgs[pkg]
        b = Gtk.Button()
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.get_style_context().add_class("store-tile")
        box = Gtk.Box(spacing=8, margin=6)
        box.pack_start(Gtk.Image.new_from_pixbuf(self.icons.for_package(pkg, category_of(p.section)[1], 48)),
                       False, False, 0)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        texts.pack_start(label(name, bold=True), False, False, 0)
        s = label(p.summary, wrap=True)
        s.set_max_width_chars(24)
        s.set_lines(2)
        s.set_ellipsize(Pango.EllipsizeMode.END)
        texts.pack_start(s, False, False, 0)
        texts.pack_start(label("Installed" if pkg in self.installed else human_kb(p.size)), False, False, 0)
        box.pack_start(texts, True, True, 0)
        b.add(box)
        b.set_size_request(190, -1)
        b.connect("clicked", lambda *_: self.open_package(pkg))
        return b

    def open_package(self, pkg):
        self.side_view.get_selection().unselect_all()
        self.fill(display_name(pkg), [pkg])

    # ---- details ----
    def on_row(self, sel):
        model, it = sel.get_selected()
        self.show_details(model[it][4] if it else None)

    def show_details(self, pkg):
        self.current = pkg
        p = self.pkgs.get(pkg) if pkg else None
        if not p:
            self.d_name.set_text("")
            self.d_info.set_text("")
            self.d_icon.clear()
            self.d_text.get_buffer().set_text("")
            self.d_install.hide(), self.d_remove.hide()
            return
        self.d_icon.set_from_pixbuf(self.icons.for_package(pkg, category_of(p.section)[1], 48))
        self.d_name.set_text(display_name(pkg))
        inst = self.installed.get(pkg)
        info = f"Version {debrand(p.version)}"
        if inst and inst != p.version:
            info += f" (installed: {debrand(inst)})"
        if p.size:
            info += f"   •   {human_kb(p.size)} on disk"
        cat, _ = category_of(p.section)
        if cat:
            info += f"   •   {cat}"
        self.d_info.set_text(info)
        newer = pkg in self.upgradable or (pkg in OPTIONAL_BY and inst and version_newer_fast(p.version, inst))
        self.d_install.set_label("_Update" if inst and newer else "_Install")
        self.d_install.set_visible(not inst or newer)
        self.d_remove.set_visible(bool(inst))
        self.d_install.set_sensitive(not self.runner.busy)
        self.d_remove.set_sensitive(not self.runner.busy and not PROTECTED.match(pkg))
        buf = self.d_text.get_buffer()
        buf.set_text(p.summary + "\n\n")
        if pkg in OPTIONAL_BY:
            buf.set_text(f"{p.summary}.\n\n{display_name(pkg)} is one of the Craft apps: open-source programs "
                         "written from scratch in Rust (MIT or Apache-2.0 license). It is optional and not part "
                         "of Syluxium: it comes from its makers' release page and is installed as a .deb package "
                         "(remove it here like any other program).\n\nIt draws with Vulkan. Computers without a "
                         "Vulkan graphics driver use Mesa's software renderer, which is installed with it; "
                         f"that works everywhere but is slower.\n\nWebsite: {p.homepage}\n"
                         f"Download size: {human_kb(p.size)}")
            return

        def work():
            desc, extra = long_description(pkg)
            GLib.idle_add(lambda: self.current == pkg and self.set_long(p, desc, extra) and False)
        threading.Thread(target=work, daemon=True).start()

    def set_long(self, p, desc, extra):
        buf = self.d_text.get_buffer()
        text = p.summary + "\n\n" + (desc or "")
        if p.homepage:
            text += f"\n\nWebsite: {p.homepage}"
        if extra.get("Download-Size"):
            text += f"\nDownload size: {extra['Download-Size']}"
        buf.set_text(text)
        return False

    # ---- actions ----
    def busy(self, on):
        self.d_install.set_sensitive(not on)
        self.d_remove.set_sensitive(not on and not (self.current and PROTECTED.match(self.current)))
        self.update_all.set_sensitive(not on)

    def after(self, ok, out, success, pkg=None):
        self.busy(False)
        if not ok and pkg and "RECOVERY: ok" in out:
            # The repair finished the job (a setup script that failed the
            # first time worked the second): it did happen after all.
            inst = pkg in installed_packages()
            if inst == success.endswith("was installed."):
                ok = True
                self.log_note(f"{display_name(pkg)}: finished by the repair step.\n")
        if ok:
            self.status.set_text(success)
        else:
            self.status.set_text("That did not work." + (" Nothing was left half installed." if "RECOVERY: ok" in out
                                                          else ""))
            message(self.win, "The operation could not be completed.", error_text(out) + repair_note(out),
                    Gtk.MessageType.ERROR)

        def again():
            if pkg and self.current != pkg:
                return
            sel = self.side_view.get_selection()
            if sel.count_selected_rows():
                self.on_side(sel)
            elif pkg:
                self.fill(display_name(pkg), [pkg])
        self.reload(again)

    def log_note(self, text):
        self.runner.log(text)

    def planned(self, args, then):
        """Simulate "apt-get <args>" in the background, then then(plan) on the main thread."""
        self.busy(True)
        self.status.set_text("Checking what is needed...")
        self.progress.pulse()

        def work():
            res = plan(args)
            GLib.idle_add(lambda: (self.busy(False), then(res)) and False)
        threading.Thread(target=work, daemon=True).start()

    def install(self, pkg):
        if not pkg or self.runner.busy:
            return
        if pkg in OPTIONAL_BY:
            self.install_optional(pkg)
            return
        name = display_name(pkg)

        def go(res):
            self.status.set_text("")
            if not res["ok"]:
                message(self.win, f"{name} cannot be installed.", plan_problem_text(res), Gtk.MessageType.ERROR)
                return
            if not confirm_plan(self.win, name, pkg, res, self.pkgs):
                return
            if self.runner.start(["apt-get"] + APT_OPTS + ["install", pkg], f"Installing {name}...",
                                 lambda ok, out: self.after(ok, out, f"{name} was installed.", pkg), recover=True,
                                 new=res["install"]):
                self.busy(True)
        self.planned(["install", pkg], go)

    def install_optional(self, pkg):
        """A Craft app: download its .deb from the release page (checked against
        its SHA-256), then apt installs it with what it needs."""
        name = display_name(pkg)
        self.busy(True)
        self.status.set_text(f"Looking for the newest {name}...")
        self.progress.pulse()

        def found(rel):
            self.busy(False)
            version, url, size, sha = rel
            if message(self.win, f"Install {name} {version}?",
                       f"{name} is an optional program from {OPTIONAL_REPO}/{pkg} (not part of Syluxium).\n\n"
                       f"Download: {human(size)}, plus the libraries it needs (Vulkan; Mesa's software renderer "
                       "for computers without a Vulkan graphics driver).",
                       Gtk.MessageType.QUESTION, Gtk.ButtonsType.YES_NO) != Gtk.ResponseType.YES:
                self.status.set_text("")
                return
            if not self.admin.ready():
                return
            cache = os.path.expanduser("~/.cache/syluxium-appstore")
            os.makedirs(cache, exist_ok=True)
            dest = os.path.join(cache, f"{pkg}_{version}_amd64.deb")
            self.busy(True)
            self.status.set_text(f"Downloading {name}...")
            self.progress.set_fraction(0)
            self.progress.set_text(f"Downloading {name}...")

            def step(frac):
                GLib.idle_add(lambda: (self.progress.set_fraction(frac * 0.4),
                                       self.progress.set_text(f"Downloading {name} ({frac * 100:.0f}%)")) and False)

            def fetch():
                err = None if os.path.exists(dest) else download(url, dest, size, sha, step)
                GLib.idle_add(lambda: downloaded(err) and False)

            def downloaded(err):
                self.busy(False)
                if err:
                    self.status.set_text("That did not work.")
                    message(self.win, f"{name} could not be downloaded.", err, Gtk.MessageType.ERROR)
                    return
                self.runner.log(f"{name} {version}: {url}\n  sha256 {sha} (checked)\n")
                cmd = ["apt-get"] + APT_OPTS + ["install", dest, "mesa-vulkan-drivers", "libvulkan1"]
                if self.runner.start(cmd, f"Installing {name}...",
                                     lambda ok, out: self.after(ok, out, f"{name} was installed.", pkg),
                                     recover=True, new=[pkg]):
                    self.busy(True)
            threading.Thread(target=fetch, daemon=True).start()

        def work():
            rel = optional_release(pkg)
            GLib.idle_add(lambda: found(rel) and False)
        threading.Thread(target=work, daemon=True).start()

    def remove(self, pkg):
        if not pkg or self.runner.busy:
            return
        name = display_name(pkg)
        gone = plan(["remove", pkg])["remove"]
        bad = [g for g in gone if PROTECTED.match(g)]
        if bad:
            message(self.win, f"{name} cannot be removed.", "Syluxium needs it (or something that depends on it: "
                    + ", ".join(display_name(b) for b in bad[:5]) + ").", Gtk.MessageType.WARNING)
            return
        others = [display_name(g) for g in gone if g != pkg]
        text = f"Remove {name} from this computer?"
        sub = ("These programs need it and will be removed too:\n" + ", ".join(others[:20]) +
               (" and more" if len(others) > 20 else "")) if others else "You can install it again later."
        if message(self.win, text, sub, Gtk.MessageType.QUESTION, Gtk.ButtonsType.YES_NO) != Gtk.ResponseType.YES:
            return
        if self.runner.start(["apt-get"] + APT_OPTS + ["remove", pkg], f"Removing {name}...",
                             lambda ok, out: self.after(ok, out, f"{name} was removed.", pkg), recover=True):
            self.busy(True)

    def install_updates(self):
        names = sorted(self.upgradable)
        if not names or self.runner.busy:
            return

        def go(res):
            if not res["ok"]:
                message(self.win, "The updates cannot be installed.", plan_problem_text(res), Gtk.MessageType.ERROR)
                return
            if not confirm_plan(self.win, f"{len(names)} updates", None, res, self.pkgs):
                return
            if self.runner.start(["apt-get"] + APT_OPTS + ["install", "--only-upgrade"] + names,
                                 f"Installing {len(names)} updates...",
                                 lambda ok, out: self.after(ok, out, "The updates were installed."), recover=True):
                self.busy(True)
        self.planned(["install", "--only-upgrade"] + names, go)

    def repair(self):
        """Finish installations that were interrupted (power cut, lost connection)."""
        if self.runner.start(["dpkg", "--configure", "-a"], "Repairing...",
                             lambda ok, out: self.after(ok, out, "Every package is fully installed."), recover=True):
            self.busy(True)

    def refresh_catalog(self):
        if self.runner.start(["apt-get", "update"], "Downloading the catalog...", self.catalog_done):
            self.busy(True)

    def catalog_done(self, ok, out):
        self.busy(False)
        if not ok or "Failed to fetch" in out:
            self.status.set_text("The catalog could not be downloaded completely.")
            message(self.win, "The catalog could not be downloaded.", error_text(out), Gtk.MessageType.WARNING)
        else:
            self.status.set_text("The catalog is up to date.")
        self.stack.set_visible_child_name("loading")
        self.reload()


# ---------------------------------------------------------------------------
# The package installer: one downloaded .deb file
# ---------------------------------------------------------------------------
class DebInstaller:
    def __init__(self, path):
        self.path = os.path.abspath(path)
        self.win = window("Software Installer", 560, 420, "system-software-install")
        self.admin = Admin(self.win)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=12)
        self.win.add(box)
        info = self.read_info()
        head = Gtk.Box(spacing=12)
        head.pack_start(Gtk.Image.new_from_pixbuf(Icons().get(["application-x-deb", "package"], 48)), False, False, 0)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        if not info:
            texts.pack_start(label("This file is not a software package Syluxium can install.", bold=True,
                                   wrap=True), False, False, 0)
            texts.pack_start(label(os.path.basename(self.path), xalign=0), False, False, 0)
            head.pack_start(texts, True, True, 0)
            box.pack_start(head, False, False, 0)
            close = Gtk.Button(label="Close")
            close.connect("clicked", lambda *_: self.win.destroy())
            row = Gtk.Box()
            row.pack_end(close, False, False, 0)
            box.pack_end(row, False, False, 0)
            self.win.show_all()
            return
        self.pkg = info.get("Package", "")
        installed = installed_packages().get(self.pkg)
        texts.pack_start(label(f"Do you want to install {display_name(self.pkg)}?", bold=True, size="large",
                               wrap=True), False, False, 0)
        texts.pack_start(label(debrand(info.get("Description", "").split("\n")[0]), wrap=True), False, False, 0)
        head.pack_start(texts, True, True, 0)
        box.pack_start(head, False, False, 0)

        grid = Gtk.Grid(column_spacing=12, row_spacing=3)
        rows = [("File", os.path.basename(self.path)), ("Package", debrand(self.pkg)),
                ("Version", debrand(info.get("Version", ""))),
                ("Publisher", debrand(info.get("Maintainer", ""))),
                ("Size", human_kb(int(info.get("Installed-Size", "0") or 0)) or "unknown")]
        if installed:
            rows.append(("Installed now", debrand(installed)))
        if info.get("Depends"):
            deps = [re.split(r"[ (]", d.strip())[0] for d in info["Depends"].split(",")]
            rows.append(("Needs", debrand(", ".join(deps[:8]) + (" ..." if len(deps) > 8 else ""))))
        for i, (k, v) in enumerate(rows):
            grid.attach(label(k + ":", xalign=0), 0, i, 1, 1)
            val = label(v, wrap=True)
            val.set_selectable(True)
            grid.attach(val, 1, i, 1, 1)
        box.pack_start(grid, False, False, 0)
        self.plan_label = label("Checking what else it needs...", wrap=True)
        self.plan_label.set_selectable(True)
        box.pack_start(self.plan_label, False, False, 0)
        box.pack_start(label("Only install software from publishers you trust.", wrap=True), False, False, 0)
        self.progress, self.details, exp = log_area()
        box.pack_start(self.progress, False, False, 0)
        box.pack_start(exp, True, True, 0)
        self.status = label("", xalign=0)
        row = Gtk.Box(spacing=6)
        row.pack_start(self.status, True, True, 0)
        self.reinstall = installed == info.get("Version")
        self.install_btn = Gtk.Button.new_with_mnemonic("_Reinstall" if self.reinstall else
                                      "_Install" if not installed else "_Install this version")
        self.close_btn = Gtk.Button(label="Cancel")
        self.install_btn.connect("clicked", lambda *_: self.install())
        self.close_btn.connect("clicked", lambda *_: self.win.destroy())
        row.pack_end(self.close_btn, False, False, 0)
        row.pack_end(self.install_btn, False, False, 0)
        box.pack_end(row, False, False, 0)
        self.runner = Runner(self.admin, self.progress, self.status, self.details)
        row.pack_end(self.runner.stop_btn, False, False, 0)
        self.win.show_all()
        self.progress.set_text("")
        self.check()

    def cmd_args(self):
        return (["--reinstall"] if self.reinstall else []) + ["install", self.path]

    def check(self):
        """apt's plan for this file (simulated): which packages it pulls in, or why it can't be installed."""
        self.install_btn.set_sensitive(False)

        def work():
            res = plan(self.cmd_args())
            GLib.idle_add(lambda: self.checked(res) and False)
        threading.Thread(target=work, daemon=True).start()

    def checked(self, res):
        if not res["ok"]:
            self.plan_label.set_markup("<b>This package cannot be installed.</b>\n" +
                                       GLib.markup_escape_text(plan_problem_text(res)))
            self.status.set_text("Nothing was changed.")
            return False
        self.new = res["install"]
        extra = [p for p in res["install"] if p != self.pkg]
        text = (f"It also needs {len(extra)} package{'s' if len(extra) != 1 else ''} from the catalog, "
                "installed with it: " + ", ".join(display_name(p) for p in extra[:20]) +
                (" ..." if len(extra) > 20 else "") + "." if extra else "It needs nothing else.")
        if res["remove"]:
            text += "\nThese will be removed: " + ", ".join(display_name(p) for p in res["remove"][:10]) + "."
        if res["download"]:
            text += f"\nDownload: {human(res['download'])} (needs the Internet)."
        self.plan_label.set_text(text)
        self.install_btn.set_sensitive(True)
        return False

    def read_info(self):
        try:
            out = subprocess.run(["dpkg-deb", "-f", self.path], capture_output=True, text=True, env=ENV)
        except OSError:
            return None
        if out.returncode != 0:
            return None
        info, key = {}, None
        for line in out.stdout.split("\n"):
            if line.startswith(" ") and key:
                info[key] += "\n" + line[1:]
            elif ":" in line:
                key, _, v = line.partition(":")
                info[key] = v.strip()
        return info if "Package" in info else None

    def install(self):
        cmd = ["apt-get"] + APT_OPTS + self.cmd_args()
        if self.runner.start(cmd, f"Installing {display_name(self.pkg)}...", self.done, recover=True,
                             new=self.new):
            self.install_btn.set_sensitive(False)
            self.close_btn.set_sensitive(False)

    def done(self, ok, out):
        self.close_btn.set_sensitive(True)
        self.close_btn.set_label("Close")
        if not ok and "RECOVERY: ok" in out and self.pkg in installed_packages():
            ok = True  # the repair step finished the job
        if ok:
            self.status.set_text(f"{display_name(self.pkg)} was installed.")
            self.install_btn.hide()
        else:
            self.status.set_text("The installation did not work." + (
                " The computer is as it was before." if "RECOVERY: rolled back" in out or "RECOVERY: ok" in out
                else ""))
            self.install_btn.set_sensitive(True)
            message(self.win, "The software could not be installed.", error_text(out) + repair_note(out),
                    Gtk.MessageType.ERROR)


def main(argv):
    if len(argv) > 2 and argv[1] == "--deb":
        DebInstaller(argv[2])
    elif len(argv) > 1 and argv[1].endswith(".deb") and os.path.exists(argv[1]):
        DebInstaller(argv[1])
    elif len(argv) > 1 and argv[1] == "--updates":
        Store(page="updates")
    elif len(argv) > 2 and argv[1] == "--search":
        Store(search=argv[2])
    else:
        Store()
    Gtk.main()


if __name__ == "__main__":
    main(sys.argv)
