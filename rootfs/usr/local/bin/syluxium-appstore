            .store-tile:hover { border-color: rgba(111, 227, 240, 0.7); background-color: #252d5c; }
            .store-group { color: #6fe3f0; }
        """)
        Gtk.StyleContext.add_provider_for_screen(self.win.get_screen(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        ev.get_style_context().add_class("store-banner")
        box = Gtk.Box(spacing=10, margin=10)
        img = Gtk.Image.new_from_pixbuf(self.icons.get(["system-software-install", "package"], 48))
        box.pack_start(img, False, False, 0)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        texts.pack_start(label(TITLE, bold=True, size="x-large"), False, False, 0)
        texts.pack_start(label("Thousands of free programs, ready to install."), False, False, 0)
        box.pack_start(texts, True, True, 0)
        self.search = Gtk.SearchEntry(placeholder_text="Search for programs")
        self.search.set_size_request(260, -1)
        self.search.set_valign(Gtk.Align.CENTER)
