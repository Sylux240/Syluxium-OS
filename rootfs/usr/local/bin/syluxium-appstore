        box.pack_end(self.search, False, False, 0)
        refresh = Gtk.Button(label="Refresh catalog")
        refresh.set_valign(Gtk.Align.CENTER)
        refresh.set_tooltip_text("Download the newest list of programs and updates")
        refresh.connect("clicked", lambda *_: self.refresh_catalog())
        box.pack_end(refresh, False, False, 0)
        ev.add(box)
        return ev

    def sidebar(self):
        self.side = Gtk.ListStore(GdkPixbuf.Pixbuf, str, str)  # icon, title, key
        view = Gtk.TreeView(model=self.side, headers_visible=False)
        col = Gtk.TreeViewColumn()
        ic, tx = Gtk.CellRendererPixbuf(), Gtk.CellRendererText(ypad=4)
        col.pack_start(ic, False), col.pack_start(tx, True)
        col.add_attribute(ic, "pixbuf", 0), col.add_attribute(tx, "markup", 1)
        view.append_column(col)
        for title, icon, key in [("Featured", "package_favourite", "featured"),
                                 ("Installed", "system-file-manager", "installed"),
                                 ("Updates", "system-software-update", "updates")] + \
                [(t, i, "cat:" + t) for t, i, _ in CATEGORIES]:
            self.side.append([self.icons.get([icon, "package"], 22), GLib.markup_escape_text(title), key])
        self.side_view = view
        view.get_selection().connect("changed", self.on_side)
        sw = Gtk.ScrolledWindow(shadow_type=Gtk.ShadowType.IN)
        sw.set_margin_start(8), sw.set_margin_top(8)
        sw.add(view)
        return sw

    def loading_page(self):
