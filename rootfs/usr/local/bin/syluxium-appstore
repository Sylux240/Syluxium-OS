    def list_page(self):
        paned = Gtk.Paned(orientation=Gtk.Orientation.VERTICAL)
        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        top.set_margin_top(8), top.set_margin_end(8)
