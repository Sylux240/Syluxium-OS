#!/bin/sh
# Start the graphical login screen (TDM), which starts the X server and,
# after a login, the user's Trinity (TDE) session. Runs as root at boot.
export PATH=/opt/trinity/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mkdir -p /var/log /var/lib/tdm /tmp/.X11-unix /tmp/.ICE-unix /run/dbus /var/lib/dbus /run/user
chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix
chmod 755 /run/user

# Home folders: make any missing ones from /etc/skel and give them to
# their owners (the live system's files all start out as root's).
while IFS=: read -r name _ uid gid _ home _; do
    [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] || continue
    case "$home" in /home/*) ;; *) continue ;; esac
    if [ ! -d "$home" ]; then
        mkdir -p "$home" && cp -a /etc/skel/. "$home/" 2>/dev/null
    fi
    # The live system (root in RAM): an "Install Syluxium" icon on the desktop.
    if [ "$(awk '$2 == "/" {print $3}' /proc/mounts)" = ramfs ]; then
        mkdir -p "$home/Desktop"
        cp /usr/share/applications/syluxium-installer.desktop "$home/Desktop/Install Syluxium.desktop"
        chmod +x "$home/Desktop/Install Syluxium.desktop"
    fi
    if [ "$(stat -c %u "$home")" != "$uid" ] || [ "$(stat -c %u "$home/Desktop" 2>/dev/null)" = 0 ]; then
        chown -R "$uid:$gid" "$home" && chmod 750 "$home"
    fi
done < /etc/passwd

dbus-uuidgen --ensure=/etc/machine-id 2>/dev/null
cp /etc/machine-id /var/lib/dbus/machine-id 2>/dev/null
[ -S /run/dbus/system_bus_socket ] || dbus-daemon --system --fork > /var/log/dbus-system.log 2>&1

exec tdm -nodaemon ${TDM_DEBUG:+-debug $TDM_DEBUG} -error /var/log/tdm.log > /var/log/tdm.out 2>&1
