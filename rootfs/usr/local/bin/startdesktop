#!/bin/sh
# Start the graphical login screen (TDM), which starts the X server and,
# after a login, the user's Trinity (TDE) session. Runs as root at boot.
export PATH=/opt/trinity/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mkdir -p /var/log /var/lib/tdm /tmp/.X11-unix /tmp/.ICE-unix /run/dbus /var/lib/dbus /run/user
chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix
chmod 755 /run/user

syluxium-early

# On a Syluxium stick: the X server's, login screen's and session's logs go
# into this boot's log folder too (every 15 s), next to the kernel log.
if [ -d /boot/logs ] && grep -q " /boot/logs-stick " /proc/mounts; then
    (
        while :; do
            sleep 15
            for f in /var/log/Xorg.0.log /var/log/Xorg.0.log.old /var/log/tdm.log /var/log/tdm.out; do
                [ -f "$f" ] && cp "$f" /boot/logs/ 2>/dev/null
            done
            for h in /home/*/.xsession-errors; do
                [ -f "$h" ] && cp "$h" "/boot/logs/xsession-errors-$(basename "$(dirname "$h")").txt" 2>/dev/null
            done
            sync
        done
    ) &
fi

# X display driver for this machine (modesetting on a DRM device, else fbdev).
syluxium-display-config > /dev/null 2>&1

# Printing (CUPS): what its install scripts would set up, then the print service.
if [ -x /usr/sbin/cupsd ]; then
    [ -f /etc/cups/cupsd.conf ] || cp /usr/share/cups/cupsd.conf.default /etc/cups/cupsd.conf
    mkdir -p /run/cups/certs /var/spool/cups/tmp /var/cache/cups /var/log/cups
    chown root:lp /var/spool/cups /var/cache/cups /etc/cups 2>/dev/null
    chmod 710 /var/spool/cups; chmod 1770 /var/spool/cups/tmp
    pidof cupsd > /dev/null || cupsd
fi

# Home folders: make any missing ones from /etc/skel and give them to
# their owners (the live system's files all start out as root's).
while IFS=: read -r name _ uid gid _ home _; do
    [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] || continue
    case "$home" in /home/*) ;; *) continue ;; esac
    if [ ! -d "$home" ]; then
        mkdir -p "$home" && cp -a /etc/skel/. "$home/" 2>/dev/null
    fi
    # The live system (root in RAM): an "Install Syluxium" icon on the desktop.
    if [ "$(awk '$2 == "/" {print $3}' /proc/mounts)" = ramfs ]; then
        mkdir -p "$home/Desktop"
        cp /usr/share/applications/syluxium-installer.desktop "$home/Desktop/Install Syluxium.desktop"
        chmod +x "$home/Desktop/Install Syluxium.desktop"
    fi
    if [ "$(stat -c %u "$home")" != "$uid" ] || [ "$(stat -c %u "$home/Desktop" 2>/dev/null)" = 0 ]; then
        chown -R "$uid:$gid" "$home" && chmod 750 "$home"
    fi
done < /etc/passwd

# D-Bus starts system services (e.g. TDE's hardware control daemon: power
# management, brightness) through a setuid helper that must belong to the
# messagebus group; the image's files all start out group root.
helper=/usr/lib/dbus-1.0/dbus-daemon-launch-helper
if [ -f "$helper" ]; then
    chown root:messagebus "$helper" && chmod 4754 "$helper"
fi

dbus-uuidgen --ensure=/etc/machine-id 2>/dev/null
cp /etc/machine-id /var/lib/dbus/machine-id 2>/dev/null
[ -S /run/dbus/system_bus_socket ] || dbus-daemon --system --fork > /var/log/dbus-system.log 2>&1

# USB sticks: mounted at /media/<label> when plugged in (AutoPlay box in the session).
syluxium-automount > /var/log/automount.log 2>&1 &
# Wi-Fi: wpa_supplicant for every wireless interface (network icon in the session).
syluxium-wifi > /var/log/syluxium-wifi.log 2>&1 &
# Adapter settings from Network Connections (static addresses, disabled adapters).
{ syluxium-netconfig apply; exec syluxium-netconfig watch; } > /var/log/syluxium-netconfig.log 2>&1 &
exec tdm -nodaemon ${TDM_DEBUG:+-debug $TDM_DEBUG} -error /var/log/tdm.log > /var/log/tdm.out 2>&1
