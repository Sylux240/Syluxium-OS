#!/bin/sh
# Test aid: log in to the Xfce desktop, then show the Android parts as the
# desktop user, for screenshots. Console lines start with "ANDTEST".
#   android-ui-test apk FILE.apk   the .apk installer dialog for FILE
#   android-ui-test store          the App Store's Android Apps page (F-Droid;
#                                  downloads the catalog: needs QEMU's user networking)
#   android-ui-test store PKG[,PKG]  the same, then install, open, update and remove
#                                  the first of these apps found (Android must be set up)
#   android-ui-test menu           the Start menu (Android Apps folder)
#   android-ui-test apkflow FILE.apk PACKAGE
#                                  install an app from an .apk (as opening it does),
#                                  open it from its Start menu entry, screenshot,
#                                  then remove it again (Android must be set up)
#   android-ui-test app PACKAGE    open an Android app as a desktop window
#                                  (Android must be set up: syluxium-android-container init)
say() { echo "ANDTEST $*" > /dev/console; }
startdesktop > /dev/null 2>&1 &
export DISPLAY=:0
for i in $(seq 1 120); do
    XAUTHORITY="$(ls /var/run/xauth/A:0-* 2>/dev/null | head -1)"
    [ -n "$XAUTHORITY" ] && [ -S /tmp/.X11-unix/X0 ] && break
    sleep 1
done
export XAUTHORITY
sleep 10
xdotool key Return    # log in (the login screen's user has no password)
for i in $(seq 1 120); do pidof xfce4-panel > /dev/null && break; sleep 1; done
sleep 12
env=
for e in /proc/[0-9]*/environ; do
    [ -z "$env" ] || break
    [ "$(stat -c %u "$e" 2>/dev/null)" = 1000 ] || continue
    tr '\0' '\n' < "$e" 2>/dev/null | grep -q '^DBUS_SESSION_BUS_ADDRESS=' || continue
    env=$(tr '\0' '\n' < "$e" | grep -E '^[A-Za-z_][A-Za-z0-9_]*=' | grep -v "'" | sed "s/^/export /; s/=/='/; s/\$/'/")
done
asuser() {
    ( eval "$env"; cd /home/syluxium; exec python3 -c 'import os, sys
os.initgroups("syluxium", 1000); os.setgid(1000); os.setuid(1000)
os.execvp(sys.argv[1], sys.argv[1:])' "$@" ) < /dev/null > /dev/console 2>&1 &
}
say "desktop up"
case "$1" in
apk)
    cp "$2" /tmp/test-app.apk && chmod 644 /tmp/test-app.apk
    asuser syluxium-apk-install /tmp/test-app.apk ;;
store)
    for i in $(seq 1 60); do ip route 2>/dev/null | grep -q default && break; sleep 1; done
    if [ -n "$2" ]; then
        # install, open, update and remove an app through the store (STORETEST lines)
        asuser env SYLUXIUM_STORE_TEST="$2" syluxium-appstore --android
        # what Android's side is doing meanwhile (until the store test ends)
        (for i in $(seq 1 40); do
            sleep 60
            say "store watch: $(ps -eo pid,etimes,args 2>/dev/null | grep -E 'syluxium-android|waydroid|apk' | grep -v grep | cut -c1-110 | tr '\n' '|')"
            say "store watch mem: $(grep -E '^(MemFree|MemAvailable|Cached|Shmem):' /proc/meminfo | tr -s ' ' | tr '\n' ' '); top: $(ps -eo rss,comm --sort=-rss 2>/dev/null | sed -n 2,7p | tr -s ' ' | tr '\n' ',')"
            say "store watch net: $(ip -4 -o addr 2>&1 | cut -c1-80 | tr '\n' '|') routes: $(ip -4 route 2>&1 | tr '\n' '|') dns: $(grep -v '^#' /etc/resolv.conf 2>&1 | tr '\n' '|')"
            say "store watch log: $(tail -4 /home/syluxium/.cache/syluxium-android.log 2>/dev/null | cut -c1-160 | tr '\n' '|')"
        done) &
    else
        asuser syluxium-appstore --android
    fi
    for i in $(seq 1 90); do
        [ -f /home/syluxium/.cache/syluxium-appstore/fdroid/apps.json ] && break
        sleep 2
    done
    say "catalog: $(ls -la /home/syluxium/.cache/syluxium-appstore/fdroid/ 2>&1 | tr '\n' ' ')"
    sleep 30
    w=$(xdotool search --onlyvisible --name "Syluxium App Store" 2>/dev/null | tail -1)
    [ -n "$w" ] && xdotool windowactivate "$w" key super+Up 2>/dev/null
    ;;
menu)
    xdotool key ctrl+Escape ;;
apkflow)
    cp "$2" /tmp/test-app.apk && chmod 644 /tmp/test-app.apk
    pkg=$3
    desk=/home/syluxium/.local/share/applications/waydroid.$pkg.desktop
    asuser syluxium-apk-install --yes /tmp/test-app.apk
    for i in $(seq 1 120); do
        sleep 5
        [ -f "$desk" ] && break
    done
    say "installed: menu entry $([ -f "$desk" ] && echo present || echo MISSING); log: $(tail -3 /home/syluxium/.cache/syluxium-android.log | tr '\n' '|')"
    say "entry: $(grep -E '^(Name|Exec|Icon|Categories)=' "$desk" 2>/dev/null | tr '\n' '|')"
    # as the Start menu does: the menu entry through GIO
    asuser python3 -c 'import sys, gi; gi.require_version("Gio", "2.0"); from gi.repository import Gio
print("launch:", Gio.DesktopAppInfo.new_from_filename(sys.argv[1]).launch([], None))' "$desk"
    for i in $(seq 1 24); do
        sleep 5
        say "windows: $(xdotool search --onlyvisible --name . getwindowname %@ 2>/dev/null | tr '\n' '|' | cut -c1-300)"
    done
    say "apk ready for screenshot"
    sleep 25
    asuser syluxium-android remove "$pkg"
    sleep 20
    say "removed: menu entry $([ -f "$desk" ] && echo STILL THERE || echo gone); list: $(su -s /bin/sh syluxium -c 'syluxium-android list' 2>/dev/null | tr '\n' ' ')"
    ;;
app)
    asuser syluxium-android launch "$2"
    for i in $(seq 1 60); do
        sleep 5
        st=$(/usr/local/sbin/syluxium-android-container status 2>/dev/null)
        ready=$([ -f /run/user/1000/syluxium-android/ready ] && echo ready)
        say "t=$((i * 5))s container=$st $ready windows: $(xdotool search --onlyvisible --name . getwindowname %@ 2>/dev/null | tr '\n' '|' | cut -c1-200)"
        [ -n "$ready" ] && break
    done
    for i in $(seq 1 24); do
        sleep 5
        say "windows: $(xdotool search --onlyvisible --name . getwindowname %@ 2>/dev/null | tr '\n' '|' | cut -c1-300)"
    done
    say "log: $(grep -v 'Failed to get service waydroidplatform' /home/syluxium/.cache/syluxium-android.log 2>/dev/null | tail -45 | tr '\n' '|' | cut -c1-6000)"
    say "cfgperm: $(ls -la /var/lib/waydroid/ 2>&1 | head -12 | tr '\n' '|')"
    say "cfg: $(tr '\n' '|' < /var/lib/waydroid/waydroid.cfg 2>&1 | cut -c1-3000)"
    say "container log: $(tail -15 /var/log/waydroid-container.log 2>/dev/null | tr '\n' '|' | cut -c1-2000)"
    say "host: $(grep -v 'wayland-host-icon\|Traceback\|File \|\^\^\|sys.stdout' /run/user/1000/syluxium-wayland-host.log 2>/dev/null | tail -40 | tr '\n' '|' | cut -c1-4000)"
    say "waydroid.log: $(grep -v 'lxc-info\|seccomp\|waiting .* seconds\|RUNNING$\|STOPPED$' /var/lib/waydroid/waydroid.log 2>/dev/null | tail -45 | tr '\n' '|' | cut -c1-6000)"
    say "binder: $(ls -l /dev/anbox-binder /dev/binderfs/ 2>&1 | tr '\n' '|')"
    LA="lxc-attach -P /var/lib/waydroid/lxc -n waydroid --clear-env --"
    say "crash: $($LA /system/bin/logcat -d -b crash 2>&1 | grep -v 'runtime.cc:675' | tail -30 | tr '\n' '|' | cut -c1-5000)"
    say "props: multi_windows=$($LA /system/bin/getprop persist.waydroid.multi_windows) boot=$($LA /system/bin/getprop sys.boot_completed) active_apps=$($LA /system/bin/getprop waydroid.active_apps)"
    say "launch: $($LA /system/bin/logcat -d -b all 2>&1 | grep -i 'START u0\|ActivityTaskManager\|WindowManager\|hwcomposer\|Waydroid\|SurfaceFlinger' | grep -v 'option\[' | tail -40 | tr '\n' '|' | cut -c1-7000)"
    say "unlock: $($LA /system/bin/logcat -d -b all 2>&1 | grep -i 'UserController\|unlock\|installd\|Launcher\|Trebuchet\|vold\|StorageManager\|FallbackHome' | grep -v 'Failed to migrate' | tail -40 | tr '\n' '|' | cut -c1-7000)"
    say "userkey: $($LA /system/bin/logcat -d -b all 2>&1 | grep -i 'UserController\|unlockUser\|LockSettings\|vold\|keystore\|SyntheticPassword\|fscrypt\|user key' | grep -v 'Failed to migrate' | head -50 | tr '\n' '|' | cut -c1-8000)"
    say "fatal: $($LA /system/bin/logcat -d -b all 2>&1 | grep ' [EF] ' | grep -i 'system_server\|AndroidRuntime\|FATAL\|libc ' | grep -v 'runtime.cc:675' | tail -40 | tr '\n' '|' | cut -c1-6000)"
    ;;
esac
sleep 20
say "ready for screenshot"
