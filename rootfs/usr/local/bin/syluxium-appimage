#!/bin/bash
# Run an AppImage: double-click in Files (Thunar), the launchers of
# pre-installed ones (/opt/apps), or from a terminal.
#
#   syluxium-appimage FILE [ARGS...]
#
# - A file without the execute bit (a fresh download): asks whether to make
#   it executable, then runs it (a copy in the user's runtime folder when the
#   file isn't theirs to change, e.g. on a read-only stick).
# - FUSE is the normal path: the AppImage's runtime mounts its squashfs with
#   fusermount3 (/dev/fuse). Without FUSE, or when the mount fails, it runs
#   unpacked instead (APPIMAGE_EXTRACT_AND_RUN=1: unpacked to /tmp, slower start).
# - Every launch goes to ~/.cache/syluxium/appimage.log, and on test rounds
#   (logs stick) to appimage-launches.txt on the stick.
#
# Start menu integration (like appimaged / AppImageLauncher):
#   syluxium-appimage --integrate FILE     menu entry + icon from the AppImage itself
#   syluxium-appimage --unintegrate FILE   take it out again (also the entry's own action)
#   syluxium-appimage --sync               every AppImage in ~/Applications gets an entry,
#                                          entries of AppImages that are gone are removed
#                                          (at login)
# The first time an AppImage outside ~/Applications is opened from the
# desktop, it asks once whether to add it to the Start menu.
APPS_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/applications
ICON_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor
entry_id() { # the menu entry's id for an AppImage path
    printf 'appimage-%s-%s' "$(basename -- "$1" | sed 's/\.[Aa]pp[Ii]mage$//; s/[^A-Za-z0-9._-]/_/g' | cut -c1-40)" \
        "$(printf '%s' "$1" | md5sum | cut -c1-8)"
}
integrate() {
    local file id tmp desk icon iconname w name rel t d hops
    file=$(readlink -f -- "$1")
    [ -f "$file" ] || return 1
    [ "$(od -An -c -j 8 -N 2 -- "$file" 2>/dev/null | tr -d ' ')" = "AI" ] || return 1
    [ -x "$file" ] || chmod +x -- "$file" 2>/dev/null || return 1
    id=$(entry_id "$file")
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/appimage-int.XXXXXX") || return 1
    # Only the .desktop file and the icon come out (runtimes take a pattern).
    (cd "$tmp" && "$file" --appimage-extract '*.desktop' && "$file" --appimage-extract .DirIcon) >/dev/null 2>&1
    desk=$(ls "$tmp"/squashfs-root/*.desktop 2>/dev/null | head -n 1)
    iconname=$( [ -n "$desk" ] && sed -n 's/^Icon=//p' "$desk" | head -n 1)
    # The icon at the top is often a symlink (into usr/share/icons): take
    # each link's target out too, a few hops at most.
    icon=
    for rel in ${iconname:+"$iconname.svg" "$iconname.png"} .DirIcon; do
        (cd "$tmp" && "$file" --appimage-extract "$rel") >/dev/null 2>&1
        hops=0
        while [ -L "$tmp/squashfs-root/$rel" ] && [ $hops -lt 5 ]; do
            t=$(readlink "$tmp/squashfs-root/$rel")
            case $t in /*) break;; esac
            d=$(dirname -- "$rel")
            [ "$d" = . ] && rel=$t || rel=$d/$t
            (cd "$tmp" && "$file" --appimage-extract "$rel") >/dev/null 2>&1
            hops=$((hops + 1))
        done
        [ -f "$tmp/squashfs-root/$rel" ] && [ ! -L "$tmp/squashfs-root/$rel" ] && { icon=$tmp/squashfs-root/$rel; break; }
    done
    mkdir -p "$APPS_DIR"
    if [ -n "$icon" ]; then
        if head -c 512 "$icon" | grep -q "<svg"; then
            mkdir -p "$ICON_DIR/scalable/apps" && cp "$icon" "$ICON_DIR/scalable/apps/$id.svg"
        else
            w=$(od -An -tu1 -j16 -N4 "$icon" | awk '{print $1*16777216+$2*65536+$3*256+$4}')
            case $w in 16|22|24|32|48|64|96|128|256|512) ;; *) w=256;; esac
            mkdir -p "$ICON_DIR/${w}x$w/apps" && cp "$icon" "$ICON_DIR/${w}x$w/apps/$id.png"
        fi
    fi
    name=$(basename -- "$file" | sed 's/\.[Aa]pp[Ii]mage$//')
    {
        if [ -n "$desk" ]; then
            # The program's own entry: our launcher, our icon, no TryExec, plus "remove".
            sed -n '1,/^\[Desktop Action/p' "$desk" | sed '/^\[Desktop Action/d' |
                sed -e "s|^Exec=[^ ]*|Exec=syluxium-appimage \"$file\"|" -e "s|^Icon=.*|Icon=${icon:+$id}|" \
                    -e '/^TryExec=/d' -e '/^Actions=/d' -e '/^X-AppImage-/d'
        else
            printf '[Desktop Entry]\nType=Application\nName=%s\nExec=syluxium-appimage "%s" %%U\nIcon=%s\nCategories=Utility;\n' \
                "$name" "$file" "${icon:+$id}"
        fi
        printf 'X-Syluxium-AppImage=%s\nActions=SyluxiumRemove;\n\n[Desktop Action SyluxiumRemove]\nName=Remove from Start menu\nExec=syluxium-appimage --unintegrate "%s"\n' \
            "$file" "$file"
    } > "$APPS_DIR/$id.desktop"
    chmod 644 "$APPS_DIR/$id.desktop"
    rm -rf "$tmp"
    command -v update-desktop-database >/dev/null && update-desktop-database "$APPS_DIR" 2>/dev/null
    command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q -t "$ICON_DIR" 2>/dev/null
    return 0
}
unintegrate() {
    local file id
    file=$(readlink -f -- "$1" 2>/dev/null || echo "$1")
    id=$(entry_id "$file")
    rm -f "$APPS_DIR/$id.desktop" "$ICON_DIR"/*/apps/"$id".png "$ICON_DIR"/scalable/apps/"$id".svg
    command -v update-desktop-database >/dev/null && update-desktop-database "$APPS_DIR" 2>/dev/null
    return 0
}
case "$1" in
--integrate)   integrate "$2"; exit $? ;;
--unintegrate) unintegrate "$2"; exit 0 ;;
--sync)
    for a in "$HOME"/Applications/*.[Aa]pp[Ii]mage; do
        [ -f "$a" ] || continue
        [ -f "$APPS_DIR/$(entry_id "$(readlink -f -- "$a")").desktop" ] || integrate "$a"
    done
    for d in "$APPS_DIR"/appimage-*.desktop; do
        [ -f "$d" ] || continue
        p=$(sed -n 's/^X-Syluxium-AppImage=//p' "$d")
        [ -n "$p" ] && [ ! -f "$p" ] && unintegrate "$p"
    done
    exit 0 ;;
esac

f=$1
if [ -z "$f" ]; then
    echo "usage: syluxium-appimage FILE [ARGS...] | --integrate FILE | --unintegrate FILE | --sync" >&2
    exit 2
fi
shift
f=$(readlink -f -- "$f")
name=$(basename -- "$f")
logdir=${XDG_CACHE_HOME:-$HOME/.cache}/syluxium
mkdir -p "$logdir" 2>/dev/null
note() {
    echo "$(date '+%F %T') $*" >> "$logdir/appimage.log" 2>/dev/null
    if [ -d /run/syluxium-diag ] && [ -w /run/syluxium-diag ]; then
        echo "$(cut -d' ' -f1 /proc/uptime) $*" >> /run/syluxium-diag/appimage-launches.txt
        chmod 666 /run/syluxium-diag/appimage-launches.txt 2>/dev/null
    fi
}
# Dialogs only for a desktop user without a terminal (SYLUXIUM_APPIMAGE_NOGUI=1: never, for scripts).
gui() { [ -z "$SYLUXIUM_APPIMAGE_NOGUI" ] && [ -n "$DISPLAY$WAYLAND_DISPLAY" ] && command -v yad >/dev/null 2>&1 && ! [ -t 2 ]; }
fail() {
    note "$name: $1"
    if gui; then
        yad --error --title="$name" --window-icon=dialog-error --width=460 --center \
            --text="<b>$name could not be started.</b>\n\n$(printf '%s' "$2" | sed 's/&/\&amp;/g; s/</\&lt;/g' | tail -n 6)" \
            --button=OK:0 >/dev/null 2>&1
    else
        echo "syluxium-appimage: $name: $1" >&2
    fi
    exit "${3:-1}"
}

[ -f "$f" ] || fail "file not found" "There is no file at $f." 2
# Type 1 and 2 AppImages carry "AI" + type at offset 8 of their ELF header.
magic=$(od -An -c -j 8 -N 2 -- "$f" 2>/dev/null | tr -d ' ')
[ "$magic" = "AI" ] || fail "not an AppImage" "$name is not an AppImage (no AppImage signature)." 2

if [ ! -x "$f" ]; then
    if gui; then
        yad --question --title="Run $name?" --window-icon=dialog-question --width=440 --center \
            --text="<b>$name is a program that isn't marked as executable yet.</b>\n\nOnly run programs from sources you trust. Make it executable and run it?" \
            --button="Run:0" --button="Cancel:1" >/dev/null 2>&1 || exit 1
    elif [ -t 0 ]; then
        printf '%s is not executable. Make it executable and run it? [y/N] ' "$name" >&2
        read -r answer
        case $answer in [yY]*) ;; *) exit 1;; esac
    else
        fail "not executable" "$name is not marked as executable (chmod +x)." 126
    fi
    if ! chmod +x -- "$f" 2>/dev/null || [ ! -x "$f" ]; then
        # Not ours to change (another user's file, a read-only stick): run a copy.
        copydir=${XDG_RUNTIME_DIR:-/tmp}/appimages-$(id -u)
        mkdir -p "$copydir" && cp -- "$f" "$copydir/$name" && chmod +x "$copydir/$name" ||
            fail "could not make it executable" "$name could not be made executable or copied."
        f=$copydir/$name
    fi
    note "$name: made executable"
fi

# Opened from the desktop for the first time: offer a Start menu entry
# (once per file; ~/Applications is integrated at login anyway).
case "$f" in
/opt/apps/*|"$HOME"/Applications/*) ;;
*)
    if gui && [ -z "$SYLUXIUM_APPIMAGE_NOASK" ] && [ ! -f "$APPS_DIR/$(entry_id "$f").desktop" ] && ! grep -qxF "$f" "$logdir/appimage-asked" 2>/dev/null; then
        echo "$f" >> "$logdir/appimage-asked"
        if yad --question --title="$name" --window-icon=application-x-executable --width=420 --center \
               --text="<b>Add $name to the Start menu?</b>\n\nIt gets its own entry and icon there (remove it again from the entry's right-click menu)." \
               --button="Add to Start menu:0" --button="Just run it:1" >/dev/null 2>&1; then
            integrate "$f" && note "$name: added to the Start menu" &
        fi
    fi ;;
esac

# No FUSE (device or mount helper): unpack instead of mounting.
if [ ! -c /dev/fuse ] || ! { command -v fusermount3 || command -v fusermount; } >/dev/null 2>&1; then
    export APPIMAGE_EXTRACT_AND_RUN=1
    note "$name: no FUSE here, running unpacked"
fi

export APPIMAGE_SILENT_INSTALL=1   # AppImageLauncher-style integration prompts stay quiet
# GTK AppImages bundle input-method modules (uim, listed for every locale)
# whose data isn't on the system: uim exits the program at start (Xournal++).
# Without an input-method framework configured, GTK's own module.
[ -z "$GTK_IM_MODULE" ] && export GTK_IM_MODULE=gtk-im-context-simple
err=$(mktemp "${TMPDIR:-/tmp}/appimage-err.XXXXXX")
trap 'rm -f "$err"' EXIT
# Run it with stderr shown as usual and kept in $err (stdout untouched).
launch() {
    { "$f" "$@" 2>&1 1>&3 3>&- | tee "$err" 1>&2 3>&-; return "${PIPESTATUS[0]}"; } 3>&1
}
start=$SECONDS
note "$name: starting ($f)"
launch "$@"
rc=$?
ran=$((SECONDS - start))
# The runtime couldn't mount (no FUSE permission, a stale helper...): it
# says so on stderr right away. Run it unpacked instead.
if [ $rc -ne 0 ] && [ -z "$APPIMAGE_EXTRACT_AND_RUN" ] && [ $ran -lt 15 ] &&
   grep -qiE "fuse|fusermount|cannot mount|squashfs" "$err"; then
    note "$name: FUSE mount failed ($(grep -iE 'fuse|mount' "$err" | head -n 1)), running unpacked"
    : > "$err"
    start=$SECONDS
    export APPIMAGE_EXTRACT_AND_RUN=1
    launch "$@"
    rc=$?
    ran=$((SECONDS - start))
fi
note "$name: exit $rc after $ran s$( [ $rc -ne 0 ] && printf ': %s' "$(tail -n 2 "$err" | tr '\n' ' ' | cut -c1-300)")"
# A program that dies right away with an error: show why (a GUI user sees no terminal).
if [ $rc -ne 0 ] && [ $rc -lt 128 ] && [ $ran -lt 10 ] && [ -s "$err" ]; then
    fail "exit $rc" "$(cat "$err")" $rc
fi
exit $rc
