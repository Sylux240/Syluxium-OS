if os.geteuid() != 0 and not SHOTS:  # the desktop icon asks for the administrator password
    try:
        os.execvp("syluxium-sudo", ["syluxium-sudo", "--why", "Installing Syluxium changes the disks of this "
                  "computer.", os.path.abspath(sys.argv[0])])
    except OSError:
        pass

sys.path.insert(0, "/usr/local/lib/syluxium/python")
