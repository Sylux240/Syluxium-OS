#!/bin/bash
# Display Settings: screen resolution, refresh rate, scaling (the size of
# text and windows) and, with several screens, their arrangement and the
# main display.
#   With a GPU driver (X's modesetting driver, xrandr lists modes): changed
#   at once, kept only if confirmed within 15 seconds (like Windows), and
#   restored at every login (syluxium-display --restore, from autostart).
#   With the firmware framebuffer only: the choice goes into the boot
#   loader's configuration (Limine "resolution:") and applies after a restart.
#   syluxium-display            graphical
#   syluxium-display --set WxH  boot resolution directly (root, no restart)
#   syluxium-display --restore  re-apply the saved live layout (login)
#   syluxium-display --scale N  scaling in percent (100, 125, ... 300), live
#   Scaling: whole factors are Xfce's Window Scaling (Gdk/WindowScalingFactor);
#   125/150/175 % make text larger (Xft/DPI) for X11 programs, and Wayland
#   programs (syluxium-wayland-host) are scaled by exactly that much.
export PATH=${SYLUXIUM_DISPLAY_TEST_PATH:+$SYLUXIUM_DISPLAY_TEST_PATH:}/opt/trinity/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TITLE="Display Settings"
SYS=/sys/class/graphics/fb0
CONF=/boot/efi/boot/limine/limine.conf
SAVED="$HOME/.config/syluxium/display"

# GTK dialogs (yad): an error, a yes/no question, a choice from a list
# ("menu": tag and text pairs; prints the tag) and a drop-down list (the
# current value first; prints the choice).
dlg() { yad --title "$TITLE" --window-icon preferences-desktop-display --center --borders 12 "$@" 2>/dev/null; }
dlg_error() { dlg --image dialog-error --text "$1" --button "OK:0"; }
dlg_yesno() { dlg --image dialog-question --text "$1" --button "No:1" --button "Yes:0"; }
dlg_menu() {
    local text=$1; shift
    dlg --list --width 460 --height 300 --text "$text" --no-headers --column "" --column "" --hide-column 1 \
        --print-column 1 --separator "" --button "Cancel:1" --button "OK:0" "$@"
}
dlg_combo() {
    local text=$1 current=$2 items=() i; shift 2
    for i in "$@"; do [ "$i" = "$current" ] || items+=("$i"); done
    dlg --entry --text "$text" --button "Cancel:1" --button "OK:0" "$current" "${items[@]}"
}

set_resolution() {
    local res=$1
    [ -f "$CONF" ] || { echo "no boot loader configuration at $CONF" >&2; return 1; }
    awk -v res="$res" '
        /^[ \t]*resolution:/ { next }
        { print }
        # (every entry: the Linux kernel, or Syluxium's own kernel)
        /^[ \t]*path:[ \t]*boot\(\):\/boot\/(vmlinuz|syluxium\.elf)/ { print "    resolution: " res }
    ' "$CONF" > "$CONF.new" && mv "$CONF.new" "$CONF" && sync
}

# xrandr: the connected outputs, an output's current "MODE RATE", every
# "MODE RATE" pair it offers, and the whole current layout as xrandr
# arguments (to go back to, or to save).
xr_connected() { xrandr --query 2>/dev/null | awk '$2 == "connected" { print $1 }'; }
xr_current() {
    xrandr --query 2>/dev/null | awk -v out="$1" '
        $1 == out { on = 1; next }
        on && /^[^ ]/ { exit }
        on { for (i = 2; i <= NF; i++) if ($i ~ /\*/) { r = $i; gsub(/[*+]/, "", r); print $1, r; exit } }'
}
xr_modes() {
    xrandr --query 2>/dev/null | awk -v out="$1" '
        $1 == out { on = 1; next }
        on && /^[^ ]/ { exit }
        on && $1 ~ /^[0-9]+x[0-9]+/ { for (i = 2; i <= NF; i++) { r = $i; gsub(/[*+]/, "", r); if (r ~ /^[0-9.]+$/) print $1, r } }'
}
xr_layout() {
    xrandr --query 2>/dev/null | awk '
        function emit() {
            if (out == "") return
            if (geo != "" && mode != "") {
                split(geo, a, "+")
                printf "--output %s --mode %s --rate %s --pos %sx%s%s ", out, mode, rate, a[2], a[3], prim ? " --primary" : ""
            } else {
                printf "--output %s --off ", out
            }
            out = ""
        }
        $2 == "connected" {
            emit(); out = $1; prim = ($3 == "primary"); geo = ""; mode = ""; rate = ""
            for (i = 3; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) geo = $i
            next
        }
        /^[^ ]/ { emit(); next }
        out != "" { for (i = 2; i <= NF; i++) if ($i ~ /\*/) { r = $i; gsub(/[*+]/, "", r); mode = $1; rate = r } }
        END { emit(); print "" }'
}

# Apply a layout; keep it only if the user can see and confirm it.
apply_and_confirm() {
    local new=$1 old=$2
    # shellcheck disable=SC2086 # the layouts are argument lists
    if ! xrandr $new; then
        dlg_error "The screens could not be set up that way."
        xrandr $old 2>/dev/null
        return 1
    fi
    local answer
    # (exit code 70 when the 15 seconds run out)
    dlg_yesno "Do you want to keep these display settings?

They go back to the previous ones in 15 seconds." --timeout 15 --timeout-indicator bottom
    answer=$?
    if [ "$answer" = 0 ]; then
        mkdir -p "$(dirname "$SAVED")"
        xr_layout > "$SAVED"
    else
        xrandr $old
    fi
    return 0
}

change_resolution() {
    local out=$1 cur_mode cur_rate items=() m r current choice mode rate
    read -r cur_mode cur_rate <<< "$(xr_current "$out")"
    while read -r m r; do
        items+=("$m @ $r Hz")
    done < <(xr_modes "$out")
    current="$cur_mode @ $cur_rate Hz"
    choice=$(dlg_combo "Screen resolution and refresh rate ($out):" "$current" "${items[@]}") || return 0
    [ "$choice" = "$current" ] && return 0
    mode=${choice%% @*}
    rate=${choice#*@ }
    rate=${rate% Hz}
    apply_and_confirm "--output $out --mode $mode --rate $rate" "$(xr_layout)"
}

if [ "$1" = "--set" ]; then
    [ "$(id -u)" = 0 ] || { echo "must be root" >&2; exit 1; }
    set_resolution "$2"
    exit $?
fi

# Scaling in percent, through Xfce's settings (xfsettingsd applies them at once).
current_scale() {
    local f d
    f=$(xfconf-query -c xsettings -p /Gdk/WindowScalingFactor 2>/dev/null || echo 1)
    d=$(xfconf-query -c xsettings -p /Xft/DPI 2>/dev/null || echo -1)
    if [ "${d:--1}" -gt 96 ] 2>/dev/null && [ "$f" -le 1 ]; then echo $(( (d * 100 + 48) / 96 ))
    else echo $(( ${f:-1} * 100 )); fi
}
set_scale() {
    local pct=$1 factor dpi
    case $pct in 100|200|300) factor=$((pct / 100)); dpi=-1 ;;
                 125|150|175) factor=1; dpi=$((96 * pct / 100)) ;;
                 *) echo "scaling: 100, 125, 150, 175, 200 or 300" >&2; return 1 ;; esac
    xfconf-query -c xsettings -p /Gdk/WindowScalingFactor -n -t int -s "$factor"
    if [ "$dpi" = -1 ]; then xfconf-query -c xsettings -p /Xft/DPI -r 2>/dev/null
    else xfconf-query -c xsettings -p /Xft/DPI -n -t int -s "$dpi"; fi
    # (whole factors scale the pointer by themselves; between them, a larger theme size)
    xfconf-query -c xsettings -p /Gtk/CursorThemeSize -n -t int -s $(( factor > 1 ? 24 : 24 * pct / 100 ))
}
change_scaling() {
    local cur choice
    cur=$(current_scale)
    choice=$(dlg_menu "Size of text, apps and other items (now ${cur} %):" \
             100 "100 %" 125 "125 %" 150 "150 %" 175 "175 %" 200 "200 % (HiDPI screens)" 300 "300 %") || return 0
    [ "$choice" = "$cur" ] && return 0
    set_scale "$choice" || return 1
    dlg --image dialog-information --text "Scaling is now $choice %. Programs started from now on use it fully;
open windows of some programs change only when they are restarted." --button "OK:0"
}

if [ "$1" = "--scale" ]; then
    set_scale "$2"
    exit $?
fi

if [ "$1" = "--restore" ]; then
    [ -f "$SAVED" ] || exit 0
    # An X layout: nothing to restore in the Wayland shell (xrandr would only
    # start Xwayland, whose screens can't be changed).
    [ "$XDG_SESSION_TYPE" = wayland ] && exit 0
    read -r first rest < "$SAVED"
    if [ "$first" = "--output" ]; then
        # shellcheck disable=SC2046
        xrandr $(cat "$SAVED") 2>/dev/null
    else # older format: "OUTPUT MODE RATE"
        read -r out mode rate <<< "$first $rest"
        [ -n "$out" ] && [ -n "$mode" ] && xrandr --output "$out" --mode "$mode" ${rate:+--rate "$rate"} 2>/dev/null
    fi
    exit 0
fi

mapfile -t outs < <(xr_connected)
if [ ${#outs[@]} -ge 2 ]; then
    # ---- several screens ----
    a=${outs[0]} b=${outs[1]}
    action=$(dlg_menu "Screens: ${outs[*]}" \
             layout "Arrangement (extend, duplicate, one screen only)..." \
             primary "Main display (taskbar, new windows)..." \
             resolution "Resolution and refresh rate..." \
             scaling "Scaling (size of text and windows)...") || exit 0
    old=$(xr_layout)
    case $action in
    layout)
        choice=$(dlg_menu "How should $a and $b be used?" \
                 right "Extend: $b to the right of $a" \
                 left "Extend: $b to the left of $a" \
                 above "Extend: $b above $a" \
                 below "Extend: $b below $a" \
                 mirror "Duplicate: the same picture on both" \
                 only-a "Only $a" \
                 only-b "Only $b") || exit 0
        case $choice in
        right) new="--output $a --auto --output $b --auto --right-of $a" ;;
        left) new="--output $a --auto --output $b --auto --left-of $a" ;;
        above) new="--output $a --auto --output $b --auto --above $a" ;;
        below) new="--output $a --auto --output $b --auto --below $a" ;;
        mirror) new="--output $a --auto --output $b --auto --same-as $a" ;;
        only-a) new="--output $a --auto --output $b --off" ;;
        only-b) new="--output $b --auto --output $a --off" ;;
        esac
        apply_and_confirm "$new" "$old"
        ;;
    primary)
        menu=()
        for o in "${outs[@]}"; do menu+=("$o" "$o"); done
        choice=$(dlg_menu "Main display:" "${menu[@]}") || exit 0
        apply_and_confirm "--output $choice --primary" "$old"
        ;;
    scaling)
        change_scaling
        ;;
    resolution)
        menu=()
        for o in "${outs[@]}"; do menu+=("$o" "$o ($(xr_current "$o" | awk '{ print $1 }'))"); done
        choice=$(dlg_menu "Which screen?" "${menu[@]}") || exit 0
        change_resolution "$choice"
        ;;
    esac
    exit 0
fi

out=${outs[0]}
action=$(dlg_menu "Display" resolution "Screen resolution..." scaling "Scaling (size of text and windows)...") || exit 0
if [ "$action" = scaling ]; then
    change_scaling
    exit 0
fi
if [ -n "$out" ] && [ "$(xr_modes "$out" | wc -l)" -gt 1 ]; then
    # ---- live change (GPU driver) ----
    change_resolution "$out"
    exit 0
fi

# ---- firmware framebuffer: the boot loader sets the mode ----
[ "$(id -u)" = 0 ] || exec syluxium-sudo --why "The screen resolution is set in the boot loader's settings." "$0" "$@"
current=$(sed 's/^U://; s/p.*//' "$SYS/mode" 2>/dev/null)
modes=()
while read -r line; do
    m=$(echo "$line" | sed 's/^U://; s/p.*//')
    [ -n "$m" ] && modes+=("$m")
done < "$SYS/modes"
# Linux's framebuffer lists only the mode it was given: offer the usual
# ones (the boot loader takes the closest the firmware has).
if [ ${#modes[@]} -le 1 ]; then
    for m in 800x600 1024x768 1280x720 1280x800 1280x1024 1366x768 1440x900 1600x900 1680x1050 \
             1920x1080 1920x1200 2560x1440 2560x1600 3840x2160; do
        [ "$m" = "$current" ] || modes+=("$m")
    done
fi
[ ${#modes[@]} -gt 0 ] || { dlg_error "The screen's resolutions could not be read."; exit 1; }
choice=$(dlg_combo "Screen resolution (now: $current):" "$current" "${modes[@]}") || exit 0
[ "$choice" = "$current" ] && exit 0
if ! set_resolution "$choice"; then
    dlg_error "The setting could not be saved."
    exit 1
fi
if dlg_yesno "The screen will use $choice after a restart.

Restart now?"; then
    reboot
fi
