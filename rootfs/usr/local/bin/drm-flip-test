#!/usr/bin/python3
"""Test aid: KMS the way wlroots uses it, without a compositor. Two dumb
buffers on /dev/dri/card0, atomic commits that flip between them with and
without damage rectangles (FB_DAMAGE_CLIPS), and the time each commit
takes. Run as root on the text console; screendumps show the result:
  phase 1 (2 s): red screen          (modeset with buffer A)
  phase 2 (2 s): blue screen         (flip to B, no damage clips)
  phase 3 (2 s): blue + green square (A gets a green square; flip to A
                 with only the square as damage)
  phase 4: 120 flips, a box moving right, full damage, then 120 flips
           with only the box's strip as damage; ends on a cyan box at
           the right edge over navy (both buffers fully redrawn each frame).
    drm-flip-test [phase-seconds]"""
import ctypes as C
import fcntl
import mmap
import os
import struct
import sys
import time

PHASE = float(sys.argv[1]) if len(sys.argv) > 1 else 2
drm = C.CDLL("libdrm.so.2", use_errno=True)


class ModeInfo(C.Structure):
    _fields_ = [("clock", C.c_uint32), ("hdisplay", C.c_uint16), ("hsync_start", C.c_uint16),
                ("hsync_end", C.c_uint16), ("htotal", C.c_uint16), ("hskew", C.c_uint16),
                ("vdisplay", C.c_uint16), ("vsync_start", C.c_uint16), ("vsync_end", C.c_uint16),
                ("vtotal", C.c_uint16), ("vscan", C.c_uint16), ("vrefresh", C.c_uint32),
                ("flags", C.c_uint32), ("type", C.c_uint32), ("name", C.c_char * 32)]


class Res(C.Structure):
    _fields_ = [("count_fbs", C.c_int), ("fbs", C.POINTER(C.c_uint32)), ("count_crtcs", C.c_int),
                ("crtcs", C.POINTER(C.c_uint32)), ("count_connectors", C.c_int),
                ("connectors", C.POINTER(C.c_uint32)), ("count_encoders", C.c_int),
                ("encoders", C.POINTER(C.c_uint32)), ("min_width", C.c_uint32), ("max_width", C.c_uint32),
                ("min_height", C.c_uint32), ("max_height", C.c_uint32)]


class Conn(C.Structure):
    _fields_ = [("connector_id", C.c_uint32), ("encoder_id", C.c_uint32), ("connector_type", C.c_uint32),
                ("connector_type_id", C.c_uint32), ("connection", C.c_int), ("mmWidth", C.c_uint32),
                ("mmHeight", C.c_uint32), ("subpixel", C.c_int), ("count_modes", C.c_int),
                ("modes", C.POINTER(ModeInfo)), ("count_props", C.c_int), ("props", C.POINTER(C.c_uint32)),
                ("prop_values", C.POINTER(C.c_uint64)), ("count_encoders", C.c_int),
                ("encoders", C.POINTER(C.c_uint32))]


class PlaneRes(C.Structure):
    _fields_ = [("count_planes", C.c_uint32), ("planes", C.POINTER(C.c_uint32))]


class ObjProps(C.Structure):
    _fields_ = [("count_props", C.c_uint32), ("props", C.POINTER(C.c_uint32)),
                ("prop_values", C.POINTER(C.c_uint64))]


class Prop(C.Structure):
    _fields_ = [("prop_id", C.c_uint32), ("flags", C.c_uint32), ("name", C.c_char * 32)]


drm.drmModeGetResources.restype = C.POINTER(Res)
drm.drmModeGetConnector.restype = C.POINTER(Conn)
drm.drmModeGetPlaneResources.restype = C.POINTER(PlaneRes)
drm.drmModeObjectGetProperties.restype = C.POINTER(ObjProps)
drm.drmModeGetProperty.restype = C.POINTER(Prop)
drm.drmModeAtomicAlloc.restype = C.c_void_p
drm.drmModeAtomicAddProperty.argtypes = [C.c_void_p, C.c_uint32, C.c_uint32, C.c_uint64]
drm.drmModeAtomicCommit.argtypes = [C.c_int, C.c_void_p, C.c_uint32, C.c_void_p]
drm.drmModeAtomicFree.argtypes = [C.c_void_p]

OBJ_CRTC, OBJ_CONNECTOR, OBJ_PLANE = 0xcccccccc, 0xc0c0c0c0, 0xeeeeeeee


def say(text):
    print(f"DRMTEST {text}", flush=True)


def check(r, what):
    if r:
        raise SystemExit(f"DRMTEST {what} failed: {r} {os.strerror(C.get_errno())}")


def props(fd, obj, kind):
    p = drm.drmModeObjectGetProperties(fd, obj, kind)
    out = {}
    for i in range(p.contents.count_props):
        pr = drm.drmModeGetProperty(fd, p.contents.props[i])
        out[pr.contents.name.decode()] = p.contents.props[i]
    return out


# Text console: graphics mode, so it doesn't draw over the test.
try:
    with open("/dev/tty0", "wb") as tty:
        fcntl.ioctl(tty, 0x4B3A, 1)
except OSError as e:
    say(f"KDSETMODE: {e}")
fd = os.open("/dev/dri/card0", os.O_RDWR)
check(drm.drmSetClientCap(fd, 2, 1), "universal planes")
check(drm.drmSetClientCap(fd, 3, 1), "atomic")
res = drm.drmModeGetResources(fd).contents
conn = None
for i in range(res.count_connectors):
    c = drm.drmModeGetConnector(fd, res.connectors[i]).contents
    if c.connection == 1 and c.count_modes:
        conn = c
        break
mode = conn.modes[0]
W, H = mode.hdisplay, mode.vdisplay
crtc = res.crtcs[0]
plane = drm.drmModeGetPlaneResources(fd).contents.planes[0]
pp, cp, np_ = props(fd, plane, OBJ_PLANE), props(fd, crtc, OBJ_CRTC), props(fd, conn.connector_id, OBJ_CONNECTOR)
say(f"mode {W}x{H}, crtc {crtc}, plane {plane}, damage clips: {'FB_DAMAGE_CLIPS' in pp}")

bufs = []
for _ in range(2):
    cd = struct.pack("IIIIIIQ", H, W, 32, 0, 0, 0, 0)
    cd = bytearray(fcntl.ioctl(fd, 0xC02064B2, cd))     # CREATE_DUMB
    _, _, _, _, handle, pitch, size = struct.unpack("IIIIIIQ", cd)
    md = bytearray(fcntl.ioctl(fd, 0xC01064B3, struct.pack("IIQ", handle, 0, 0)))  # MAP_DUMB
    offset = struct.unpack("IIQ", md)[2]
    m = mmap.mmap(fd, size, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=offset)
    fb = C.c_uint32()
    check(drm.drmModeAddFB(fd, W, H, 24, 32, pitch, handle, C.byref(fb)), "AddFB")
    bufs.append({"map": m, "pitch": pitch, "fb": fb.value})


def fill(b, x0, y0, x1, y1, rgb):
    px = struct.pack("<I", rgb) * (x1 - x0)
    for y in range(y0, y1):
        o = y * b["pitch"] + x0 * 4
        b["map"][o:o + len(px)] = px


def commit(b, damage=None, modeset=False):
    req = drm.drmModeAtomicAlloc()
    add = drm.drmModeAtomicAddProperty
    if modeset:
        blob = C.c_uint32()
        check(drm.drmModeCreatePropertyBlob(fd, C.byref(mode), C.sizeof(mode), C.byref(blob)), "mode blob")
        add(req, crtc, cp["MODE_ID"], blob.value)
        add(req, crtc, cp["ACTIVE"], 1)
        add(req, conn.connector_id, np_["CRTC_ID"], crtc)
        for k, v in (("CRTC_ID", crtc), ("SRC_X", 0), ("SRC_Y", 0), ("SRC_W", W << 16), ("SRC_H", H << 16),
                     ("CRTC_X", 0), ("CRTC_Y", 0), ("CRTC_W", W), ("CRTC_H", H)):
            add(req, plane, pp[k], v)
    add(req, plane, pp["FB_ID"], b["fb"])
    if damage is not None and "FB_DAMAGE_CLIPS" in pp:
        rects = (C.c_int32 * (4 * len(damage)))(*[v for r in damage for v in r])
        blob = C.c_uint32()
        check(drm.drmModeCreatePropertyBlob(fd, rects, C.sizeof(rects), C.byref(blob)), "damage blob")
        add(req, plane, pp["FB_DAMAGE_CLIPS"], blob.value)
    t = time.monotonic()
    r = drm.drmModeAtomicCommit(fd, req, 0x0400 if modeset else 0, None)  # ALLOW_MODESET
    dt = time.monotonic() - t
    drm.drmModeAtomicFree(req)
    check(r, "commit")
    return dt


A, B = bufs
NAVY, CYAN, RED, BLUE, GREEN = 0x141a3a, 0x6fe3f0, 0xff0000, 0x0000ff, 0x00ff00
fill(A, 0, 0, W, H, RED)
fill(B, 0, 0, W, H, BLUE)
say(f"phase 1 (red): modeset {commit(A, modeset=True) * 1000:.1f} ms")
time.sleep(PHASE)
say(f"phase 2 (blue): flip {commit(B) * 1000:.1f} ms")
time.sleep(PHASE)
fill(A, 100, 100, 300, 300, GREEN)
say(f"phase 3 (blue + green square): flip with damage {commit(A, [(100, 100, 300, 300)]) * 1000:.1f} ms")
time.sleep(PHASE)
for mode_name, partial in (("full damage", False), ("box damage", True)):
    times = []
    t0 = time.monotonic()
    for i in range(120):
        b = bufs[i % 2]
        x = int((W - 200) * i / 119)
        fill(b, 0, H // 2 - 100, W, H // 2 + 100, NAVY) if partial else fill(b, 0, 0, W, H, NAVY)
        fill(b, x, H // 2 - 100, x + 200, H // 2 + 100, CYAN)
        times.append(commit(b, [(0, H // 2 - 100, W, H // 2 + 100)] if partial else None))
    total = time.monotonic() - t0
    say(f"{mode_name}: 120 frames in {total:.2f} s ({120 / total:.1f} frames/s incl. drawing); "
        f"commit avg {sum(times) / len(times) * 1000:.2f} ms, max {max(times) * 1000:.2f} ms")
    time.sleep(PHASE)
# Phase 5: as wlroots does it: non-blocking commits with a page-flip event;
# the next frame only after the event. The event must come once the
# picture is on the screen (here: after the copy), not before.
import select  # noqa: E402
waits, returns = [], []
t0 = time.monotonic()
for i in range(60):
    b = bufs[i % 2]
    x = int((W - 200) * i / 59)
    fill(b, 0, H // 2 - 100, W, H // 2 + 100, NAVY)
    fill(b, x, H // 2 - 100, x + 200, H // 2 + 100, CYAN)
    req = drm.drmModeAtomicAlloc()
    drm.drmModeAtomicAddProperty(req, plane, pp["FB_ID"], b["fb"])
    t = time.monotonic()
    r = drm.drmModeAtomicCommit(fd, req, 0x01 | 0x0200, None)  # PAGE_FLIP_EVENT | NONBLOCK
    returns.append(time.monotonic() - t)
    drm.drmModeAtomicFree(req)
    if r:
        say(f"non-blocking commit {i}: {r} {os.strerror(C.get_errno())}")
        continue
    select.select([fd], [], [], 2)
    os.read(fd, 4096)
    waits.append(time.monotonic() - t)
total = time.monotonic() - t0
say(f"non-blocking + event: 60 frames in {total:.2f} s; commit returns after avg {sum(returns) / len(returns) * 1000:.2f} ms, "
    f"event after avg {sum(waits) / max(1, len(waits)) * 1000:.2f} ms (min {min(waits) * 1000:.2f})")
say("done")
time.sleep(PHASE * 2)
