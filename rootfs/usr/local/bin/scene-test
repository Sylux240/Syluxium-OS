#!/bin/sh
# Test aid: the same scene in the Xfce desktop and the Syluxium shell, so
# screenshots of both can be compared side by side. Run as the user inside
# the session (accessories-test phase "scene", or the shell's boot option
# shellscene=<name>).
#   apps  Files (Documents) and a terminal
#   menu  the same, then the start menu
#   pers  Personalize and a notification
#   halt  shut down through the session (xfce4-session-logout --halt)
#   reboot / logout  the same for restarting and logging out
#   tm    Files and a terminal, then Task Manager
#   files Thunar's file operations: files made, copied (Thunar's D-Bus
#         service), moved to the trash (Thunar, GVfs); results in ~/scene.log;
#         Thunar shows the trash
#   run:PROGRAM  start one program (e.g. run:syluxium-taskmgr)
#   android:PACKAGE  open an Android app as a window (Android set up first:
#         syluxium-android-container init); "ANDTEST" steps on the console
#   x11   X11 programs through Xwayland (xwayland-test, all phases);
#         x11:PHASE,PHASE  only those (e.g. x11:lazy,clip)
case "$1" in
apps|menu|tm)
    syluxium-open documents &
    sleep 4
    xfce4-terminal --title "Terminal" -x sh -c 'echo "Hello from the Dusk terminal"; ls /; exec sh' &
    sleep 4
    [ "$1" = menu ] && xfce4-popup-whiskermenu
    [ "$1" = tm ] && { syluxium-taskmgr & sleep 8; }
    ;;
pers)
    syluxium-personalize &
    sleep 5
    notify-send -i dialog-information "Syluxium" "A notification bubble, the same in both sessions."
    ;;
files)
    log=$HOME/scene.log; : > "$log"
    d=$HOME/Documents/scene; mkdir -p "$d"; rm -rf "$d"/*
    echo hello > "$d/one.txt"; echo world > "$d/two.txt"
    thunar --daemon & sleep 3
    dbus-send --session --print-reply --dest=org.xfce.FileManager /org/xfce/FileManager \
        org.xfce.FileManager.CopyTo string:"$d" array:string:"$d/one.txt" array:string:"$d/copy.txt" \
        string:"" string:"" >> "$log" 2>&1
    sleep 3
    echo "copy: $(cat "$d/copy.txt" 2>&1)" >> "$log"
    dbus-send --session --print-reply --dest=org.xfce.FileManager /org/xfce/FileManager \
        org.xfce.Trash.MoveToTrash array:string:"file://$d/two.txt" string:"" string:"" >> "$log" 2>&1
    sleep 3
    echo "trash: $(ls "$HOME/.local/share/Trash/files" 2>&1 | tr '\n' ' ') two.txt left: $([ -e "$d/two.txt" ] && echo yes || echo no)" >> "$log"
    thunar trash:/// & sleep 3
    thunar "$d" & sleep 5
    ;;
run:*) ${1#run:} & sleep 20 ;;
android:*)
    con=/run/syluxium-diag/console.txt
    pkg=${1#android:}
    echo "ANDTEST shell: opening $pkg (WAYLAND_DISPLAY=$WAYLAND_DISPLAY)" >> "$con"
    syluxium-android launch "$pkg" > /tmp/android-scene.log 2>&1 &
    for i in $(seq 1 150); do
        sleep 5
        grep -q "Android is ready" "$HOME/.cache/syluxium-android.log" 2>/dev/null && break
    done
    sleep 75
    echo "ANDTEST shell: log $(tail -4 "$HOME/.cache/syluxium-android.log" 2>/dev/null | tr '\n' '|')" >> "$con"
    echo "ANDTEST shell ready for screenshot" >> "$con"
    sleep 30
    ;;
x11) xwayland-test ;;
x11:*) xwayland-test $(echo "${1#x11:}" | tr ',' ' ') ;;
halt) xfce4-session-logout --halt ;;
reboot) xfce4-session-logout --reboot ;;
logout) xfce4-session-logout --logout ;;
esac
sleep 2
