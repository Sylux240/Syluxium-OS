#!/bin/sh
# Test aid: start the desktop, log in, then try the accessories, notifications
# and Network Connections as the logged-in user. Results go to the console
# ("ACCTEST ..."); screenshots to /root/shots/<phase>.png (taken inside the
# system: tools can copy them off the disk image afterwards).
say() { echo "ACCTEST $*" > /dev/console; }
mkdir -p /root/shots
LOG=/root/acctest.log; : > $LOG; chmod 666 $LOG
shot() {
    python3 - "$1" <<'EOF' 2>/dev/console
import sys, gi
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk
w = Gdk.get_default_root_window()
pb = Gdk.pixbuf_get_from_window(w, 0, 0, w.get_width(), w.get_height())
pb.savev(f"/root/shots/{sys.argv[1]}.png", "png", [], [])
EOF
    sync
    say "shot $1"
}
# A line every 15 s so test harnesses waiting for a quiet console keep waiting.
( while :; do sleep 15; say "..."; done ) &
beat=$!
startdesktop > /dev/null 2>&1 &
export DISPLAY=:0
for i in $(seq 1 120); do
    XAUTHORITY="$(ls /var/run/xauth/A:0-* 2>/dev/null | head -1)"
    [ -n "$XAUTHORITY" ] && [ -S /tmp/.X11-unix/X0 ] && break
    sleep 1
done
export XAUTHORITY
sleep 10
xdotool key Return    # log in (the login screen's user has no password)
for i in $(seq 1 120); do pidof kicker > /dev/null && break; sleep 1; done
sleep 15
say "desktop up"
# The session's environment (D-Bus session bus, X authority), to run things as the user.
# (kdeinit's programs write their titles over their environment: take any
# process of the user that still has the session bus address in it.)
env=
for want in SESSION_MANAGER DBUS_SESSION_BUS_ADDRESS; do for e in /proc/[0-9]*/environ; do
    [ -z "$env" ] || break
    [ "$(stat -c %u "$e" 2>/dev/null)" = 1000 ] || continue
    tr '\0' '\n' < "$e" 2>/dev/null | grep -q "^$want=" || continue
    tr '\0' '\n' < "$e" 2>/dev/null | grep -q '^DBUS_SESSION_BUS_ADDRESS=' || continue
    # the whole session environment (DCOP/ICE authority, session manager, ...)
    env=$(tr '\0' '\n' < "$e" | grep -E '^[A-Za-z_][A-Za-z0-9_]*=' | grep -v "'" | sed "s/^/export /; s/=/='/; s/\$/'/")
done; done
[ -n "$env" ] || { say "no session environment found"; env="export DISPLAY=:0"; }
# (the arguments stay as they are: no shell in between)
asuser() {
    ( eval "$env"; exec python3 -c 'import os, sys
os.initgroups("syluxium", 1000); os.setgid(1000); os.setuid(1000)
os.execvp(sys.argv[1], sys.argv[1:])' "$@" ) < /dev/null >> $LOG 2>&1
}
place() { for i in $(seq 1 30); do w=$(xdotool search --onlyvisible --name "$1" 2>/dev/null | head -1); [ -n "$w" ] && xdotool windowmove "$w" "$2" "$3" && return 0; sleep 0.5; done; say "no window '$1'"; return 1; }

phase=${ACCTEST_PHASES:-"notify apps snip gtk netconn mdns menu store craft"}
for p in $phase; do case $p in
notify)
    say "env: $(echo "$env" | tr '\n' ' ' | cut -c1-300)"
    pkill -f syluxium-notifyd; sleep 1
    asuser env SYLUXIUM_NOTIFYD_DEBUG=1 syluxium-notifyd &
    sleep 3
    asuser notify-send -a Firefox -i firefox "Download complete" "syluxium.iso (2.1 GB) was saved to Downloads." &
    sleep 2
    asuser notify-send -u critical -a "Battery" "Battery low" "'<b>8%</b> remaining.' Plug in the charger." &
    sleep 1
    asuser notify-send "Plain bubble" "Text with & and < characters" &
    sleep 3
    pgrep -f syluxium-notifyd > /dev/null && say "notifyd running" || say "notifyd NOT running"
    shot notify
    asuser dbus-send --session --print-reply --dest=org.freedesktop.Notifications /org/freedesktop/Notifications org.freedesktop.Notifications.GetServerInformation
    say "notify log: $(grep -v -i 'dcop\|ICE\|^-*$\|authentication' $LOG | tail -12 | tr '\n' '|')"
    sleep 8 ;;
apps)
    # The accessories behind the menu entries (GTK programs).
    asuser galculator & asuser drawing & asuser gucharmap & asuser abiword &
    place "galculator" 20 30; place "Drawing" 360 30; place "Character Map" 20 400; place "AbiWord" 600 300
    sleep 8
    for prog in galculator drawing gucharmap abiword; do pgrep -f "$prog" > /dev/null && say "$prog running" || say "$prog NOT running"; done
    shot apps
    pkill galculator; pkill -f /usr/bin/drawing; pkill gucharmap; pkill abiword; sleep 2 ;;
snip)
    asuser xfce4-screenshooter &
    sleep 10
    pidof xfce4-screenshooter > /dev/null && say "xfce4-screenshooter running" || say "xfce4-screenshooter NOT running"
    shot snip
    pkill xfce4-screenshooter; sleep 1 ;;
term)
    # Terminal: does its shell start, and is what it prints drawn?
    rm -f /tmp/term-ok
    asuser xfce4-terminal --disable-server --title "Term check" -x sh -c 'echo TERMOK > /tmp/term-ok; echo "Hello from the Dusk terminal"; ls /; exec sh' &
    place "Term check" 100 80
    sleep 6
    say "term: $(cat /tmp/term-ok 2>&1) children: $(ps -o pid,ppid,comm 2>/dev/null | grep -A3 xfce4-term | tr '\n' ' ')"
    w=$(xdotool search --onlyvisible --name "Term check" 2>/dev/null | head -1)
    [ -n "$w" ] && xdotool windowactivate "$w" 2>/dev/null; sleep 1
    xdotool type --delay 50 'echo typed ok; tty'; xdotool key Return; sleep 2
    shot term
    pkill xfce4-terminal; sleep 1 ;;
gtk)
    # Files, Terminal, Code Editor, Personalize; the desktop's defaults.
    say "defaults: dir=$(asuser xdg-mime query default inode/directory; tail -1 $LOG) text=$(asuser xdg-mime query default text/plain; tail -1 $LOG) x-terminal-emulator=$(readlink -f /usr/bin/x-terminal-emulator) x-www-browser=$(readlink -f /usr/bin/x-www-browser)"
    asuser syluxium-open documents &
    place "Documents" 20 30
    asuser xfce4-terminal --title "Dusk terminal" -x sh -c 'ls --color=auto /usr/share; echo; printf "\033[31mred \033[32mgreen \033[33myellow \033[34mblue \033[35mmagenta \033[36mcyan\033[0m\n"; exec sh' &
    place "Dusk terminal" 470 30
    asuser mousepad /etc/os-release &
    place "os-release" 20 420
    asuser syluxium-personalize &
    place "Personalize" 560 300
    sleep 8
    for prog in thunar xfce4-terminal mousepad syluxium-personalize; do pgrep -f "$prog" > /dev/null && say "$prog running" || say "$prog NOT running"; done
    shot gtk
    pkill thunar; pkill xfce4-terminal; pkill mousepad; pkill -f syluxium-personalize; sleep 2 ;;
netconn)
    ip -4 -o addr > /dev/console
    asuser syluxium-netconn &
    place "Network Connections" 100 60
    sleep 5
    shot netconn
    say "static: $(syluxium-netconfig static eth0 10.0.2.50/24 10.0.2.2 10.0.2.3 2>&1; echo rc=$?)"
    say "addr: $(ip -4 -o addr show dev eth0 | awk '{print $4}') route: $(ip route | grep default) dns: $(grep nameserver /etc/resolv.conf | tr '\n' ' ')"
    ping -c 1 -W 3 10.0.2.2 > /dev/null 2>&1 && say "ping gateway ok (static)" || say "ping gateway FAILED (static)"
    sleep 4
    shot netconn-static
    say "disable: $(syluxium-netconfig disable eth0 2>&1; echo rc=$?) flags: $(ip link show eth0 | head -1)"
    sleep 4
    say "enable: $(syluxium-netconfig enable eth0 2>&1; echo rc=$?) flags: $(ip link show eth0 | head -1)"
    say "dhcp: $(syluxium-netconfig dhcp eth0 2>&1; echo rc=$?)"
    say "addr: $(ip -4 -o addr show dev eth0 | awk '{print $4}') route: $(ip route | grep default) dns: $(grep nameserver /etc/resolv.conf | tr '\n' ' ') resolv: $(ls -l /etc/resolv.conf | awk '{print $NF}')"
    ping -c 1 -W 3 10.0.2.2 > /dev/null 2>&1 && say "ping gateway ok (dhcp)" || say "ping gateway FAILED (dhcp)"
    sleep 4
    pkill -f syluxium-netconn ;;
store)
    say "apt-get update: $(apt-get update 2>&1 | tail -1)"
    asuser syluxium-appstore --search craft &
    place "Syluxium App Store" 40 30
    sleep 25
    shot store
    pkill -f syluxium-appstore ;;
craft)
    say "release: $(python3 -c "
import importlib.machinery as m
s = m.SourceFileLoader('store', '/usr/local/bin/syluxium-appstore').load_module()
r = s.optional_release('anicraft')
print(r[0], r[1], r[2], s.download(r[1], '/tmp/anicraft.deb', r[2], r[3], lambda f: None))" 2>&1 | tail -1)"
    say "install: $(DEBIAN_FRONTEND=noninteractive apt-get install -y /tmp/anicraft.deb mesa-vulkan-drivers libvulkan1 2>&1 | tail -2 | tr '\n' ' ')"
    asuser anicraft &
    sleep 30
    pgrep -x anicraft > /dev/null && say "anicraft running" || say "anicraft NOT running: $(tail -5 $LOG | tr '\n' '|')"
    shot craft
    pkill -x anicraft ;;
mdns)
    # Multicast (mDNS), packet info, netlink credentials and events,
    # /sys/class/net, ethtool, then printer discovery end to end: a
    # simulated IPP Everywhere printer (ippeveprinter) announces itself,
    # avahi finds it, cups-browsed adds it to CUPS.
    for fam in 4 6; do
        say "multicast loop IPv$fam: $(python3 - $fam <<'EOF' 2>&1 | tail -1
import socket, struct, sys
v6 = sys.argv[1] == "6"
fam = socket.AF_INET6 if v6 else socket.AF_INET
grp = "ff02::fb" if v6 else "224.0.0.251"
idx = socket.if_nametoindex("eth0")
r = socket.socket(fam, socket.SOCK_DGRAM)
r.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
r.bind(("", 5354))
if v6:
    r.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_JOIN_GROUP, socket.inet_pton(fam, grp) + struct.pack("@I", idx))
    r.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_RECVPKTINFO, 1)
    r.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_RECVHOPLIMIT, 1)
else:
    r.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, socket.inet_aton(grp) + socket.inet_aton("0.0.0.0"))
    r.setsockopt(socket.IPPROTO_IP, socket.IP_PKTINFO, 1)
    r.setsockopt(socket.IPPROTO_IP, 12, 1)  # IP_RECVTTL
r.settimeout(3)
s = socket.socket(fam, socket.SOCK_DGRAM)
try:
    if v6:
        s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_MULTICAST_IF, idx)
        s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_MULTICAST_HOPS, 255)
        s.sendto(b"hello", (grp, 5354, 0, idx))
    else:
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 255)
        s.sendto(b"hello", (grp, 5354))
    data, anc, flags, addr = r.recvmsg(100, 256)
    info = []
    for lvl, typ, d in anc:
        if lvl == socket.IPPROTO_IP and typ == socket.IP_PKTINFO:
            info.append("pktinfo if=%d dst=%s" % (struct.unpack("@I", d[:4])[0], socket.inet_ntoa(d[8:12])))
        elif lvl == socket.IPPROTO_IPV6 and typ == socket.IPV6_PKTINFO:
            info.append("pktinfo6 if=%d dst=%s" % (struct.unpack("@I", d[16:20])[0], socket.inet_ntop(fam, d[:16])))
        else:
            info.append("cmsg %d/%d=%d" % (lvl, typ, struct.unpack("@i", d[:4])[0]))
    print("received", data, "from", addr[0], "; ".join(info))
except Exception as e:
    print("FAILED:", e)
EOF
)"
    done
    say "netlink creds+events: $(python3 - <<'EOF' 2>&1 | tail -1
import socket, struct, subprocess
s = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, 0)
s.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
s.bind((0, 0x1 | 0x10 | 0x100))  # RTMGRP_LINK | IPV4_IFADDR | IPV6_IFADDR
s.settimeout(3)
subprocess.run(["ip", "addr", "add", "10.0.2.77/24", "dev", "eth0"])  # replaces the address (one per interface)
try:
    data, anc, flags, addr = s.recvmsg(8192, 64)
    t = struct.unpack("@IHHII", data[:16])[1]
    cred = [struct.unpack("@iII", d[:12]) for l, ty, d in anc if l == socket.SOL_SOCKET and ty == 2]
    print("event type", t, "creds", cred)
except Exception as e:
    print("FAILED:", e)
finally:
    subprocess.run(["sh", "-c", "echo restart > /proc/sys/net/ipv4/conf/eth0/syluxium_dhcp"])
EOF
)"
    sleep 5
    say "after dhcp restart: $(ip -4 -o addr show dev eth0 | awk '{print $4}')"
    say "sysfs: $(cd /sys/class/net && ls | tr '\n' ' ') eth0: op=$(cat /sys/class/net/eth0/operstate) carrier=$(cat /sys/class/net/eth0/carrier) speed=$(cat /sys/class/net/eth0/speed) duplex=$(cat /sys/class/net/eth0/duplex) mac=$(cat /sys/class/net/eth0/address) mtu=$(cat /sys/class/net/eth0/mtu) flags=$(cat /sys/class/net/eth0/flags) rx=$(cat /sys/class/net/eth0/statistics/rx_bytes) dhcp=$(cat /proc/sys/net/ipv4/conf/eth0/syluxium_dhcp)"
    say "ethtool: $(python3 - <<'EOF' 2>&1 | tail -1
import array, fcntl, socket, struct
s = socket.socket()
cmd = bytearray(struct.pack("I", 1) + bytes(40))
buf = array.array("B", cmd)
ifr = struct.pack("16sP", b"eth0", buf.buffer_info()[0])
fcntl.ioctl(s, 0x8946, ifr)
speed = buf[12] | (buf[13] << 8) | (buf[28] << 16) | (buf[29] << 24)
drv = array.array("B", struct.pack("I", 3) + bytes(192))
fcntl.ioctl(s, 0x8946, struct.pack("16sP", b"eth0", drv.buffer_info()[0]))
name = bytes(drv[4:36]).split(b"\0")[0].decode()
flags = struct.unpack("H", fcntl.ioctl(s, 0x8913, struct.pack("16s16x", b"eth0"))[16:18])[0]
print("speed", speed, "duplex", buf[14], "driver", name, "IFF_RUNNING", bool(flags & 0x40))
EOF
)"
    say "avahi running: $(pidof avahi-daemon) cups-browsed: $(pidof cups-browsed)"
    pkill -x cups-browsed; sleep 1
    cups-browsed --debug > /tmp/cups-browsed-debug.log 2>&1 &
    ippeveprinter -k -p 8631 -M Syluxium -m "Test Printer" "Syluxium Test Printer" > /tmp/ippeve.log 2>&1 &
    sleep 8
    say "avahi-browse: $(timeout 10 avahi-browse -rtp _ipp._tcp 2>&1 | grep -c '^=') resolved, $(timeout 10 avahi-browse -rtp _ipp._tcp 2>&1 | grep '^=' | head -2 | cut -d';' -f2-9 | tr '\n' '|')"
    say "avahi-resolve: $(timeout 5 avahi-resolve -n syluxium.local 2>&1 | tr '\n' '|')"
    for i in $(seq 1 45); do lpstat -v 2>/dev/null | grep -q . && break; sleep 2; done
    say "lpstat -v: $(lpstat -v 2>&1 | tr '\n' '|') (after $((i * 2)) s)"
    say "lpstat -l -p: $(lpstat -l -p 2>&1 | head -4 | tr '\n' '|')"
    say "dnssd backend: $(timeout 20 /usr/lib/cups/backend/dnssd 2>&1 | head -3 | tr '\n' '|')"
    say "cups-browsed: $(grep -i 'ipp\|queue\|printer\|error' /tmp/cups-browsed-debug.log | tail -6 | tr '\n' '|' | cut -c1-600)"
    cp /tmp/ippeve.log /tmp/cups-browsed-debug.log /root/ 2>/dev/null
    pkill ippeveprinter ;;
menu)
    xdotool key alt+F1
    sleep 2
    xdotool key Down Down Down Down Right
    sleep 1
    xdotool key Right
    sleep 2
    shot menu
    xdotool key Escape Escape Escape ;;
esac; done
say "log: $(tr '\n' '|' < $LOG | tail -c 1500)"
kill $beat
say "done"
