<?xml version="1.0" encoding="UTF-8"?>
<!-- Syluxium Dusk taskbar: one translucent glass bar along the bottom with
     the Syluxium launcher (Whisker menu), pinned apps, open windows, the
     tray, volume and clock. Personalize changes its transparency. -->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="dark-mode" type="bool" value="true"/>
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=8;x=0;y=0"/>
      <property name="length" type="double" value="100"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="46"/>
      <property name="icon-size" type="uint" value="28"/>
      <property name="enter-opacity" type="uint" value="100"/>
      <property name="leave-opacity" type="uint" value="100"/>
      <property name="background-style" type="uint" value="1"/>
      <property name="background-rgba" type="array">
        <value type="double" value="0.0706"/>
        <value type="double" value="0.0902"/>
        <value type="double" value="0.2118"/>
        <value type="double" value="0.78"/>
      </property>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="9"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-icon" type="string" value="/usr/share/syluxium/dusk/logo-hex.png"/>
      <property name="button-title" type="string" value=""/>
      <property name="show-button-title" type="bool" value="false"/>
      <property name="show-button-icon" type="bool" value="true"/>
      <property name="menu-width" type="int" value="520"/>
      <property name="menu-height" type="int" value="560"/>
      <property name="menu-opacity" type="int" value="94"/>
      <property name="position-search-alternate" type="bool" value="true"/>
      <property name="position-commands-alternate" type="bool" value="true"/>
      <property name="position-categories-alternate" type="bool" value="false"/>
      <property name="view-mode" type="int" value="1"/>
      <property name="show-command-settings" type="bool" value="true"/>
      <property name="show-command-lockscreen" type="bool" value="false"/>
      <property name="show-command-switchuser" type="bool" value="false"/>
      <property name="show-command-logout" type="bool" value="true"/>
      <property name="show-command-menueditor" type="bool" value="false"/>
      <property name="show-command-profile" type="bool" value="false"/>
      <property name="recent-items-max" type="int" value="8"/>
      <property name="favorites" type="array">
        <value type="string" value="firefox-esr.desktop"/>
        <value type="string" value="thunar.desktop"/>
        <value type="string" value="syluxium-appstore.desktop"/>
        <value type="string" value="syluxium-personalize.desktop"/>
        <value type="string" value="syluxium-taskmgr.desktop"/>
        <value type="string" value="syluxium-controlpanel.desktop"/>
      </property>
    </property>
    <property name="plugin-2" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-3" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="thunar.desktop"/>
      </property>
    </property>
    <property name="plugin-4" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="firefox-esr.desktop"/>
      </property>
    </property>
    <property name="plugin-5" type="string" value="tasklist">
      <property name="grouping" type="uint" value="1"/>
      <property name="show-labels" type="bool" value="false"/>
      <property name="flat-buttons" type="bool" value="true"/>
      <property name="show-handle" type="bool" value="false"/>
      <property name="middle-click" type="uint" value="1"/>
    </property>
    <property name="plugin-6" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-7" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
      <property name="icon-size" type="int" value="20"/>
    </property>
    <property name="plugin-9" type="string" value="clock">
      <property name="mode" type="uint" value="2"/>
      <property name="digital-layout" type="uint" value="1"/>
      <property name="digital-time-format" type="string" value="%-I:%M %p"/>
      <property name="digital-date-format" type="string" value="%a, %b %-d"/>
      <property name="digital-time-font" type="string" value="Inter Medium 10"/>
      <property name="digital-date-font" type="string" value="Inter 8"/>
    </property>
  </property>
</channel>
