[Desktop Entry]
# Xfce session (TDE starts it from /opt/trinity/share/autostart).
Type=Application
Name=Wireless firmware check
Comment=Offers to install the firmware a Broadcom b43 wireless card needs
Exec=sh -c 'syluxium-b43-firmware --check && syluxium-b43-firmware'
OnlyShowIn=XFCE;
NoDisplay=true
