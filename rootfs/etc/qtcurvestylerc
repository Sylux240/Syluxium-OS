# Syluxium's widget style (Dusk theme): QtCurve with flat, fully rounded
# controls; the logo's cyan for sliders, check marks and progress bars;
# dark menus. Colours come from /etc/trinity/kdeglobals. System-wide
# default; users may override it in ~/.config/qtcurve/stylerc.
version=1.8.18
appearance=flat
round=full
buttonEffect=none
coloredMouseOver=thickcolored
defBtnIndicator=colored
thinnerBtns=false
darkerBorders=false
highlightFactor=5
embolden=false
focus=standard
# square: text fields, scroll views, list selection, tool tips, pop-up menus
square=1549

# scroll bars: one arrow at each end, 17 px
scrollbarType=windows
sliderWidth=17
sliderStyle=plain
sliderThumbs=lines
shadeSliders=#6fe3f0
sliderAppearance=flat
sbarBgndAppearance=flat
flatSbarButtons=false
thinSbarGroove=false
borderSbarGroove=true
fillSlider=true
colorSliderMouseOver=true

# check boxes and radio buttons: green mark
shadeCheckRadio=#6fe3f0
crHighlight=0
crButton=true
crSize=13
xCheck=false

# menus: beige menu bar, white pop-up menus, flat blue highlight
menubarAppearance=flat
shadeMenubars=none
menubarMouseOver=true
useHighlightForMenu=true
menuitemAppearance=flat
borderMenuitems=false
lighterPopupMenuBgnd=8
menuBgndAppearance=flat
shadePopupMenu=false
popupBorder=true
menuStripe=false
menuIcons=true
menuDelay=225
thinnerMenuItems=false
roundMbTopOnly=true

# tabs
tabAppearance=flat
activeTabAppearance=flat
highlightTab=true
colorSelTab=false
roundAllTabs=true
borderTab=true
tabMouseOver=top

# progress bars: cyan
progressAppearance=flat
progressColor=#6fe3f0
progressGrooveAppearance=flat
progressGrooveColor=base
stripedProgress=none
animatedProgress=false
fillProgress=true
borderProgress=true

# tool bars, lists, frames
toolbarAppearance=flat
toolbarBorders=none
toolbarSeparators=sunken
handles=dots
lvAppearance=gradient
lvLines=false
lvButton=false
selectionAppearance=flat
etchEntry=false
gtkScrollViews=true
highlightScrollViews=false
sunkenAppearance=flat
groupBox=frame
gbLabel=0
splitters=dots
drawStatusBarFrames=false
comboSplitter=true
unifySpinBtns=false
vArrows=true
gtkComboMenus=false
gtkButtonOrder=false
