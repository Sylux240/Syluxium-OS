# Syluxium defaults for the TDE panel (Kicker): an XP/7-style green
# "Start" button instead of TDE's plain K-menu icon.
# Panel contents: Start, Home and Web Browser buttons, task list, system
# tray, clock. No desktop pager (Syluxium uses a single desktop).
[General]
# Blue XP-era taskbar (tools/make-taskbar.py).
UseBackgroundTheme=true
BackgroundTheme=/opt/trinity/share/apps/kicker/wallpapers/syluxium_taskbar.png
ColorizeBackground=false
RotateBackground=false
# Flat panel buttons (the Start button's own green tiles, no frame around
# the tray); the task buttons get their XP-style frames from ktaskbarrc.
ShowDeepButtons=false
LegacyKMenu=true
Applets2=KMenuButton_1,ServiceButton_1,ServiceButton_2,Applet_2,ServiceButton_3,Applet_3,Applet_4

[KMenuButton_1]
FreeSpace2=0

[ServiceButton_1]
DesktopFile[$e]=/opt/trinity/share/applications/tde/Home.desktop
FreeSpace2=0
StorageId[$e]=tde-Home.desktop

[ServiceButton_2]
DesktopFile[$e]=/usr/share/applications/firefox-esr.desktop
FreeSpace2=0
StorageId[$e]=firefox-esr.desktop

[ServiceButton_3]
# The network button next to the clock (Wi-Fi chooser).
DesktopFile[$e]=/usr/share/applications/syluxium-wifi.desktop
FreeSpace2=1
StorageId[$e]=syluxium-wifi.desktop

[Applet_2]
ConfigFile=taskbar_panelappletrc
DesktopFile=taskbarapplet.desktop
FreeSpace2=0

[Applet_3]
ConfigFile=systemtray_panelappletrc
DesktopFile=systemtrayapplet.desktop
FreeSpace2=1

[Applet_4]
ConfigFile=clock_panelappletrc
DesktopFile=clockapplet.desktop
FreeSpace2=1

# The Start menu: a blue header with the user picture (tools/make-xp-theme.py),
# no side banner, no search line; contents in
# /opt/trinity/etc/xdg/menus/tde-applications.menu.
[KMenu]
ShowText=true
Text=Start
CustomIcon=/opt/trinity/share/apps/kicker/pics/syluxium_start.png
UseSidePixmap=false
UseTopSide=true
LeftSideTopName=syluxium_menu_top_left.png
RightSideTopName=syluxium_menu_top_right.png
SideTopTileName=syluxium_menu_top_tile.png
UseSearchBar=false
UseTooltip=false

# Menu entries show their name only ("My Computer", not "File Manager -
# Konqueror"), no section titles, no Settings/System submenus (Control Panel
# replaces them); the most used programs at the top.
[menus]
MenuEntryFormat=NameOnly
ShowMenuTitles=false
Extensions=
UseBookmarks=false
UseBrowser=false
NumVisibleEntries=4
RecentVsOften=false

[button_tiles]
EnableKMenuTiles=true
KMenuTile=syluxium_green

[buttons]
EnableTileBackground=true
Font=Tahoma,11,-1,5,75,1,0,0,0,0
TextColor=255,255,255
