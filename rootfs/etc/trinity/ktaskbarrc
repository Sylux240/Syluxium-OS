# Task buttons on the blue taskbar (TDE's global taskbar settings: the
# taskbar applet reads these, not taskbar_panelappletrc, while
# UseGlobalSettings is on). XP-style: raised blue buttons with white text,
# the active one pressed in and bold; buttons of one program are grouped
# when the taskbar is full.
[General]
ShowAllWindows=true
ShowOnlyIconified=false
DisplayIconsNText=DisplayIconsAndText
GroupTasks=GroupWhenFull
SortByDesktop=false
SortByApp=true
ShowWindowListBtn=false
MaximumButtonWidth=170
ShowCurrentScreenOnly=false

[Appearance]
DrawButtons=true
ShowButtonOnHover=false
HaloText=false
ShowThumbnails=false
UseCustomColors=true
ActiveTaskTextColor=255,255,255
InactiveTaskTextColor=255,255,255
TaskBackgroundColor=60,128,240
IconSize=16
