# Task buttons on the Dusk taskbar (TDE's global taskbar settings: the
# taskbar applet reads these, not taskbar_panelappletrc, while
# UseGlobalSettings is on): flat, light text, icon and title; buttons of one
# program are grouped when the taskbar is full.
[General]
ShowAllWindows=true
ShowOnlyIconified=false
DisplayIconsNText=DisplayIconsAndText
GroupTasks=GroupWhenFull
SortByDesktop=false
SortByApp=true
ShowWindowListBtn=false
MaximumButtonWidth=200
ShowCurrentScreenOnly=false

[Appearance]
DrawButtons=false
ShowButtonOnHover=true
HaloText=false
ShowThumbnails=false
UseCustomColors=true
ActiveTaskTextColor=255,255,255
InactiveTaskTextColor=223,228,255
TaskBackgroundColor=36,58,96
IconSize=16
