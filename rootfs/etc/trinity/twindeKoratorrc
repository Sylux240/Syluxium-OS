# Window frames: the deKorator decoration with Syluxium's Dusk theme
# (drawn by tools/make-dusk-theme.py): indigo title bar with a cyan line,
# round top corners, soft square buttons, pink close button.
[MISC]
TitleAlignment=AlignLeft
UseMenuImage=false
IgnoreAppIconCol=true
DblClkClose=true
ShowBtmBorder=false
UseShdtext=false
ActiveShdtextX=0
ActiveShdtextY=0
ActiveShadowColor=10,12,34
InActiveShdtextX=0
InActiveShdtextY=0
InActiveShadowColor=10,12,34
BtnShiftX=0
BtnShiftY=0

[COLORS]
Transparency=false
ColorizeActFrames=false
ColorizeActButtons=false
ColorizeInActFrames=false
ColorizeInActButtons=false
UseAnimation=false
ButtonsHoverType=None

[BUTTONS]
UseCustomButtonsColors=false

[PATHS]
FramesPath=/opt/trinity/share/apps/deKorator/themes/Syluxium-theme/deco
ButtonsPath=/opt/trinity/share/apps/deKorator/themes/Syluxium-theme/buttons
UseMasks=true
MasksPath=/opt/trinity/share/apps/deKorator/themes/Syluxium-theme/masks
