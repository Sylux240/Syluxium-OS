# Syluxium: system-wide TDE defaults.
# "Run as administrator" asks for your own password (sudo; members of the
# "sudo" group are administrators). root has no password.
[super-user-command]
super-user-command=sudo

# Firefox is the web browser; Konqueror stays the file manager.
[General]
BrowserApplication=firefox-esr
# XP-era colours (beige windows and buttons, blue selection).
background=236,233,216
foreground=0,0,0
windowBackground=255,255,255
windowForeground=0,0,0
buttonBackground=236,233,216
buttonForeground=0,0,0
selectBackground=49,106,197
selectForeground=255,255,255
linkColor=0,0,255
visitedLinkColor=128,0,128
alternateBackground=244,242,232
widgetStyle=QtCurve
# The XP-era user-interface font: Tahoma (Wine's free replacement), 8 pt.
font=Tahoma,8,-1,5,50,0,0,0,0,0
menuFont=Tahoma,8,-1,5,50,0,0,0,0,0
toolBarFont=Tahoma,8,-1,5,50,0,0,0,0,0
taskbarFont=Tahoma,8,-1,5,50,0,0,0,0,0
desktopFont=Tahoma,8,-1,5,50,0,0,0,0,0
fixed=DejaVu Sans Mono,9,-1,5,50,0,0,0,0,0

[KDE]
widgetStyle=QtCurve
contrast=7
# Double-click opens files and folders, like Windows.
SingleClick=false
ChangeCursor=false
# No icons on OK/Cancel/... buttons, like Windows.
ShowIconsOnPushButtons=false
EffectAnimateMenu=false
EffectFadeMenu=false
EffectAnimateCombo=false
EffectFadeTooltip=true

[Toolbar style]
IconText=IconTextRight
Highlighting=true

# Window title bars (the deKorator frames draw the bar itself; these give
# the title text and the colours other programs use for title bars).
[WM]
activeBackground=0,84,227
activeBlend=61,149,255
activeForeground=255,255,255
activeTitleBtnBg=0,84,227
inactiveBackground=122,150,223
inactiveBlend=157,185,235
inactiveForeground=216,228,248
inactiveTitleBtnBg=122,150,223
activeFont=Tahoma,10,-1,5,75,0,0,0,0,0

# Windows-style keys: Win key or Ctrl+Esc = Start menu (the Win key alone
# sends Alt+F1 through xcape: autostart/syluxium-winkey.desktop), Win+R = Run,
# Win+D = show the desktop, Win+L = lock (Win+E = My Computer:
# apps/khotkeys/syluxium_winkeys.khotkeys; Ctrl+Alt+Del and Ctrl+Shift+Esc =
# Syluxium's Task Manager: apps/khotkeys/syluxium_taskmgr.khotkeys, so the
# desktop's own "Show Taskmanager" key, which opens KSysGuard, is off).
[Global Shortcuts]
Popup Launch Menu=Alt+F1;Ctrl+Escape
Run Command=Alt+F2;Win+R
Toggle Showing Desktop=Win+D
Show Taskmanager=none
Lock Session=Ctrl+Alt+L;Win+L
Log Out=none
Log Out Without Confirmation=none
Walk Through Windows=Alt+Tab
Walk Through Windows (Reverse)=Alt+Shift+Tab
Window Close=Alt+F4

# XP-era wording in the Start menu, Run box and Turn Off dialog: a small
# English variant (tools/make-xp-translations.py); dates etc. stay US.
[Locale]
Language=en_XP:en_US
Country=us
TimeFormat=%l:%M:%S %p

# No "Switch User" (one session at a time on Syluxium).
[KDE Action Restrictions]
switch_user=false
action/help_about_kde=false
action/help_report_bug=false
