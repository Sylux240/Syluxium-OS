# Syluxium: system-wide TDE defaults.
# "Run as administrator" asks for your own password (sudo; members of the
# "sudo" group are administrators). root has no password.
[super-user-command]
super-user-command=sudo

# Firefox is the web browser; Konqueror stays the file manager.
[General]
BrowserApplication=firefox-esr
# Dusk colours: navy windows, indigo buttons, cyan selection, light text.
background=27,33,72
foreground=238,242,255
windowBackground=20,26,58
windowForeground=238,242,255
buttonBackground=37,45,92
buttonForeground=238,242,255
selectBackground=111,227,240
selectForeground=20,26,58
linkColor=111,227,240
visitedLinkColor=185,163,227
alternateBackground=24,31,66
widgetStyle=QtCurve
# The user-interface font: Inter (package fonts-inter), 9 pt.
font=Inter,9,-1,5,50,0,0,0,0,0
menuFont=Inter,9,-1,5,50,0,0,0,0,0
toolBarFont=Inter,9,-1,5,50,0,0,0,0,0
taskbarFont=Inter,9,-1,5,50,0,0,0,0,0
desktopFont=Inter,9,-1,5,50,0,0,0,0,0
fixed=DejaVu Sans Mono,9,-1,5,50,0,0,0,0,0

# Dusk icons (tools/make-dusk-icons.py) over TDE's crystalsvg.
[Icons]
Theme=Syluxium

# Desktop icons as large tiles, as in the Dusk mockup.
[DesktopIcons]
Size=48

[KDE]
widgetStyle=QtCurve
contrast=7
# Double-click opens files and folders, like Windows.
SingleClick=false
ChangeCursor=false
# No icons on OK/Cancel/... buttons, like Windows.
ShowIconsOnPushButtons=false
EffectAnimateMenu=false
EffectFadeMenu=false
EffectAnimateCombo=false
EffectFadeTooltip=true

[Toolbar style]
IconText=IconTextRight
Highlighting=true

# Window title bars (the deKorator frames draw the bar itself; these give
# the title text and the colours other programs use for title bars).
[WM]
activeBackground=29,37,82
activeBlend=29,37,82
activeForeground=238,242,255
activeTitleBtnBg=29,37,82
inactiveBackground=24,30,64
inactiveBlend=24,30,64
inactiveForeground=150,160,200
inactiveTitleBtnBg=24,30,64
activeFont=Inter,10,-1,5,63,0,0,0,0,0

# Windows-style keys: Win key or Ctrl+Esc = Start menu (the Win key alone
# sends Alt+F1 through xcape: autostart/syluxium-winkey.desktop), Win+R = Run,
# Win+D = show the desktop, Win+L = lock, Ctrl+Alt+Del and
# Ctrl+Shift+Esc = Task Manager (Win+E = System: apps/khotkeys/syluxium_winkeys.khotkeys).
[Global Shortcuts]
Popup Launch Menu=Alt+F1;Ctrl+Escape
Run Command=Alt+F2;Win+R
Toggle Showing Desktop=Win+D
Show Taskmanager=Ctrl+Alt+Delete;Ctrl+Shift+Escape
Lock Session=Ctrl+Alt+L;Win+L
Log Out=none
Log Out Without Confirmation=none
Walk Through Windows=Alt+Tab
Walk Through Windows (Reverse)=Alt+Shift+Tab
Window Close=Alt+F4

# Plain wording in the launcher menu, Run box and Turn Off dialog: a small
# English variant (tools/make-wording.py); dates etc. stay US.
[Locale]
Language=en_SX:en_US
Country=us
TimeFormat=%l:%M:%S %p

# No "Switch User" (one session at a time on Syluxium).
[KDE Action Restrictions]
switch_user=false
action/help_about_kde=false
action/help_report_bug=false
