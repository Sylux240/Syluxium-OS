# One desktop (no virtual-desktop switching), like Windows.
[Desktops]
Number=1

# New windows (installer steps, dialogs) get the keyboard, as on Windows.
[Windows]
FocusStealingPreventionLevel=0
# Alt+Tab: a box with the window icons, like Windows.
AltTabStyle=KDE
# Double-click on a title bar maximizes (TDE's default would roll it up).
TitlebarDoubleClickCommand=Maximize

# Window frames: Syluxium's XP-era deKorator theme (glossy blue title bar,
# round top corners, red close button; tools/make-xp-theme.py), the
# application icon on the left, minimize/maximize/close on the right.
[Style]
PluginLib=twin3_deKorator
ButtonsOnLeft=M
ButtonsOnRight=IAX
CustomButtonPositions=true
ShowToolTips=true
